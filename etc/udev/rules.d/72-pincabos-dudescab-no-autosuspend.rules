# PINCABOS_DUDESCAB_NO_AUTOSUSPEND_V1
#
# DudesCab 2e8a:106f uniquement.
# Empêche le runtime autosuspend susceptible de perdre des événements HID.
#
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="106f", TEST=="power/control", ATTR{power/control}="on"
ACTION=="add|bind", SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="106f", TEST=="power/autosuspend_delay_ms", ATTR{power/autosuspend_delay_ms}="-1"

[Unit]
Description=PinCabOS GUI installer kiosk (X11 + openbox + WebKitGTK)
After=pincabos-gui-wizard.service
Requires=pincabos-gui-wizard.service
# PINCABOS_INSTALLEUR_UN_SEUL_CHEMIN_V1 : plus d'installeur texte de secours.
# Le kiosque est relance quelques fois par systemd ; s'il ne tient pas, la
# panne est annoncee en clair sur tty1 (pincabos-installer-failure).
StartLimitIntervalSec=300
StartLimitBurst=3
OnFailure=pincabos-installer-failure.service

[Service]
Type=simple
RuntimeDirectory=pincabos-kiosk
Environment=XDG_RUNTIME_DIR=%t/pincabos-kiosk
# plymouth doit rendre le DRM master avant que X puisse le prendre
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/bin/xinit /usr/local/bin/pincabos-kiosk-session -- :1 vt1 -nolisten tcp
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Unit]
Description=PinCabOS B2S window layer guard
After=display-manager.service graphical.target
Wants=display-manager.service

[Service]
Type=simple
User=pinball
Group=pinball

Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pinball/.Xauthority

ExecStart=/opt/pincabos/bin/pincabos-b2s-layer-guard.sh

Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=graphical.target

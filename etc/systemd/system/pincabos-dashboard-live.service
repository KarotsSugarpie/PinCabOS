[Unit]
Description=PinCabOS Dashboard camera-like live screen previews

After=display-manager.service pincabos-screen-topology-boot.service
Wants=display-manager.service pincabos-screen-topology-boot.service
[Service]
Type=simple
User=pinball
Group=pinball
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pinball/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/bin/nice -n 19 /usr/local/lib/pincabos/pincabos-dashboard-live-capture
Restart=always
RestartSec=2
Nice=19
CPUWeight=1
CPUQuota=15%
IOSchedulingClass=idle
RuntimeDirectory=pincabos-dashboard-live
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=graphical.target

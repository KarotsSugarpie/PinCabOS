[Unit]
Description=PinCabOS VPinFE Frontend
Documentation=https://pincabos.cc/
# PINCABOS_DEMARRAGE_V1 : le frontend sert en local ; il ne doit pas attendre
# network-online (jusqu'a 30 s de wait-online sur un cab en Wi-Fi ou sans DHCP).
After=display-manager.service network.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/pinball
ExecStart=/usr/bin/bash /opt/pincabos/tools/run-vpinfe-systemd.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
KillMode=control-group

[Install]
WantedBy=graphical.target

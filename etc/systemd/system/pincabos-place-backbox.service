[Unit]
Description=PinCabOS - placement des surfaces de fronton (backglass + FullDMD)
Documentation=https://pincabos.cc/
After=display-manager.service
Wants=display-manager.service

[Service]
Type=simple
User=pinball
Group=pinball
Environment=DISPLAY=:0
ExecStart=/opt/pincabos/bin/pincabos-place-backbox
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=graphical.target

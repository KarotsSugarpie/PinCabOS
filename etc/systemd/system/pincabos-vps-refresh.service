[Unit]
Description=PinCabOS - rafraichit la base Virtual Pinball Spreadsheet (identification des tables)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/pincabos/tools/pincabos-vps

[Service]
Type=oneshot
User=pinball
Group=pinball
Nice=15
IOSchedulingClass=idle
ExecStart=/opt/pincabos/tools/pincabos-vps refresh
TimeoutStartSec=180

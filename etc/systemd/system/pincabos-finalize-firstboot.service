[Unit]
Description=PinCabOS first boot finalizer and system doctor
ConditionPathExists=!/var/lib/pincabos/doctor-firstboot.done
ConditionPathExists=!/etc/pincabos-live
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# PINCABOS_DOCTOR_MENAGEMENT_V1 : jamais de redemarrage de service au premier demarrage
ExecStart=/usr/local/sbin/pincabos --repair --firstboot --no-restart
ExecStartPost=/usr/bin/touch /var/lib/pincabos/doctor-firstboot.done
SuccessExitStatus=0 2
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target

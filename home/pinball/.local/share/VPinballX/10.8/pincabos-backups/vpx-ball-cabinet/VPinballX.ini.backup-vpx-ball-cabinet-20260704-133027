PlayfieldFSWidth = 3840

; Height: Fullscreen display mode height [Default: 16384 in 0 .. 16384]
PlayfieldFSHeight = 2160

; Refresh Rate: Fullscreen display mode refresh rate [Default: 0.0 in 0.0 .. 1000.0]
PlayfieldRefreshRate = 60.0

; Color Depth: Fullscreen display mode color depth [Default: 32 in 0 .. 64]
PlayfieldColorDepth = 32

; Synchronization:  [Default: 'Frame Pacing', 0='No Sync', 1='Vertical Sync', 2='Adaptive Sync', 3='Frame Pacing']:
;   None: No synchronization.
;   Vertical Sync: Synchronize on video sync, avoids video tearing at the price of high visual latency.
;   Adaptive Sync: Synchronize on video sync, except for late frames (below target FPS), also features higher visual latency.
;   Frame Pacing: pace the frame rendering to limit visual latency, comes with the risk of introducing more stutters if the computer is not powerful enough.
SyncMode = 3

; Limit Framerate:  [Default: -1.0 in -1.0 .. 1000.0]:
;   -1 will limit FPS to the display refresh rate
;   0 will not limit the display refresh rate
;   Other values will limit the FPS to it (energy saving/less heat, framerate stability)
MaxFramerate = 10000.0

; Max. Prerendered Frames:  [Default: 1 in 1 .. 3]:
;   Maximum number of 'frames in flight' (frames pushed to the GPU queue waiting for rendering).
;   Higher values may lead to higher FPS, but at higher input latency.
;   Recommended to be adjusted to the lowest value that allows a stable framerate.
;   (Not supported in OpenGL version)
MaxPrerenderedFrames = 1

; Graphics Backend: Graphics API/backend used for rendering [Default: 'Default']
GfxBackend = Direct3D11

; Show FPS: Performance overlay display mode [Default: 'Disable', 0='Disable', 1='FPS', 2='Full']
ShowFPS = 0

; Additive Screen Space Reflection: Add global reflection to the entire scene [Default: 0]
SSRefl = 0

; Disable tonemapping on HDR display: Do not perform tonemapping when rendering on a high dynamic range (HDR) capable monitor/gfxboard/OS [Default: 1]
HDRDisableToneMapper = 1

; HDR Display Global Exposure: Global exposure scale multiplier for high dynamic range (HDR) capable monitors [Default: 1.0 in 0.0 .. 5.0]
HDRGlobalExposure = 1.0

; Disable Bloom: Disable postprocessed bloom filter [Default: 0]
ForceBloomOff = 0

; Disable Motion Blur:  [Default: 0]:
;   Disable ball motion blur.
;   This feature is BGFX only (and not supported in VR or headtracking)
ForceMotionBlurOff = 1

; Force Anisotropic Filtering: Force anisotropic filtering for better rendering quality/texture clarity at the cost of a bit of performance [Default: 1]
ForceAnisotropicFiltering = 1

; Compress Textures: Automatically compress textures at game startup (slow) for better performance [Default: 0]
CompressTextures = 0

; Alternative Depth Buffer: Use NVidia API to manage Depth Buffer on a DirectX 9 build. May solve some rendering issues [Default: 0]
UseNVidiaAPI = 0

; Software Vertex Processing: Activate this on a DirectX 9 build, if you have issues using an old Intel graphics chip [Default: 0]
SoftwareVertexProcessing = 

; Disable Ambient Occlusion:  [Default: 0]
DisableAO = 0

; Dynamic Ambient Occlusion:  [Default: 1]
DynamicAO = 1

; Reflection Quality:  [Default: 'Dynamic', 0='Disable Reflections', 1='Balls Only', 2='Static Only', 3='Static & Balls', 4='Static & Unsynced Dynamic', 5='Dynamic']:
;   Limit the quality of reflections for better performance.
;   'Dynamic' is recommended and will give the best results, but may harm performance.
;   'Static Only' has no performance cost (except for VR rendering).
;   Other options feature different trade-offs between quality and performance.
PFReflection = 3

; Maximum texture dimension: Images sized above this limit will be automatically scaled down on load [Default: 16384 in 512 .. 16384]
MaxTexDimension = 16384

; Detail Level: Level of detail for balls and ramps [Default: 10 in 1 .. 10]
AlphaRampAccuracy = 10

; View Mode: Select between desktop, cabinet or 'full single screen' viewing mode configurations (if a table has set them up correctly) [Default: 'Desktop / Full Single Screen', 0='Desktop / Full Single Screen', 1='Cabinet', 2='Full Single Screen']
BGSet = 1

; Cabinet Autofit Mode: Select between manual setup, automatic fitting without visual stretch or automatic fitting with table stretching [Default: 'Manual', 0='Manual', 1='Fit Table', 2='Fit Screen']
CabinetAutofitMode = 2

; Cabinet Autofit Pos: Relative lower flipper bat position when using automatic view fitting (0% for bottom of screen, 100% for top) [Default: 0.05 in 0.0 .. 0.2]
CabinetAutofitPos = 

; Full Scene Anti Aliasing:  [Default: 1.0 in 0.5 .. 2.0]:
;   Enables brute-force Up/Downsampling (similar to DSR).
;   This delivers very good quality but has a significant impact on performance.
;   200% means twice the resolution to be handled while rendering
AAFactor = 1.0

; MSAA level:  [Default: 'Disabled', 0='Disabled', 1='4 Samples', 2='6 Samples', 3='8 Samples']:
;   Set the amount of MSAA samples.
;   MSAA can help reduce geometry aliasing at the cost of performance and GPU memory.
;   This can improve image quality if not using supersampling
MSAASamples = 0

; Post processed antialiasing: Select between different antialiasing techniques that offer different quality vs performance balances [Default: 'Disabled', 0='Disabled', 1='Fast FXAA', 2='Standard FXAA', 3='Quality FXAA', 4='Fast NFAA', 5='Standard DLAA', 6='Quality SMAA', 7='Quality FAAA']
FXAA = 1

; Post processed sharpening: Select between different sharpening techniques that offer different quality vs performance balances [Default: 'Disabled', 0='Disabled', 1='CAS', 2='Bilateral CAS']
Sharpen = 1

; Unstretch Ball: Compensate ball stretching [Default: 0]

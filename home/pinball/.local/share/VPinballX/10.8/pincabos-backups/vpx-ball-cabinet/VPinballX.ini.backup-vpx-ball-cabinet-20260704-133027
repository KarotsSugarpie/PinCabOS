; Display: Display used for the main Playfield window [Default: '']
PlayfieldDisplay = N43 32"

; Display Mode: Select between windowed or borderless fullscreen mode [Default: 'Windowed', 0='Windowed', 1='Borderless Fullscreen']
PlayfieldFullScreen = 1

; X Position: Horizontal position of the window on the selected display [Default: 0 in 0 .. 16384]
PlayfieldWndX = 0

; Y Position: Vertical position of the window on the selected display [Default: 0 in 0 .. 16384]
PlayfieldWndY = 0

; Width: Width of the window [Default: 16384 in 0 .. 16384]
PlayfieldWidth = 3840

; Height: Height of the window [Default: 16384 in 0 .. 16384]
PlayfieldHeight = 2160


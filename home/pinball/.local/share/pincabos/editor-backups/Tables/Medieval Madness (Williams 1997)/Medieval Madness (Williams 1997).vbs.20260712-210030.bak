'************************************************************************

Dim IronGateDir, IronGatePos
IronGatePos = 10

InitIronGate
Sub InitIronGate
	Dim BP: For Each BP in BP_gate: BP.z = IronGatePos: Next
End Sub

Sub SolCastlegatePow(Enabled)
	If Enabled Then
		CastleGateTimer.Enabled = 1
		IronGateDir = 1
		PlaySoundat SoundFX("fx_gateUp",DOFContactors), BM_gate
		TwrShake
	End If
End Sub

Sub SolCastlegateHold(Enabled)
	If Enabled Then        
		DOF 102, DOFPulse
	End If
	If NOT Enabled AND IronGateDir = 1 Then
		IronGateDir = -1
		CastleGateTimer.Enabled = 1
		PlaySoundat SoundFX("fx_gateDown",DOFContactors), BM_gate
		DOF 102, DOFPulse
    End If
End Sub

Sub CastleGateTimer_Timer
	Dim BP
	DOF 101, DOFOn
	IronGatePos = IronGatePos + IronGateDir
	If IronGatePos <= 10 Then
		IronGatePos = 10
		DoorPortculis.IsDropped = 0
		DOF 101, DOFOff
		Me.Enabled = 0
	End If
	If IronGatePos >= 115 Then
		IronGatePos = 115
		DoorPortculis.IsDropped = 1
		DOF 101, DOFOff
		Me.Enabled = 0
	End If
	For Each BP in BP_gate: BP.z = IronGatePos: Next
End Sub

'************************************************************************
'	ZCAT: Catapult 
'************************************************************************

Dim catdir, CatBall, CatPos: CatBall = Empty
CatPos = 0

Sub sw38_hit
	SoundSaucerLock
	Controller.switch(38)=1
	Set CatBall = Activeball
End Sub

Sub SolCatapult(enabled)
	If enabled Then
		catdir = 1
		sw38.TimerInterval = 1
		sw38.TimerEnabled = 1
		SoundSaucerKick 1, sw38
	End If
End Sub


Sub sw38_timer()
	Dim BP
	CatPos = CatPos + catdir
	For Each BP in BP_Prim_Catapult: BP.rotx = CatPos: Next

	Dim catradius: catradius = 110

	If Not IsEmpty(CatBall) Then
		CatBall.x = BM_Prim_Catapult.x + catradius*cos(radians(90))*cos(Radians(BM_Prim_Catapult.Rotx-7))
		CatBall.y = BM_Prim_Catapult.y + catradius*sin(radians(90))*cos(Radians(BM_Prim_Catapult.Rotx-7))
		CatBall.z = 25 + catradius*sin(radians(BM_Prim_Catapult.Rotx-7))
	End If

	If CatPos >= 97 AND catdir=1 Then 
		catdir = -1
		sw38.kick 0, 45
		CatBall = Empty
		controller.Switch(38) = 0
	End If
	If CatPos <= 0 Then 
		Me.TimerEnabled = 0
	End If
	
End Sub

'************************************************************************
' ZDIV: TOWER DIVERTER
'************************************************************************

Dim DiverterDir, DiverterZ
DiverterZ = 0

Sub SolTowerDivPow(Enabled)
	'debug.print "SolTowerDivPow "&(Enabled)
	If Enabled Then
		Diverter.IsDropped=1
		Diverter.TimerEnabled = 1
		DiverterDir = -1
		PlaySoundAt SoundFX("fx_DiverterUp",DOFContactors), Bumper3
	End If
End Sub

Sub SolTowerDivHold(Enabled)
	'debug.print "SolTowerDivHold "&(Enabled)
	If NOT Enabled AND DiverterDir = -1 Then
		Diverter.IsDropped=0
		DiverterDir = 1
		Diverter.TimerEnabled = 1
		PlaySoundat SoundFX("fx_DiverterDown",DOFContactors), Bumper3
    End If
End Sub


Sub Diverter_Timer
	Dim BP
	DiverterZ = DiverterZ + 5*DiverterDir
    If DiverterZ >= 0 Then Me.TimerEnabled = 0
    If DiverterZ <= -60 Then Me.TimerEnabled = 0
	For Each BP in BP_DiverterP: BP.TransZ = DiverterZ: Next
End Sub


'************************************************************************
'	ZDRB: DRAW BRIDGE 
'************************************************************************

' Switch 56 - Drawbridge Up
' Switch 57 - Drawbridge Down

Dim dbPos, dbClosed, dbAngle

InitDrawbridge
Sub InitDrawbridge
	Dim BP
	dbClosed = True
	dbAngle = 0

	For each BP in BP_bridgeDown: BP.transz = 1: Next
	For each BP in BP_bridgeDown: BP.rotx = dbAngle + 90: Next
	For each BP in BP_bridgeDown: BP.Size_x = 0.99: BP.Size_y = 0.99: Next

	For each BP in BP_bridgeUp: BP.transz = -1: Next
	For each BP in BP_bridgeUp: BP.rotx = dbAngle + 90: Next
	BM_bridgeUp.transz = 0
End Sub

Sub SolDrawBridge(enabled)
	'debug.print "SolDrawBridge "&Enabled
	'debug.print "dbClosed = "&dbClosed
	If Enabled AND dbClosed then 
		'debug.print "Bridge is GOING DOWN"
		dbPos = 1
		dbridge.enabled = 1
		Controller.Switch(56) = 0 
		PlaySound SoundFX("Bridge_Move", DOFGear), -1, 0.1, AudioPan(BM_bridgeUp) , 0, 0, 1, AudioPan(BM_bridgeUp)
		DOF 104, DOFOn
	end If
	If Enabled AND NOT dbClosed then 
		'debug.print "Bridge is GOING UP"
		dbPos = 2
		dbridge.enabled = 1
		Controller.Switch(57) = 0 
		PlaySound SoundFX("Bridge_Move", DOFGear), -1, 0.1, AudioPan(BM_bridgeUp) , 0, 0, 1, AudioPan(BM_bridgeUp)
		DOF 104, DOFOn
	End If
End Sub

Sub dbridge_timer()
	Dim BP, v
	Select Case dbPos
		Case 1:			'bridge is going down
			dbAngle = dbAngle - 1
			If dbAngle <= -90 Then
				'debug.print "Bridge is DOWN"
				DOF 104, DOFOff
				dbAngle = -90
				DoorDrawbridge.isdropped = 1
				BridgeRamp.collidable = 1
				Ramp22.collidable = 0
				dbClosed = False
				Controller.Switch(57) = 1 
				StopSound "Bridge_Move"
				PlaySound SoundFX("Bridge_Stop", 0),0, 0.1, AudioPan(BM_bridgeUp) , 0, 0, 1, AudioPan(BM_bridgeUp)
				dbridge.Enabled = 0
			End If
		Case 2:			'bridge is going up
			dbAngle = dbAngle + 1
			If dbAngle >= 0 Then
				'debug.print "Bridge is UP"
				DOF 104, DOFOff
				dbAngle = 0
				DoorDrawbridge.isdropped = 0
				BridgeRamp.collidable = 0
				Ramp22.collidable = 1
				dbClosed = True
				Controller.Switch(56) = 1 
				StopSound "Bridge_Move"
				PlaySound SoundFX("Bridge_Stop", 0),0, 0.1, AudioPan(BM_bridgeUp) , 0, 0, 1, AudioPan(BM_bridgeUp)
				dbridge.Enabled = 0
			End If
	End Select
	'Update visuals
	'debug.print "dbAngle = "&dbAngle
	For each BP in BP_bridgeDown: BP.rotx = dbAngle + 90: Next
	For each BP in BP_bridgeUp: BP.rotx = dbAngle + 90: Next
End Sub



'************************************************************************
' ZDOR: Drawbridge and Castle Door Shake
'************************************************************************

Sub DoorDrawbridge_Hit()
	RandomSoundMetal
	If Controller.Switch(56)=1 Then
		DOF 102, DOFPulse
		doorshake.Enabled = 1
		TwrShake
	End If
End Sub

Sub Wall108_hit
	TwrShake
End Sub

dim doors, doorsh, doorbrake

sub doorshake_timer()
	Dim BP
	if doorbrake<3 then  
		doorbrake=doorbrake+0.1
		doors=doors+0.5
		doorsh=sin(doors)*(3-(doorbrake))
		If gateshake=0 then 
			For Each BP in BP_bridgeDown: BP.rotx = BP.rotx + doorsh + 90: Next
			For Each BP in BP_bridgeUp: BP.rotx = BP.rotx + doorsh +90: Next
		End If
		If gateshake=1 then 
			For Each BP in BP_gate: BP.transz = doorsh: Next
		End If
   end if
'		braket.rotx=braket.rotx+50
	if doorbrake>3  then 
		If gateshake=0 then 
			For Each BP in BP_bridgeDown: BP.rotx = 90: Next
			For Each BP in BP_bridgeUp: BP.rotx = 90: Next
		End If
		If gateshake=1 then 
			For Each BP in BP_gate: BP.transz = 0: Next
		End If
		doors=0: doorsh=0: doorbrake=0: gateshake=0: Me.Enabled=0: exit sub
	end if
end sub

dim gateshake

Sub DoorPortculis_Hit()
	gateshake=1
	RandomSoundMetal
	doorshake.enabled=1
	DOF 102, DOFPulse
	vpmTimer.PulseSw 37
	TwrShake
End Sub

'************************************************************************
' ZTWS: TOWERS SHAKE
'************************************************************************

dim vel2,per2,brake2
per2=0:vel2=0:brake2=0

Sub TwrShake
    towersshake.enabled = 1
	If brakew > 4 or GateT.timerenabled = false Then
		rotat=0
		brakew=4
		GateT.TimerEnabled=1
	End If		
End Sub

Sub towersshake_timer()
	if brake2 < 1 then vel2=vel2+0.1:brake2=brake2+0.01
	if BM_LUtower.roty>0 then per2=0:vel2=0 ' replace BP String
        per2=cos(vel2)-brake2
        
	LUroty = LUroty-(per2*0.2)
	LDroty = LDroty-(per2*0.2)
	RUroty = RUroty+(per2*0.2)
	RUrotx = RUrotx-(per2*0.2)
	Croty = Croty-(per2*0.2)
	Crotx = Crotx-(per2*0.2)

   If brake2>0.9 then 
		me.enabled=0
		per2=0:vel2=0:brake2=0:
		LUroty = 0
		LDroty = 0
		RUroty = 0
		RUrotx = 0
		Croty = 0
		Crotx = 0
	End If

	Dim BP
	For Each BP in BP_LUtower: BP.roty=LUroty: Next
	For Each BP in BP_LDtower: BP.roty=LDroty: Next
	For Each BP in BP_RUtower: BP.roty=RUroty: BP.rotx=RUrotx: Next
	For Each BP in BP_Ctower: BP.roty=Croty: BP.rotx=Crotx: Next
End Sub


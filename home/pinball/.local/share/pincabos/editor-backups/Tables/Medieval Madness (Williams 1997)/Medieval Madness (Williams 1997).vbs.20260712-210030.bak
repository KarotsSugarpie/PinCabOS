	MoatKick.collidable = False
	If Enabled Then
		SoundSaucerKick 1, sw36
	End If
End Sub


'************************************************************************
'	ZTRO: Trolls 
'************************************************************************

Dim LTDir, RTDir, TrollStep, LTPos, RTPos
dim lshake,rshake
lshake=0: rshake=0
LTPos=0: RTPos=0

Const TrollSpeed = 2 '0 - slow, 1 - medium, 2 - fast, 3 - really fast

If TrollSpeed = 0 Then
	TrollStep = 12
ElseIf TrollSpeed = 2 Then
	TrollStep = 24
ElseIf TrollSpeed = 3 Then
	TrollStep = 32
Else
	TrollStep = 16
End If

InitTrolls
Sub InitTrolls
	LTDir = -1: TrollLt.enabled = true
	RTDir = -1:	TrollRt.enabled = true
End Sub

Sub SolLeftTrollPow(Enabled)
	If Enabled then
		PlaySoundAt SoundFX("Troll_Left_Up",DOFContactors), BM_LTH
		TrollLt.enabled = false
		LTDir = 1
		TrollLt.enabled = true
	End If
	If NOT Enabled AND LTPos >= -8 Then
		TrollP1X.TimerEnabled=1
		TrollP1X.TimerInterval=10
	End If
End Sub

Sub SolLeftTrollHold(Enabled)
	If NOT Enabled AND LTPos > -104 Then
		TrollLt.enabled = false
		LTDir = -1
		TrollLt.enabled = true
		PlaySoundAt SoundFX("Troll_Left_Down",DOFContactors), BM_LTH
	End If
End Sub


Sub TrollLt_timer()
	Dim BP, b
	'position update
	LTPos = LTPos + (TrollStep * LTDir)

	'physical update
	if LTPos > -81 then
		TrollP1X.IsDropped = 0
		sw45.IsDropped = 0
		LTT.collidable = True
		Controller.Switch(74) = 1
	Else
		TrollP1X.IsDropped = 1
		sw45.IsDropped = 1
		Controller.Switch(74) = 0
		LTT.collidable = false
	end If

	'handle when ball is on top of rising troll
	For b = 0 to UBound(gBOT)
		If InRect(gBOT(b).x, gBOT(b).y, 291,870,373,846,395,956,312,973) and LTDir = 1 and gBOT(b).z < 121 Then 
			gBOT(b).z = 25 + LTPos + 104
			gBOT(b).velz = 15
		End If
	Next

	'handle end of motion
	If LTPos >= -8 Then
		LTPos = -8
		me.enabled = false
	Elseif LTPos <= -104 then
		LTPos = -104
		me.enabled = false
	End If

	'visual update
	For Each BP in BP_LTH: BP.z = LTPos: Next
	For Each BP in BP_LLDown
		BP.z = LTPos
		BP.visible = LTPos < -50
	Next
'	For Each BP in BP_LBDown
'		BP.z = LTPos
'		BP.visible = LTPos < -50
'	Next
	For Each BP in BP_LLUp
		BP.z = LTPos
		BP.visible = LTPos >= -50
	Next
	For Each BP in BP_LBUp
		BP.z = LTPos
		BP.visible = LTPos >= -50
	Next
End Sub


Sub TrollP1X_timer
	Dim BP
	lshake = lshake + 1
	If lshake < 12 then 
		For Each BP in BP_LLDown: BP.Transz = 1 + Sin(lshake): Next
		For Each BP in BP_LLUp: BP.Transz = 1 + Sin(lshake): Next
		For Each BP in BP_LTH: BP.Transz = 1 + Sin(lshake): Next
	Else
		me.TimerEnabled=0
		lshake=0
		For Each BP in BP_LLDown: BP.Transz = 0: Next
		For Each BP in BP_LLUp: BP.Transz = 0: Next
		For Each BP in BP_LTH: BP.Transz = 0: Next
	End If
End Sub


Sub SolRightTrollPow(Enabled)
	If Enabled then
		PlaySoundAt SoundFX("Troll_Right_Up",DOFContactors), BM_RTH
		TrollRt.enabled = false
		RTDir = 1
		TrollRt.enabled = true
	End If
	If NOT Enabled AND RTPos >= -8 Then
		TrollP2X.TimerEnabled=1
		TrollP2X.TimerInterval=10
	End If
End Sub

Sub SolRightTrollHold(Enabled)
	If NOT Enabled AND RTPos > -104 Then
		TrollRt.enabled = false
		RTDir = -1
		TrollRt.enabled = true
		PlaySoundAt SoundFX("Troll_Right_Down",DOFContactors), BM_RTH
	End If
End Sub

Sub TrollRt_timer()
	Dim BP, b
	'position update
	RTPos = RTPos + (TrollStep * RTDir)
	
	'physical update
	if RTPos > -81 then
		TrollP2X.IsDropped = 0
		sw46.IsDropped = 0
		RTT.collidable = True
		Controller.Switch(75) = 1
	Else
		TrollP2X.IsDropped = 1
		sw46.IsDropped = 1
		Controller.Switch(75) = 0
		RTT.collidable = false
	end If

	'handle when ball is on top of rising troll
	For b = 0 to UBound(gBOT)
		If InRect(gBOT(b).x, gBOT(b).y, 487,857,571,864,552,968,470,957) and RTDir = 1 Then 
			gBOT(b).z = 25 + RTPos + 104
			gBOT(b).velz = 15
		End If
	Next

	'handle end of motion
	If RTPos >= -8 Then
		RTPos = -8
		me.enabled = false
	Elseif RTPos <= -104 then
		RTPos = -104
		me.enabled = false
	End If

	'visual update
	For Each BP in BP_RTH: BP.z = RTPos: Next
	For Each BP in BP_RLDown
		BP.z = RTPos
		BP.visible = RTPos < -50
	Next
'	For Each BP in BP_RBDown
'		BP.z = RTPos
'		BP.visible = RTPos < -50
'	Next
	For Each BP in BP_RLUp
		BP.z = RTPos
		BP.visible = RTPos >= -50
	Next
	For Each BP in BP_RBUp
		BP.z = RTPos
		BP.visible = RTPos >= -50
	Next
End Sub

Sub TrollP2X_timer
	Dim BP
	rshake = rshake + 1
	if rshake<12 then 
		For Each BP in BP_RLDown: BP.Transz = 1 + Sin(rshake): Next
		For Each BP in BP_RLUp: BP.Transz = 1 + Sin(rshake): Next
		For Each BP in BP_RTH: BP.Transz = 1 + Sin(rshake): Next
	Else 
		me.TimerEnabled=0
		rshake=0
		For Each BP in BP_RLDown: BP.Transz = 0: Next
		For Each BP in BP_RLUp: BP.Transz = 0: Next
		For Each BP in BP_RTH: BP.Transz = 0: Next
	End If
End Sub


'Shake Trolls when hit

dim sbou,sbou2

Sub sw45_Hit():vpmTimer.PulseSw 45:Me.TimerEnabled = 1:sbou=ActiveBall.vely/4 :End Sub
Sub sw46_Hit():vpmTimer.PulseSw 46:Me.TimerEnabled = 1:sbou2=ActiveBall.vely/4 :End Sub

dim bou,brakeTl,perc
perc=1
Sub sw45_Timer()
	Dim Trotx, Troty, BP
    bou=bou+0.3:brakeTl=brakeTl+0.2
    if (perc-(brakeTl*(perc/6)))<0 then Me.TimerEnabled = 0 :bou=0 :brakeTl=0 :perc=5
    Trotx = sin(bou)*(perc-(brakeTl*(perc/6)))
    Troty = sin((bou)*sbou)*(perc-(brakeTl*(perc/6)))
	For Each BP in BP_LTH: BP.rotx = Trotx: BP.roty = Troty: Next
End Sub 

dim bou2,brakeTr,perc2
perc2=1
Sub sw46_Timer()
	Dim Trotx, Troty, BP
    bou2=bou2+0.3:brakeTr=brakeTr+0.2
    if (perc2-(brakeTr*(perc2/6)))<0 then Me.TimerEnabled = 0 :bou2=0 :brakeTr=0 :perc2=5
    Trotx = sin(bou2)*(perc2-(brakeTr*(perc2/10)))
    Troty = sin((bou2)*sbou2)*(perc2-(brakeTr*(perc2/6)))
	For Each BP in BP_RTH: BP.rotx = Trotx: BP.roty = Troty: Next
End Sub

'************************************************************************
' 	ZVRR: VR Room / VR Cabinet
'************************************************************************

Sub SetBackglass()
    Dim obj
    For Each obj In VRBackglass
        obj.x = obj.x - 15
        obj.height = - obj.y + 315
        obj.y = 57 'adjusts the distance from the backglass towards the user
        obj.rotx=-90
        obj.color = RGB(255,200,100)
    Next
End Sub

Sub L88_animate
	If VRRoom >0 Then
		VRCab_StartButton.blenddisableLighting = L88.GetInPlayIntensity
		VRCab_StartButtonRim.blenddisableLighting = L88.GetInPlayIntensity
	End If
End Sub

Sub L87_animate
	If VRRoom >0 Then
		VRCab_LaunchButton.blenddisableLighting = L87.GetInPlayIntensity/5
	End If
End Sub

Dim VRThings

Sub LoadVRRoom
	FireTimer.enabled = false
	for each VRThings in VR_Cab:VRThings.visible = 0:Next
	for each VRThings in VR_Min:VRThings.visible = 0:Next
	for each VRThings in VR_Mega:VRThings.visible = 0:Next
	for each VRThings in VRBackglass:VRThings.visible = 0:Next

	If RenderingMode = 2 or VRTest Then
		VRRoom = VRRoomChoice
		'disable table objects that should not be visible

	Else
		VRRoom = 0
		If DesktopMode Then VRCab_LockbarRails.visible = 1
	End If
	If VRRoom = 1 Then
		for each VRThings in VR_Cab:VRThings.visible = 1:Next
		for each VRThings in VR_Min:VRThings.visible = 1:Next
		for each VRThings in VR_Mega:VRThings.visible = 0:Next
		for each VRThings in VRBackglass:VRThings.visible = 1:Next
	End If
	If VRRoom = 2 Then
		for each VRThings in VR_Cab:VRThings.visible = 1:Next
		for each VRThings in VR_Min:VRThings.visible = 0:Next
		for each VRThings in VR_Mega:VRThings.visible = 0:Next
		for each VRThings in VRBackglass:VRThings.visible = 1:Next
	End If
	If VRRoom = 3 Then
		for each VRThings in VR_Cab:VRThings.visible = 1:Next
		for each VRThings in VR_Min:VRThings.visible = 0:Next
		for each VRThings in VR_Mega:VRThings.visible = 1:Next
		for each VRThings in VRBackglass:VRThings.visible = 1:Next
		FireTimer.enabled = true
	End If
End Sub

Dim FireAnim: FireAnim = 1
Sub FireTimer_timer()
	FireAnim = FireAnim + 1
	If FireAnim => 11 then FireAnim = 1
	VRFire000.image = "VR_Flame_" & FireAnim
	VRFire001.image = "VR_Flame_" & FireAnim
	VRFire002.image = "VR_Flame_" & FireAnim
	VRFire003.image = "VR_Flame_" & FireAnim
End Sub



Sub SolTowerLock(Enabled)
	'debug.print "SolTowerLock "&Enabled
	Dim BP
	StopSound "fx_Postup":PlaySoundAT SoundFX("fx_Postup",DOFContactors), sw58
	LockPost.IsDropped=NOT Enabled
	If Enabled Then
		For Each BP in BP_LockPostP: BP.transz = 0: Next
	Else
		For Each BP in BP_LockPostP: BP.transz = -50: Next
	End If
End Sub

Sub sw58_Hit: Controller.Switch(58)=1:End Sub
Sub sw58_UnHit: Controller.Switch(58)=0:End Sub

'************************************************************************
' ZMLS: Merlin Saucer
'************************************************************************

'******************* VUKs **********************

Dim KickerBall28		'Each VUK needs its own "kickerball"

Sub KickBall(kball, kangle, kvel, kvelz, kzlift)	'Defines how KickBall works
	dim rangle
	rangle = PI * (kangle - 90) / 180
    
	kball.z = kball.z + kzlift
	kball.velz = kvelz
	kball.velx = cos(rangle)*kvel
	kball.vely = sin(rangle)*kvel
End Sub

'Goal VUK
Sub sw28_Hit										'Switch associated with Kicker
    set KickerBall28 = activeball
    Controller.Switch(28) = 1
    SoundSaucerLock
End Sub

Sub sw28_unhit
	KickerBall28 = Empty
	Controller.Switch(28) = 0
End Sub

Sub SolMerlin(Enable)							'Solonoid name associated with kicker.
    If Enable then
		If Not IsEmpty(KickerBall28) Then
			KickBall KickerBall28, 109, 8, 8, 0
			SoundSaucerKick 1, sw28
			WireRampOn False
		End If
	End If
End Sub



' Lock_Door
dim rotat,brakew

Sub GateT_Hit
	rotat=0
	brakew=1
	me.TimerEnabled=0
	me.TimerEnabled=1
	me.TimerInterval=7
	if activeball.vely < -20 then TwrShake
	RandomSoundWall()
End Sub

Sub GateT_timer()
	Dim BP
	If brakew <7 then 
		rotat = rotat+0.07
		brakew = brakew+0.003 
		For Each BP in BP_Lock_Door: BP.rotX=(cos(rotat+90)*100)/brakew^3: Next
	Else
		For Each BP in BP_Lock_Door: BP.rotX=0: Next
		me.TimerEnabled = 0
	End If
End Sub


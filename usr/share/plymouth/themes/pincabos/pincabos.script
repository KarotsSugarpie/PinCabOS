screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# fond noir sous l'illustration (bandes en mode portrait)
backdrop = Sprite(Image.Text("", 0, 0, 0));
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

background_image = Image("pincabos.png");
img_w = background_image.GetWidth();
img_h = background_image.GetHeight();

# "contain" : ratio preserve, centre — jamais deforme
scale = screen_width / img_w;
if (img_h * scale > screen_height)
    scale = screen_height / img_h;

scaled_w = img_w * scale;
scaled_h = img_h * scale;
off_x = (screen_width - scaled_w) / 2;
off_y = (screen_height - scaled_h) / 2;

background_sprite = Sprite(background_image.Scale(scaled_w, scaled_h));
background_sprite.SetX(off_x);
background_sprite.SetY(off_y);
background_sprite.SetZ(-100);

# barre positionnee par rapport a l'illustration (pas a l'ecran)
bar_width = scaled_w * 0.193;
bar_height = 6;
bar_x = off_x + (scaled_w - bar_width) / 2;
bar_y = off_y + scaled_h * 0.728;

box_image = Image("progress_box.png");
bar_image = Image("progress_bar.png");

box_sprite = Sprite(box_image.Scale(bar_width, bar_height));
box_sprite.SetX(bar_x);
box_sprite.SetY(bar_y);
box_sprite.SetZ(10);

bar_sprite = Sprite(bar_image.Scale(1, bar_height));
bar_sprite.SetX(bar_x);
bar_sprite.SetY(bar_y);
bar_sprite.SetZ(11);

# progression reelle si dispo, sinon avance temporelle : bouge toujours
progress_target = 0;
progress_shown = 0;
tick = 0;

fun boot_progress_callback(duration, progress) {
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    progress_target = progress;
}

fun refresh_callback() {
    tick++;
    creep = tick / 1500;
    if (creep > 0.95) creep = 0.95;
    target = progress_target;
    if (target < creep) target = creep;
    progress_shown = progress_shown + (target - progress_shown) * 0.08;
    current_width = bar_width * progress_shown;
    if (current_width < 1) current_width = 1;
    bar_sprite.SetImage(bar_image.Scale(current_width, bar_height));
}

fun quit_callback() {
    bar_sprite.SetImage(bar_image.Scale(bar_width, bar_height));
}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetQuitFunction(quit_callback);

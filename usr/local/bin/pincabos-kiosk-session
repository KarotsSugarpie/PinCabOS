#!/bin/sh
# Session X du kiosk installer : openbox + wizard plein ecran
xsetroot -solid "#050007" 2>/dev/null || true
# PINCABOS_KIOSK_OPENBOX_V1 : un bureau, aucune liaison (la molette restait a openbox)
openbox --config-file /usr/local/share/pincabos/kiosk-rc.xml &
exec /usr/local/bin/pincabos-kiosk.py

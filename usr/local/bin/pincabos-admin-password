#!/usr/bin/env bash
# PinCabOS — identifiants des pages d'administration de la WebApp.
#
# Les pages /admin et /dev ont des identifiants SEPARES : deux accès, deux
# secrets. Tant qu'aucun n'est défini sur ce cabinet, chaque page utilise son
# identifiant par défaut documenté et l'affiche en avertissement.
#
#   pincabos-admin-password --show              état des deux pages
#   pincabos-admin-password --set [utilisateur]      page /admin
#   pincabos-admin-password --set-dev [utilisateur]  page /dev
#   pincabos-admin-password --reset             retour aux deux défauts
set -Eeuo pipefail

CONFIG_DIR="/opt/pincabos/config"
LOGIN_FILE="$CONFIG_DIR/admin-login.txt"
PASS_FILE="$CONFIG_DIR/admin-password.txt"
DEV_LOGIN_FILE="$CONFIG_DIR/dev-login.txt"
DEV_PASS_FILE="$CONFIG_DIR/dev-password.txt"
DEFAULT_USER="admin"
DEFAULT_PASS="PinCabOS123\$"
DEFAULT_DEV_USER="PinCabOsDev"
DEFAULT_DEV_PASS="PinCabOSDev123\$"

if [ "$(id -u)" -ne 0 ]; then
  echo "Cet outil doit être lancé avec sudo." >&2
  exit 1
fi

write_secret() {
  local path="$1" value="$2"
  install -d -m 0755 "$CONFIG_DIR"
  printf '%s\n' "$value" > "$path"
  chmod 0600 "$path"
  # La WebApp tourne sous le compte pinball : sans ce chown, elle ne peut pas
  # lire le fichier et retombe silencieusement sur l'identifiant par défaut.
  chown pinball:pinball "$path" 2>/dev/null || true
}

read_or_default() {
  local path="$1" fallback="$2" value=""
  [ -s "$path" ] && value="$(cat "$path" 2>/dev/null || true)"
  printf '%s' "${value:-$fallback}"
}

restart_webapp() {
  systemctl reset-failed pincabos-webapp.service 2>/dev/null || true
  systemctl restart pincabos-webapp.service 2>/dev/null || true
}

show_page() {   # $1 = libellé, $2 = fichier login, $3 = fichier mdp, $4/$5 = défauts
  local user pass origin
  user="$(read_or_default "$2" "$4")"
  if [ -s "$3" ]; then
    pass="$(cat "$3")"
    origin="défini sur ce cabinet"
  else
    pass="$5"
    origin="mot de passe par DÉFAUT — à changer"
  fi
  printf '%-8s : %s / %s\n' "$1" "$user" "$pass"
  printf '%-8s   (%s)\n' "" "$origin"
}

warn_unreadable() {
  local bad=""
  for f in "$LOGIN_FILE" "$PASS_FILE" "$DEV_LOGIN_FILE" "$DEV_PASS_FILE"; do
    if [ -f "$f" ] && ! sudo -u pinball test -r "$f" 2>/dev/null; then
      bad="$bad $f"
    fi
  done
  if [ -n "$bad" ]; then
    echo
    echo "ATTENTION : fichier(s) illisible(s) par la WebApp (elle utilisera le défaut) :"
    for f in $bad; do echo "  $f"; done
    echo "Repose-les avec --set / --set-dev pour corriger le propriétaire."
  fi
}

ask_password() {   # renvoie le mot de passe saisi sur stdout
  local p1 p2
  read -rsp "Nouveau mot de passe : " p1 >&2; echo >&2
  read -rsp "Confirmation          : " p2 >&2; echo >&2
  [ -n "$p1" ] || { echo "Mot de passe vide : abandon." >&2; return 1; }
  [ "$p1" = "$p2" ] || { echo "Les mots de passe diffèrent : abandon." >&2; return 1; }
  printf '%s' "$p1"
}

case "${1:---show}" in
  --show)
    echo "Les pages /admin et /dev ont des identifiants séparés."
    echo
    show_page "/admin" "$LOGIN_FILE" "$PASS_FILE" "$DEFAULT_USER" "$DEFAULT_PASS"
    show_page "/dev" "$DEV_LOGIN_FILE" "$DEV_PASS_FILE" "$DEFAULT_DEV_USER" "$DEFAULT_DEV_PASS"
    warn_unreadable
    ;;

  --set)
    current="$(read_or_default "$LOGIN_FILE" "$DEFAULT_USER")"
    user="${2:-}"
    if [ -z "$user" ]; then
      read -rp "Utilisateur /admin [$current] : " user
      user="${user:-$current}"
    fi
    pass="$(ask_password)" || exit 1
    write_secret "$LOGIN_FILE" "$user"
    write_secret "$PASS_FILE" "$pass"
    restart_webapp
    echo
    echo "Page /admin : identifiants mis à jour pour « $user »."
    echo "La page /dev n'est PAS modifiée (voir --set-dev)."
    ;;

  --set-dev)
    current="$(read_or_default "$DEV_LOGIN_FILE" "$DEFAULT_DEV_USER")"
    user="${2:-}"
    if [ -z "$user" ]; then
      read -rp "Utilisateur /dev [$current] : " user
      user="${user:-$current}"
    fi
    pass="$(ask_password)" || exit 1
    write_secret "$DEV_LOGIN_FILE" "$user"
    write_secret "$DEV_PASS_FILE" "$pass"
    restart_webapp
    echo
    echo "Page /dev : identifiants mis à jour pour « $user »."
    echo "La page /admin n'est PAS modifiée (voir --set)."
    ;;

  --reset)
    rm -f "$LOGIN_FILE" "$PASS_FILE" "$DEV_LOGIN_FILE" "$DEV_PASS_FILE"
    restart_webapp
    echo "Retour aux identifiants par défaut :"
    echo "  /admin : ${DEFAULT_USER} / ${DEFAULT_PASS}"
    echo "  /dev   : ${DEFAULT_DEV_USER} / ${DEFAULT_DEV_PASS}"
    echo "Les pages afficheront un avertissement tant qu'ils sont en place."
    ;;

  -h|--help)
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    echo "Usage : pincabos-admin-password [--show | --set [user] | --set-dev [user] | --reset]" >&2
    echo "Les pages /admin et /dev ont des identifiants séparés." >&2
    exit 1
    ;;
esac

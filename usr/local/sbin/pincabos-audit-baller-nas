    encoding="utf-8",
)

log(
    f"Bases détectées : "
    f"{len(popper_data['bases'])}"
)

log(
    f"Enregistrements utiles : "
    f"{len(popper_data['enregistrements'])}"
)

rom_files = (
    list(paths["roms"].glob("*.zip"))
    if paths["roms"].is_dir()
    else []
)

altcolor_directories = (
    [
        path
        for path in paths["altcolor"].iterdir()
        if path.is_dir()
    ]
    if paths["altcolor"].is_dir()
    else []
)

altsound_directories = (
    [
        path
        for path in paths["altsound"].iterdir()
        if path.is_dir()
    ]
    if paths["altsound"].is_dir()
    else []
)

pup_directories = (
    [
        path
        for path in paths["pupvideos"].iterdir()
        if path.is_dir()
    ]
    if paths["pupvideos"].is_dir()
    else []
)

vpx_files = (
    sorted(paths["tables"].rglob("*.vpx"))
    if paths["tables"].is_dir()
    else []
)

log()
log(
    f"--- Associations des "
    f"{len(vpx_files)} tables VPX ---"
)

association_columns = [
    "vpx",
    "octets",
    "sidecars",
    "popper_game_display",
    "popper_media_search",
    "rom",
    "source_rom",
    "rom_zip",
    "altcolor",
    "altsound",
    "pupvideo",
]

with (out / "associations-tables.tsv").open(
    "w",
    newline="",
    encoding="utf-8",
) as handle:
    writer = csv.DictWriter(
        handle,
        fieldnames=association_columns,
        delimiter="\t",
    )

    writer.writeheader()

    for index, vpx in enumerate(vpx_files, 1):
        popper_records = popper_mapping.get(
            normalize(vpx.stem),
            [],
        )

        popper_record = (
            popper_records[0]
            if popper_records
            else {}
        )

        popper_rom = database_field(
            popper_record,
            "rom",
        )

        detected_rom, detected_source = detect_script_rom(vpx)

        rom_name = popper_rom or detected_rom

        media_search = database_field(
            popper_record,
            "mediasearch",
        )

        pup_matches = find_matching_items(
            rom_name,
            pup_directories,
        )

        if not pup_matches:
            pup_matches = find_matching_items(
                media_search,
                pup_directories,
            )

        writer.writerow(
            {
                "vpx": str(vpx),
                "octets": vpx.stat().st_size,
                "sidecars": " | ".join(
                    find_sidecars(vpx)
                ),
                "popper_game_display": database_field(
                    popper_record,
                    "gamedisplay",
                ),
                "popper_media_search": media_search,
                "rom": rom_name,
                "source_rom": (
                    "Popper DB"
                    if popper_rom
                    else detected_source
                ),
                "rom_zip": " | ".join(
                    map(
                        str,
                        find_matching_items(
                            rom_name,
                            rom_files,
                        ),
                    )
                ),
                "altcolor": " | ".join(
                    map(
                        str,
                        find_matching_items(
                            rom_name,
                            altcolor_directories,
                        ),
                    )
                ),
                "altsound": " | ".join(
                    map(
                        str,
                        find_matching_items(
                            rom_name,
                            altsound_directories,
                        ),
                    )
                ),
                "pupvideo": " | ".join(
                    map(
                        str,
                        pup_matches,
                    )
                ),
            }
        )

        if index % 100 == 0:
            log(
                f"  {index}/{len(vpx_files)} "
                f"tables examinées"
            )

duplicate_names = {
    key: count
    for key, count in Counter(
        normalize(path.stem)
        for path in vpx_files
    ).items()
    if key and count > 1
}


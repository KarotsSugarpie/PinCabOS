#!/usr/bin/env bash
# Created by Karots Sugarpie
# PINCABOS_SCRIPT_NAME="pincabos-autoresume-console.sh"
# PINCABOS_SCRIPT_ROLE="Hidden root console autoresume after RUN_01 reboot"
# PINCABOS_SCRIPT_REQUIRES_FILES="/opt/pincabos/install/go-pincabos.sh /opt/pincabos/modules/network/mod-dhcp4.sh /opt/pincabos/modules/network/mod-ssid.sh"
# PINCABOS_SCRIPT_REQUIRES_COMMANDS="bash ip systemctl"

set -Eeuo pipefail

export TERM="${TERM:-linux}"
export PINCABOS_EXPLICIT=1
export PINCABOS_AUTORESTART=1

exec </dev/tty1 >/dev/tty1 2>&1 || true

clear
ORANGE='\033[38;5;208m'
RESET='\033[0m'

echo -e "${ORANGE}────────────────────────────────────────────────────────────────${RESET}"
echo -e "${ORANGE} PinCabOS - Root autoresume console${RESET}"
echo -e "${ORANGE}────────────────────────────────────────────────────────────────${RESET}"
echo
echo "GO [√] Root autologin console active"
echo "GO [√] Login prompt hidden by getty override"
echo

log() {
  printf '%s\n' "$*"
}

run_optional() {
  local label="$1"
  shift
  echo
  echo "─► ${label}"
  "$@" || {
    local rc=$?
    echo "WARN ${label} returned rc=${rc}; continuing autoresume"
    return 0
  }
}

echo "=== 1) Network restart / DHCP4 ==="

if [ -x /opt/pincabos/modules/network/mod-dhcp4.sh ]; then
  run_optional "PinCabOS DHCP4 module" bash /opt/pincabos/modules/network/mod-dhcp4.sh --explicit
else
  echo "WARN DHCP4 module missing; using safe fallback"
  systemctl restart systemd-networkd 2>/dev/null || true
  systemctl restart NetworkManager 2>/dev/null || true
fi

echo
echo "=== 2) Wi-Fi / SSID module if Wi-Fi hardware exists ==="

WIFI_FOUND=0
if command -v iw >/dev/null 2>&1 && iw dev 2>/dev/null | grep -q 'Interface '; then
  WIFI_FOUND=1
fi
if command -v nmcli >/dev/null 2>&1 && nmcli -t -f TYPE device 2>/dev/null | grep -q '^wifi$'; then
  WIFI_FOUND=1
fi
if ls /sys/class/net 2>/dev/null | grep -Eq '^(wl|wlan)'; then
  WIFI_FOUND=1
fi

if [ "$WIFI_FOUND" = "1" ] && [ -x /opt/pincabos/modules/network/mod-ssid.sh ]; then
  run_optional "PinCabOS SSID module" bash /opt/pincabos/modules/network/mod-ssid.sh --explicit
else
  echo "GO [√] No Wi-Fi module required or no Wi-Fi hardware detected"
fi

echo
echo "=== 3) Network summary before RUN_02 ==="
ip -4 -br addr show scope global 2>/dev/null || true
ip route 2>/dev/null | sed -n '1,20p' || true

echo
echo "=== 4) Continue PinCabOS RUN_02 ==="

if [ -x /opt/pincabos/install/go-pincabos.sh ]; then
  exec /opt/pincabos/install/go-pincabos.sh --resume --explicit
fi

if command -v go-pincabos >/dev/null 2>&1; then
  exec go-pincabos --resume --explicit
fi

echo "NOGO [X] go-pincabos not found for autoresume"
exec /bin/bash -l

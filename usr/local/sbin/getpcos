#!/usr/bin/env bash
set -Eeuo pipefail

PROGRAM="getpcos"
DEFAULT_REPO="https://pincabos.cc/updates"
DEFAULT_CHANNEL="beta"
CONFIG_FILE="/etc/pincabos/getpcos.conf"
STATE_DIR="/var/lib/getpcos"
CACHE_DIR="/var/cache/getpcos"
BACKUP_ROOT="/opt/pincabos/backups/updates"
LOCK_FILE="/run/lock/getpcos.lock"

REPO_BASE="$DEFAULT_REPO"
CHANNEL="$DEFAULT_CHANNEL"

[[ -r "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
REPO_BASE="${REPO_BASE%/}"

green=$'\033[1;32m'
orange=$'\033[1;33m'
red=$'\033[1;31m'
reset=$'\033[0m'

go()   { printf '%sGO [√]%s %s\n' "$green" "$reset" "$*"; }
warn() { printf '%sAVERTISSEMENT%s %s\n' "$orange" "$reset" "$*" >&2; }
fail() { printf '%sERREUR%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }

need_root() {
  [[ ${EUID:-$(id -u)} -eq 0 ]] || fail "Cette commande doit être exécutée avec sudo."
}

need_tools() {
  local t
  for t in curl sha256sum tar python3 flock sort comm; do
    command -v "$t" >/dev/null 2>&1 || fail "Commande requise absente: $t"
  done
  tar --help 2>/dev/null | grep -q -- '--zstd' || fail "GNU tar avec support zstd est requis."
}

json_get() {
  local file="$1" key="$2"
  python3 - "$file" "$key" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    data = json.load(f)
value = data
for part in sys.argv[2].split("."):
    value = value[part]
print(value)
PY
}

is_allowed_path() {
  local p="$1"
  [[ "$p" != /* ]] || return 1
  [[ "$p" != *".."* ]] || return 1
  [[ "$p" != *$'\n'* && "$p" != *$'\r'* ]] || return 1

  case "$p" in
    opt/pincabos/web/*|opt/pincabos/bin/*|opt/pincabos/script/*|opt/pincabos/update/*)
      ;;
    etc/systemd/system/pincabos-*.service|etc/systemd/system/pincabos-*.timer|\
    etc/systemd/system/pincabos-*.path|etc/systemd/system/pincabos-*.socket|\
    etc/systemd/system/pincabos-*.target|etc/systemd/system/pincabos-*.service.d/*)
      ;;
    etc/udev/rules.d/*pincabos*.rules|etc/sudoers.d/*pincabos*|\
    etc/polkit-1/rules.d/*pincabos*.rules)
      ;;
    usr/local/bin/getpcos|usr/local/sbin/getpcos)
      ;;
    *)
      return 1
      ;;
  esac

  case "$p" in
    opt/pincabos/web/.venv/*|opt/pincabos/web/backups/*|\
    opt/pincabos/web/__pycache__/*|opt/pincabos/build/*|\
    opt/pincabos/backups/*|opt/pincabos/logs/*|\
    home/pinball/Tables/*|home/pinball/.vpinball/*|\
    home/pinball/.config/vpinfe/*)
      return 1
      ;;
  esac
  return 0
}

validate_files_list() {
  local list="$1" line count=0
  [[ -s "$list" ]] || fail "La liste de fichiers est vide."
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "$line" ]] || continue
    is_allowed_path "$line" || fail "Chemin refusé dans le paquet: $line"
    count=$((count + 1))
  done < "$list"
  (( count > 0 )) || fail "Aucun fichier valide dans le paquet."
}

download_latest() {
  local destination="$1"
  curl -fL --retry 3 --connect-timeout 15 \
    "$REPO_BASE/channels/$CHANNEL/latest.json" -o "$destination"
}

read_latest() {
  local latest="$1"
  VERSION="$(json_get "$latest" version)"
  ARCHIVE_REL="$(json_get "$latest" archive)"
  ARCHIVE_SHA256="$(json_get "$latest" sha256)"
  FILES_REL="$(json_get "$latest" files)"
  [[ "$VERSION" =~ ^[A-Za-z0-9._+-]+$ ]] || fail "Version distante invalide."
  [[ "$ARCHIVE_REL" != /* && "$ARCHIVE_REL" != *".."* ]] || fail "Chemin d'archive distant invalide."
  [[ "$FILES_REL" != /* && "$FILES_REL" != *".."* ]] || fail "Chemin de manifeste distant invalide."
  [[ "$ARCHIVE_SHA256" =~ ^[a-fA-F0-9]{64}$ ]] || fail "SHA256 distant invalide."
}

installed_version() {
  if [[ -s "$STATE_DIR/installed-version" ]]; then
    cat "$STATE_DIR/installed-version"
  else
    printf 'aucune\n'
  fi
}

validate_archive_contents() {
  local archive="$1" expected="$2" actual="$3"
  tar --zstd -tf "$archive" \
    | sed 's#^\./##; /\//!d' \
    | sed '/\/$/d' \
    | sort -u > "$actual"
  sort -u "$expected" -o "$expected"
  if ! cmp -s "$expected" "$actual"; then
    warn "Différence entre files.list et le contenu de l'archive:"
    diff -u "$expected" "$actual" >&2 || true
    fail "Archive refusée."
  fi
}

validate_updated_files() {
  local list="$1" p
  while IFS= read -r p || [[ -n "$p" ]]; do
    [[ -n "$p" ]] || continue
    case "$p" in
      *.sh)
        [[ -f "/$p" ]] && bash -n "/$p"
        ;;
      *.py)
        [[ -f "/$p" ]] && python3 -m py_compile "/$p"
        ;;
      etc/sudoers.d/*)
        if command -v visudo >/dev/null 2>&1 && [[ -f "/$p" ]]; then
          visudo -cf "/$p" >/dev/null
        fi
        ;;
    esac
  done < "$list"
}

service_stop_list() {
  local out="$1" svc
  : > "$out"
  for svc in \
    pincabos-webapp.service \
    pincabos-vpinfe.service \
    pincabos-fulldmd.service \
    pincabos-dof.service
  do
    if systemctl list-unit-files "$svc" >/dev/null 2>&1 && systemctl is-active --quiet "$svc"; then
      printf '%s\n' "$svc" >> "$out"
      systemctl stop "$svc"
    fi
  done
}

service_restart_list() {
  local file="$1" svc
  systemctl daemon-reload || true
  command -v udevadm >/dev/null 2>&1 && udevadm control --reload-rules || true
  while IFS= read -r svc || [[ -n "$svc" ]]; do
    [[ -n "$svc" ]] || continue
    systemctl restart "$svc" || warn "Impossible de redémarrer $svc"
  done < "$file"
}

perform_rollback_dir() {
  local dir="$1" p previous
  [[ -d "$dir" ]] || fail "Sauvegarde introuvable: $dir"
  [[ -f "$dir/new-files.list" ]] || fail "new-files.list absent."
  [[ -f "$dir/existing-files.list" ]] || fail "existing-files.list absent."
  [[ -f "$dir/backup.tar.zst" ]] || fail "backup.tar.zst absent."

  while IFS= read -r p || [[ -n "$p" ]]; do
    [[ -n "$p" ]] || continue
    is_allowed_path "$p" || fail "Chemin de rollback refusé: $p"
    rm -f -- "/$p"
  done < "$dir/new-files.list"

  tar --zstd -xpf "$dir/backup.tar.zst" -C /
  systemctl daemon-reload || true
  command -v udevadm >/dev/null 2>&1 && udevadm control --reload-rules || true

  previous="aucune"
  [[ -s "$dir/previous-version" ]] && previous="$(cat "$dir/previous-version")"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$previous" > "$STATE_DIR/installed-version"
  go "Rollback terminé. Version restaurée: $previous"
}

cmd_check() {
  need_tools
  mkdir -p "$CACHE_DIR"
  local tmp
  tmp="$(mktemp "$CACHE_DIR/latest.XXXXXX.json")"
  trap 'rm -f "$tmp"' RETURN
  download_latest "$tmp"
  read_latest "$tmp"
  printf 'Version installée : %s\n' "$(installed_version)"
  printf 'Version disponible: %s\n' "$VERSION"
  printf 'Canal             : %s\n' "$CHANNEL"
  printf 'Dépôt             : %s\n' "$REPO_BASE"
}

cmd_status() {
  printf 'Dépôt             : %s\n' "$REPO_BASE"
  printf 'Canal             : %s\n' "$CHANNEL"
  printf 'Version installée : %s\n' "$(installed_version)"
  if [[ -s "$STATE_DIR/last-backup" ]]; then
    printf 'Dernière sauvegarde: %s\n' "$(cat "$STATE_DIR/last-backup")"
  fi
}

cmd_update() {
  need_root
  need_tools
  mkdir -p "$STATE_DIR" "$CACHE_DIR" "$BACKUP_ROOT" "$(dirname "$LOCK_FILE")"
  exec 9>"$LOCK_FILE"
  flock -n 9 || fail "Une autre opération getpcos est déjà en cours."

  local work latest archive files actual current timestamp backup services failed=0
  work="$(mktemp -d "$CACHE_DIR/update.XXXXXX")"
  trap 'rm -rf "$work"' EXIT

  latest="$work/latest.json"
  archive="$work/pincabos-update.tar.zst"
  files="$work/files.list"
  actual="$work/archive-files.list"

  printf 'Recherche des mises à jour PinCabOS...\n'
  download_latest "$latest"
  read_latest "$latest"

  current="$(installed_version)"
  if [[ "$current" == "$VERSION" ]]; then
    go "PinCabOS est déjà à jour: $VERSION"
    return 0
  fi

  curl -fL --retry 3 "$REPO_BASE/$ARCHIVE_REL" -o "$archive"
  curl -fL --retry 3 "$REPO_BASE/$FILES_REL" -o "$files"

  printf '%s  %s\n' "$ARCHIVE_SHA256" "$archive" | sha256sum -c -
  go "SHA256 valide."

  validate_files_list "$files"
  validate_archive_contents "$archive" "$files" "$actual"
  go "Contenu du paquet validé."

  timestamp="$(date +%Y%m%d-%H%M%S)"
  backup="$BACKUP_ROOT/${timestamp}-before-${VERSION}"
  mkdir -p "$backup"
  printf '%s\n' "$current" > "$backup/previous-version"
  cp -a "$files" "$backup/update-files.list"

  : > "$backup/existing-files.list"
  : > "$backup/new-files.list"
  while IFS= read -r p || [[ -n "$p" ]]; do
    [[ -n "$p" ]] || continue
    if [[ -e "/$p" || -L "/$p" ]]; then
      printf '%s\n' "$p" >> "$backup/existing-files.list"
    else
      printf '%s\n' "$p" >> "$backup/new-files.list"
    fi
  done < "$files"

  if [[ -s "$backup/existing-files.list" ]]; then
    tar --zstd -cpf "$backup/backup.tar.zst" -C / -T "$backup/existing-files.list"
  else
    tar --zstd -cpf "$backup/backup.tar.zst" --files-from /dev/null
  fi
  sha256sum "$backup/backup.tar.zst" > "$backup/backup.tar.zst.sha256"

  services="$backup/active-services.list"
  service_stop_list "$services"

  set +e
  tar --zstd --same-owner --same-permissions -xpf "$archive" -C /
  rc=$?
  if (( rc == 0 )); then
    validate_updated_files "$files"
    rc=$?
  fi
  set -e

  if (( rc != 0 )); then
    warn "Échec de l'installation; rollback automatique."
    perform_rollback_dir "$backup"
    service_restart_list "$services"
    fail "La mise à jour $VERSION n'a pas été installée."
  fi

  service_restart_list "$services"
  printf '%s\n' "$VERSION" > "$STATE_DIR/installed-version"
  printf '%s\n' "$backup" > "$STATE_DIR/last-backup"
  cp -a "$latest" "$STATE_DIR/installed-release.json"
  go "Mise à jour PinCabOS installée: $VERSION"
}

cmd_rollback() {
  need_root
  need_tools
  local dir
  dir="${2:-}"
  if [[ -z "$dir" ]]; then
    [[ -s "$STATE_DIR/last-backup" ]] || fail "Aucune sauvegarde enregistrée."
    dir="$(cat "$STATE_DIR/last-backup")"
  fi
  perform_rollback_dir "$dir"
}

usage() {
  cat <<'EOF'
Usage:
  sudo getpcos update       Télécharge et installe la dernière mise à jour
  getpcos check             Vérifie si une mise à jour existe
  getpcos status            Affiche le dépôt et la version installée
  sudo getpcos rollback     Restaure la dernière sauvegarde
EOF
}

case "${1:-}" in
  update)   cmd_update ;;
  check)    cmd_check ;;
  status)   cmd_status ;;
  rollback) cmd_rollback "$@" ;;
  -h|--help|help|"") usage ;;
  *) fail "Commande inconnue: $1" ;;
esac

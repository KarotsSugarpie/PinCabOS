#!/usr/bin/env bash
set -u

# PINCABOS_KERNEL_MAINTENANCE_V1
#
# Les metas kernel (linux-generic & co) sont volontairement en apt-hold dans
# l'image PinCabOS : un cabinet ne change jamais de kernel tout seul. Revers de
# la medaille constate sur le parc : les cabinets restent figes sur le kernel
# de leur ISO d'origine et accumulent les anciens kernels sans jamais les
# nettoyer.
#
# Ce script fait UNE passe de maintenance controlee, concue pour un timer
# hebdomadaire ou un lancement manuel (sudo pincabos-kernel-maintenance) :
#   1. degele les metas, installe le kernel courant des depots Ubuntu ;
#   2. verifie que DKMS (pilote NVIDIA) a bien construit ses modules pour le
#      nouveau kernel — sinon on NE purge rien (l'ancien kernel reste le
#      filet de securite) ;
#   3. purge tous les kernels sauf le plus recent et celui qui tourne ;
#   4. regele les metas (la politique appliance est conservee) ;
#   5. ne redemarre JAMAIS : si un reboot est requis, il pose le drapeau
#      /run/pincabos-kernel-reboot-required et le signale dans le journal.

LOCK="/run/pincabos-kernel-maintenance.lock"
FLAG="/run/pincabos-kernel-reboot-required"
METAS=(linux-generic linux-image-generic linux-headers-generic)

log() { echo "pincabos-kernel-maintenance: $*"; logger -t pincabos-kernel-maintenance "$*" 2>/dev/null || true; }

[[ "$(id -u)" -eq 0 ]] || { log "root requis"; exit 1; }

exec 9>"$LOCK"
flock -n 9 || { log "deja en cours"; exit 0; }

# Garde-fou espace disque : 2 Go libres minimum sur /
free_kib="$(df --output=avail / 2>/dev/null | tail -1 | tr -d ' ')"
if [[ "${free_kib:-0}" -lt 2097152 ]]; then
    log "NOGO : moins de 2 Go libres sur / (${free_kib:-?} KiB)"
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive LC_ALL=C

restore_holds() {
    apt-mark hold "${METAS[@]}" >/dev/null 2>&1 || true
}
trap restore_holds EXIT

log "degel des metas kernel"
apt-mark unhold "${METAS[@]}" >/dev/null 2>&1 || true

apt-get update -qq || log "apt update en echec (reseau ?) — on continue avec le cache"

log "installation du kernel courant des depots"
if ! apt-get install -y linux-generic >/dev/null 2>&1; then
    log "NOGO : installation du kernel en echec, aucun nettoyage effectue"
    exit 1
fi

running="$(uname -r)"
newest="$(linux-version list 2>/dev/null | linux-version sort --reverse 2>/dev/null | head -1)"
if [[ -z "$newest" ]]; then
    newest="$(dpkg -l 'linux-image-[0-9]*' 2>/dev/null | awk '/^ii/{sub(/^linux-image-/,"",$2); print $2}' | sort -V | tail -1)"
fi
[[ -n "$newest" ]] || { log "NOGO : impossible de determiner le kernel le plus recent"; exit 1; }
log "kernel qui tourne : $running ; plus recent installe : $newest"

# DKMS : si un module nvidia est gere par DKMS, il doit etre construit pour le
# kernel le plus recent AVANT toute purge — sinon on garde tout en l'etat.
if command -v dkms >/dev/null 2>&1 && dkms status 2>/dev/null | grep -q '^nvidia/'; then
    if ! dkms status 2>/dev/null | grep "^nvidia/" | grep -F "$newest" | grep -q "installed"; then
        log "NOGO : module nvidia DKMS absent pour $newest — purge annulee (les anciens kernels restent le filet de securite)"
        [[ "$newest" != "$running" ]] && { : > "$FLAG"; log "reboot requis vers $newest (drapeau pose : $FLAG)"; }
        exit 0
    fi
fi

log "purge des kernels autres que $running et $newest"
purged=0
while read -r version; do
    [[ -n "$version" ]] || continue
    [[ "$version" == "$running" || "$version" == "$newest" ]] && continue
    log "  purge du kernel $version"
    apt-get purge -y \
        "linux-image-$version" "linux-headers-$version" \
        "linux-modules-$version" "linux-modules-extra-$version" \
        "linux-tools-$version" >/dev/null 2>&1 || true
    purged=$((purged + 1))
done < <(dpkg -l 'linux-image-[0-9]*' 2>/dev/null | awk '/^ii/{sub(/^linux-image-/,"",$2); print $2}')

apt-get autoremove --purge -y >/dev/null 2>&1 || true
log "$purged ancien(s) kernel(s) purge(s)"

if [[ "$newest" != "$running" ]]; then
    : > "$FLAG"
    log "reboot requis pour basculer sur $newest (drapeau pose : $FLAG)"
else
    rm -f "$FLAG"
    log "le cabinet tourne deja sur le kernel le plus recent"
fi

exit 0

#!/bin/sh
# Filet ultime : le kiosk est tombe -> rendre tty1 a l'installeur texte,
# sauf si une installation pilotee par le GUI est en cours.
systemctl is-active --quiet pincabos-gui-install && exit 0
systemctl is-active --quiet pincabos-tui-fallback && exit 0
chvt 1
exec systemctl start pincabos-tui-fallback.service

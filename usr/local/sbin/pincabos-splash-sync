#!/usr/bin/env python3
"""Genere le splash de demarrage a partir de la configuration des ecrans.

PINCABOS_SPLASH_FROM_SCREENS_V1

Le theme Plymouth ne devine plus rien : il recoit les geometries exactes
definies dans screens.json — position, resolution parametree et rotation de
chaque role. L'image est posee une fois par ecran, et seul le playfield suit
l'orientation choisie a l'installation.

Sans cela, le theme appelait Window.GetWidth() sans indice : il traitait tous
les ecrans comme une seule surface et appliquait la rotation partout, laissant
le fronton couche sur un cabinet dont le playfield est en portrait.

Le theme vit dans l'initrd : il faut donc le regenerer apres chaque
modification, ce que fait ce script.

  pincabos-splash-sync [--force] [--no-initrd]
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

SCREENS = Path("/opt/pincabos/config/screens/screens.json")
THEME_DIR = Path("/usr/share/plymouth/themes/pincabos")
THEME = THEME_DIR / "pincabos.script"
EMPREINTE = Path("/var/lib/pincabos/splash-screens.sha256")
ROLES = ("playfield", "backglass", "fulldmd", "topper")

GEOMETRIE = re.compile(r"^(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$")


def geometries() -> tuple[dict[str, tuple[int, int, int, int]], int]:
    """Geometries par role et rotation du playfield, lues dans screens.json."""
    data = json.loads(SCREENS.read_text(encoding="utf-8"))
    ecrans: dict[str, tuple[int, int, int, int]] = {}
    for role in ROLES:
        entree = data.get(role)
        if not isinstance(entree, dict):
            continue
        m = GEOMETRIE.match(str(entree.get("geometry") or ""))
        if not m:
            continue
        largeur, hauteur, x, y = (int(v) for v in m.groups())
        if largeur > 0 and hauteur > 0:
            ecrans[role] = (x, y, largeur, hauteur)
    rotation = int(str(data.get("playfield_rotation") or "0") or 0) % 360
    if rotation not in (0, 90, 180, 270):
        rotation = 0
    return ecrans, rotation


def bloc_ecran(role: str, x: int, y: int, w: int, h: int, rot: int) -> str:
    """Pose l'illustration sur un ecran, aux dimensions parametrees."""
    return f"""
# --- {role} : {w}x{h}+{x}+{y}{f', rotation {rot}' if rot else ''}
x = {x}; y = {y}; w = {w}; h = {h}; r = {rot};
if (r == 90 || r == 270) {{ lw = h; lh = w; }} else {{ lw = w; lh = h; }}
scale = lw / iw;
if (ih * scale > lh) scale = lh / ih;
img = bg0.Scale(iw * scale, ih * scale);
if (r != 0) img = img.Rotate(r * PI / 180);
sprite_{role} = Sprite(img);
sprite_{role}.SetX(x + (w - img.GetWidth()) / 2);
sprite_{role}.SetY(y + (h - img.GetHeight()) / 2);
sprite_{role}.SetZ(-100);
"""


def theme(ecrans: dict[str, tuple[int, int, int, int]], rot: int) -> str:
    resume = ", ".join(
        f"{role} {w}x{h}+{x}+{y}" for role, (x, y, w, h) in ecrans.items()
    )
    parts = [f"""# PinCabOS splash — genere par pincabos-splash-sync
# PINCABOS_SPLASH_FROM_SCREENS_V1
#
# Ecrans parametres : {resume}
# Rotation du playfield : {rot}
#
# Les geometries viennent de screens.json : le theme ne detecte rien et ne
# suppose rien. Seul le playfield est tourne ; le fronton reste droit.

PI = 3.14159265358979;
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

bg0 = Image("pincabos.png");
iw = bg0.GetWidth();
ih = bg0.GetHeight();
"""]

    for role, (x, y, w, h) in ecrans.items():
        parts.append(bloc_ecran(role, x, y, w, h, rot if role == "playfield" else 0))

    px, py, pw, ph = ecrans["playfield"]
    if rot in (90, 270):
        lw, lh = ph, pw
    else:
        lw, lh = pw, ph

    parts.append(f"""
# --- barre de progression, sur le playfield uniquement
# Jamais de Rotate() sur la barre : Rotate recadre dans le canevas d'origine et
# la transformerait en pastille. On la pose en coordonnees ecran.
px = {px}; py = {py}; pw = {pw}; ph = {ph}; rot = {rot};
lw = {lw}; lh = {lh};
scale = lw / iw;
if (ih * scale > lh) scale = lh / ih;
bw = iw * scale;
bh = ih * scale;

bar_width = bw * 0.193;
bar_height = 6;
bar_lx = (lw - bw) / 2 + (bw - bar_width) / 2;
bar_ly = (lh - bh) / 2 + bh * 0.728;

box_image = Image("progress_box.png");
bar_image = Image("progress_bar.png");

box_sprite = Sprite();
box_sprite.SetZ(10);
if (rot == 0) {{
    box_sprite.SetImage(box_image.Scale(bar_width, bar_height));
    box_sprite.SetX(px + bar_lx); box_sprite.SetY(py + bar_ly);
}}
if (rot == 180) {{
    box_sprite.SetImage(box_image.Scale(bar_width, bar_height));
    box_sprite.SetX(px + pw - bar_lx - bar_width); box_sprite.SetY(py + ph - bar_ly - bar_height);
}}
if (rot == 90) {{
    box_sprite.SetImage(box_image.Scale(bar_height, bar_width));
    box_sprite.SetX(px + pw - bar_ly - bar_height); box_sprite.SetY(py + bar_lx);
}}
if (rot == 270) {{
    box_sprite.SetImage(box_image.Scale(bar_height, bar_width));
    box_sprite.SetX(px + bar_ly); box_sprite.SetY(py + ph - bar_lx - bar_width);
}}

bar_sprite = Sprite();
bar_sprite.SetZ(11);

progress_target = 0;
progress_shown = 0;
tick = 0;

fun refresh_callback() {{
    tick++;
    creep = tick / 1500;
    if (creep > 0.95) creep = 0.95;
    target = progress_target;
    if (target < creep) target = creep;
    progress_shown = progress_shown + (target - progress_shown) * 0.08;
    cw = bar_width * progress_shown;
    if (cw < 1) cw = 1;
    if (rot == 0) {{
        bar_sprite.SetImage(bar_image.Scale(cw, bar_height));
        bar_sprite.SetX(px + bar_lx); bar_sprite.SetY(py + bar_ly);
    }}
    if (rot == 180) {{
        bar_sprite.SetImage(bar_image.Scale(cw, bar_height));
        bar_sprite.SetX(px + pw - bar_lx - cw); bar_sprite.SetY(py + ph - bar_ly - bar_height);
    }}
    if (rot == 90) {{
        bar_sprite.SetImage(bar_image.Scale(bar_height, cw));
        bar_sprite.SetX(px + pw - bar_ly - bar_height); bar_sprite.SetY(py + bar_lx);
    }}
    if (rot == 270) {{
        bar_sprite.SetImage(bar_image.Scale(bar_height, cw));
        bar_sprite.SetX(px + bar_ly); bar_sprite.SetY(py + ph - bar_lx - cw);
    }}
}}

fun boot_progress_callback(duration, progress) {{
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    progress_target = progress;
}}

Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
""")
    return "".join(parts)


def regenerer_initrd() -> bool:
    for outil in (["dracut", "--regenerate-all", "--force"],
                  ["update-initramfs", "-u", "-k", "all"]):
        try:
            subprocess.run(outil, check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            print(f"  initrd regenere ({outil[0]})")
            return True
        except (FileNotFoundError, subprocess.CalledProcessError):
            continue
    print("  AVERTISSEMENT : initrd non regenere, le splash gardera l'ancienne mise en page")
    return False


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--force", action="store_true",
                        help="regenerer meme si la configuration n'a pas change")
    parser.add_argument("--no-initrd", action="store_true",
                        help="ecrire le theme sans regenerer l'initrd")
    args = parser.parse_args()

    if not SCREENS.is_file():
        print(f"  {SCREENS} absent : theme inchange")
        return 0
    if not THEME_DIR.is_dir():
        print(f"  {THEME_DIR} absent : theme PinCabOS non installe")
        return 0

    try:
        ecrans, rot = geometries()
    except (json.JSONDecodeError, OSError) as exc:
        print(f"  screens.json illisible ({exc}) : theme inchange")
        return 0

    if "playfield" not in ecrans:
        print("  role playfield absent de screens.json : theme inchange")
        return 0

    signature = hashlib.sha256(
        json.dumps({"ecrans": ecrans, "rot": rot}, sort_keys=True).encode()
    ).hexdigest()
    if not args.force and EMPREINTE.is_file() \
            and EMPREINTE.read_text(encoding="utf-8").strip() == signature:
        print("  configuration d'ecrans inchangee : rien a faire")
        return 0

    THEME.write_text(theme(ecrans, rot), encoding="utf-8")
    resume = ", ".join(f"{r} {w}x{h}+{x}+{y}" for r, (x, y, w, h) in ecrans.items())
    print(f"  theme ecrit : {resume}")
    print(f"  rotation appliquee au playfield seul : {rot}")

    if not args.no_initrd:
        regenerer_initrd()

    EMPREINTE.parent.mkdir(parents=True, exist_ok=True)
    EMPREINTE.write_text(signature + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3

from __future__ import annotations

import argparse
import os
import pwd
import grp
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path


TABLES_ROOT = Path("/home/pinball/Tables")

SOURCE_BASE = Path(
    "/home/pinball/NetworkDrives/192-168-254-253/"
    "vPinball - Copie/VisualPinball/VPinMAME"
)

SOURCE_ROMS = SOURCE_BASE / "roms"
SOURCE_ALTCOLOR = SOURCE_BASE / "altcolor"
SOURCE_ALTSOUND = SOURCE_BASE / "altsound"

LOG_ROOT = Path("/opt/pincabos/logs")

ROM_PATTERNS = [
    re.compile(
        r'(?i)\b(?:const\s+)?'
        r'(?:cgamename|gamename|romname)\s*=\s*"([^"]+)"'
    ),
    re.compile(
        r'(?i)\bcontroller\s*\.\s*gamename\s*=\s*"([^"]+)"'
    ),
]

VALID_ROM_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Détecte les ROM utilisées par les scripts VBS et copie les "
            "ROM, AltColor et AltSound manquants dans chaque dossier de table."
        )
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Affiche les opérations sans copier de fichiers.",
    )
    return parser.parse_args()


ARGS = parse_args()

LOG_ROOT.mkdir(parents=True, exist_ok=True)
timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
LOG_FILE = LOG_ROOT / f"table-rom-assets-sync-{timestamp}.log"
LOG_HANDLE = LOG_FILE.open("w", encoding="utf-8")


def log(message: str = "") -> None:
    print(message)
    LOG_HANDLE.write(message + "\n")
    LOG_HANDLE.flush()


def fail(message: str) -> None:
    log(f"ERREUR : {message}")
    LOG_HANDLE.close()
    sys.exit(1)


try:
    PINBALL_UID = pwd.getpwnam("pinball").pw_uid
    PINBALL_GID = grp.getgrnam("pinball").gr_gid
except KeyError:
    PINBALL_UID = -1
    PINBALL_GID = -1


def chown_pinball(path: Path) -> None:
    if ARGS.dry_run:
        return

    if PINBALL_UID < 0 or PINBALL_GID < 0:
        return

    try:
        os.chown(path, PINBALL_UID, PINBALL_GID)
    except (PermissionError, FileNotFoundError):
        pass


def ensure_directory(path: Path) -> None:
    if path.exists():
        return

    if ARGS.dry_run:
        return

    path.mkdir(parents=True, exist_ok=True)

    current = path
    while current != TABLES_ROOT.parent and current.exists():
        chown_pinball(current)

        if current == TABLES_ROOT:
            break

        current = current.parent


def read_vbs(path: Path) -> str:
    for encoding in ("utf-8-sig", "utf-8", "cp1252", "latin-1"):
        try:
            return path.read_text(encoding=encoding)
        except UnicodeDecodeError:
            continue
        except OSError as exc:
            log(f"  AVERTISSEMENT : lecture impossible : {path} : {exc}")
            return ""

    return ""


def strip_vb_comment(line: str) -> str:
    stripped = line.lstrip()

    if re.match(r"(?i)^rem(?:\s|$)", stripped):
        return ""

    in_string = False
    result: list[str] = []
    index = 0

    while index < len(line):
        char = line[index]

        if char == '"':
            if in_string and index + 1 < len(line) and line[index + 1] == '"':
                result.append('""')
                index += 2
                continue

            in_string = not in_string
            result.append(char)
            index += 1
            continue

        if char == "'" and not in_string:
            break

        result.append(char)
        index += 1

    return "".join(result)


def extract_rom_names(vbs_path: Path) -> set[str]:
    content = read_vbs(vbs_path)
    rom_names: set[str] = set()

    for original_line in content.splitlines():
        line = strip_vb_comment(original_line)

        for pattern in ROM_PATTERNS:
            for match in pattern.finditer(line):
                rom_name = match.group(1).strip()

                if not rom_name:
                    continue

                if not VALID_ROM_RE.fullmatch(rom_name):
                    log(
                        f"  AVERTISSEMENT : nom de ROM ignoré dans "
                        f"{vbs_path.name} : {rom_name!r}"
                    )
                    continue

                rom_names.add(rom_name)

    return rom_names


def build_source_index(root: Path) -> dict[str, Path]:
    index: dict[str, Path] = {}

    if not root.is_dir():
        return index

    try:
        for item in root.iterdir():
            index.setdefault(item.name.casefold(), item)

            if item.is_file():
                index.setdefault(item.stem.casefold(), item)
            else:
                index.setdefault(item.name.casefold(), item)
    except OSError as exc:
        log(f"AVERTISSEMENT : lecture impossible de {root} : {exc}")

    return index


def find_source_rom(rom_name: str, index: dict[str, Path]) -> Path | None:
    candidates = [
        f"{rom_name}.zip",
        f"{rom_name}.7z",
        f"{rom_name}.rar",
        rom_name,
    ]

    for candidate in candidates:
        found = index.get(candidate.casefold())
        if found is not None:
            return found

    return None


def find_source_asset(rom_name: str, index: dict[str, Path]) -> Path | None:
    candidates = [
        rom_name,
        f"{rom_name}.zip",
        f"{rom_name}.7z",
        f"{rom_name}.rar",
    ]

    for candidate in candidates:
        found = index.get(candidate.casefold())
        if found is not None:
            return found

    return None


def find_case_insensitive_child(parent: Path, name: str) -> Path | None:
    if not parent.is_dir():
        return None

    wanted = name.casefold()

    try:
        for child in parent.iterdir():
            if child.name.casefold() == wanted:
                return child
    except OSError:
        return None

    return None


def copy_file_missing(source: Path, destination: Path) -> tuple[int, int]:
    existing = find_case_insensitive_child(destination.parent, destination.name)

    if existing is not None:
        return 0, 1

    log(f"    COPIE : {source} -> {destination}")

    if ARGS.dry_run:
        return 1, 0

    ensure_directory(destination.parent)
    shutil.copy2(source, destination)
    chown_pinball(destination)

    return 1, 0


def merge_directory_missing(
    source: Path,
    destination: Path,
) -> tuple[int, int]:
    copied = 0
    skipped = 0

    if not ARGS.dry_run:
        ensure_directory(destination)

    for source_root, dir_names, file_names in os.walk(source):
        source_root_path = Path(source_root)
        relative = source_root_path.relative_to(source)
        destination_root = destination / relative

        if not ARGS.dry_run:
            ensure_directory(destination_root)
            chown_pinball(destination_root)

        for directory_name in dir_names:
            target_directory = destination_root / directory_name

            if not ARGS.dry_run:
                ensure_directory(target_directory)
                chown_pinball(target_directory)

        for file_name in file_names:
            source_file = source_root_path / file_name
            destination_file = destination_root / file_name

            found = find_case_insensitive_child(
                destination_root,
                file_name,
            )

            if found is not None:
                skipped += 1
                continue

            log(f"      COPIE : {source_file} -> {destination_file}")
            copied += 1

            if ARGS.dry_run:
                continue

            ensure_directory(destination_root)
            shutil.copy2(source_file, destination_file)
            chown_pinball(destination_file)

    return copied, skipped


def copy_asset(
    source: Path,
    destination_root: Path,
    rom_name: str,
) -> tuple[int, int]:
    if source.is_dir():
        existing_destination = find_case_insensitive_child(
            destination_root,
            rom_name,
        )

        destination = (
            existing_destination
            if existing_destination is not None
            else destination_root / rom_name
        )

        return merge_directory_missing(source, destination)

    destination = destination_root / source.name
    return copy_file_missing(source, destination)


def table_has_scripts(table_directory: Path) -> list[Path]:
    scripts: list[Path] = []

    try:
        for item in table_directory.rglob("*"):
            if item.is_file() and item.suffix.casefold() == ".vbs":
                scripts.append(item)
    except OSError as exc:
        log(
            f"  AVERTISSEMENT : exploration impossible de "
            f"{table_directory} : {exc}"
        )

    return sorted(scripts, key=lambda item: str(item).casefold())


def table_directories() -> list[Path]:
    try:
        return sorted(
            [
                item
                for item in TABLES_ROOT.iterdir()
                if item.is_dir()
            ],
            key=lambda item: item.name.casefold(),
        )
    except OSError as exc:
        fail(f"Impossible de lire {TABLES_ROOT} : {exc}")
        return []


def main() -> None:
    log("===============================================================")
    log(" PINCABOS — SYNCHRONISATION ROM / ALTCOLOR / ALTSOUND")
    log("===============================================================")
    log(f"Mode          : {'AUDIT SEULEMENT' if ARGS.dry_run else 'COPIE RÉELLE'}")
    log(f"Tables        : {TABLES_ROOT}")
    log(f"Source ROM    : {SOURCE_ROMS}")
    log(f"Source AltColor : {SOURCE_ALTCOLOR}")
    log(f"Source AltSound : {SOURCE_ALTSOUND}")
    log(f"Journal       : {LOG_FILE}")
    log("")

    if not TABLES_ROOT.is_dir():
        fail(f"Dossier de tables absent : {TABLES_ROOT}")

    missing_source_directories = [
        path
        for path in (SOURCE_ROMS, SOURCE_ALTCOLOR, SOURCE_ALTSOUND)
        if not path.is_dir()
    ]

    if missing_source_directories:
        for path in missing_source_directories:
            log(f"ERREUR : source absente ou non montée : {path}")

        fail("Le partage réseau ou certains dossiers sources sont absents.")

    log("Création des index des sources...")
    rom_index = build_source_index(SOURCE_ROMS)
    altcolor_index = build_source_index(SOURCE_ALTCOLOR)
    altsound_index = build_source_index(SOURCE_ALTSOUND)

    log(f"  ROM indexées      : {len(rom_index)}")
    log(f"  AltColor indexés  : {len(altcolor_index)}")
    log(f"  AltSound indexés  : {len(altsound_index)}")
    log("")

    stats = {
        "tables": 0,
        "tables_with_vbs": 0,
        "tables_without_vbs": 0,
        "rom_references": 0,
        "rom_copied": 0,
        "rom_missing_source": 0,
        "altcolor_copied": 0,
        "altcolor_missing_source": 0,
        "altsound_copied": 0,
        "altsound_missing_source": 0,
        "files_skipped": 0,
    }

    for table_directory in table_directories():
        stats["tables"] += 1

        log("---------------------------------------------------------------")
        log(f"TABLE : {table_directory.name}")

        vbs_files = table_has_scripts(table_directory)

        if not vbs_files:
            stats["tables_without_vbs"] += 1
            log("  À VÉRIFIER : aucun fichier .vbs détecté.")
            continue

        stats["tables_with_vbs"] += 1
        log(f"  Scripts VBS détectés : {len(vbs_files)}")

        rom_names: set[str] = set()

        for vbs_file in vbs_files:
            found_roms = extract_rom_names(vbs_file)

            if found_roms:
                relative = vbs_file.relative_to(table_directory)
                log(
                    f"  {relative} : "
                    + ", ".join(sorted(found_roms, key=str.casefold))
                )

            rom_names.update(found_roms)

        if not rom_names:
            log("  À VÉRIFIER : aucun nom de ROM littéral trouvé dans les VBS.")
            continue

        for rom_name in sorted(rom_names, key=str.casefold):
            stats["rom_references"] += 1
            log("")
            log(f"  ROM UTILISÉE : {rom_name}")

            destination_roms = table_directory / "roms"
            destination_altcolor = table_directory / "altcolor"
            destination_altsound = table_directory / "altsound"

            # ROM
            source_rom = find_source_rom(rom_name, rom_index)

            if source_rom is None:
                stats["rom_missing_source"] += 1
                log(f"    ROM SOURCE INTROUVABLE : {rom_name}")
            else:
                copied, skipped = copy_asset(
                    source_rom,
                    destination_roms,
                    rom_name,
                )
                stats["rom_copied"] += copied
                stats["files_skipped"] += skipped

                if copied == 0:
                    log("    ROM : déjà présente dans la table.")
                else:
                    log(f"    ROM : {copied} fichier copié.")

            # AltColor
            source_altcolor = find_source_asset(rom_name, altcolor_index)

            if source_altcolor is None:
                stats["altcolor_missing_source"] += 1
                log(f"    ALTCOLOR SOURCE INTROUVABLE : {rom_name}")
            else:
                copied, skipped = copy_asset(
                    source_altcolor,
                    destination_altcolor,
                    rom_name,
                )
                stats["altcolor_copied"] += copied
                stats["files_skipped"] += skipped

                if copied == 0:
                    log("    AltColor : déjà présent et complet selon la source.")
                else:
                    log(f"    AltColor : {copied} fichier(s) copié(s).")

            # AltSound
            source_altsound = find_source_asset(rom_name, altsound_index)

            if source_altsound is None:
                stats["altsound_missing_source"] += 1
                log(f"    ALTSOUND SOURCE INTROUVABLE : {rom_name}")
            else:
                copied, skipped = copy_asset(
                    source_altsound,
                    destination_altsound,
                    rom_name,
                )
                stats["altsound_copied"] += copied
                stats["files_skipped"] += skipped

                if copied == 0:
                    log("    AltSound : déjà présent et complet selon la source.")
                else:
                    log(f"    AltSound : {copied} fichier(s) copié(s).")

    log("")
    log("===============================================================")
    log(" RÉSUMÉ FINAL")
    log("===============================================================")
    log(f"Tables analysées                  : {stats['tables']}")
    log(f"Tables avec VBS                   : {stats['tables_with_vbs']}")
    log(f"Tables sans VBS                   : {stats['tables_without_vbs']}")
    log(f"Références de ROM détectées       : {stats['rom_references']}")
    log(f"Fichiers ROM copiés               : {stats['rom_copied']}")
    log(f"ROM absentes de la source         : {stats['rom_missing_source']}")
    log(f"Fichiers AltColor copiés          : {stats['altcolor_copied']}")
    log(f"AltColor absents de la source     : {stats['altcolor_missing_source']}")
    log(f"Fichiers AltSound copiés          : {stats['altsound_copied']}")
    log(f"AltSound absents de la source     : {stats['altsound_missing_source']}")
    log(f"Fichiers déjà présents/non écrasés: {stats['files_skipped']}")
    log("")
    log(f"Journal complet : {LOG_FILE}")
    log("===============================================================")


try:
    main()
finally:
    LOG_HANDLE.close()

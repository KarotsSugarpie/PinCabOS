#!/usr/bin/env bash
set -Eeuo pipefail

PROFILE="/home/pinball/.local/share/PinCabOS/lobby-av-chrome"
MARKER="/run/pincabos-lobby-av-backglass.active"
SCREENS="/opt/pincabos/config/screens/screens.json"
LOG="/opt/pincabos/logs/pincabos-lobby-av-backglass.log"
URL="http://127.0.0.1/pincabos-link/lobby-av"
EXTENSION="/opt/pincabos/web/lobby-av-browser-guard"
RUNTIME="/usr/local/sbin/pincabos-lobby-av-runtime"
WATCHDOG_PID="/run/pincabos-lobby-av-watchdog.pid"

die() {
    echo "ERROR"
    exit 1
}

status() {
    if pgrep -f -- "--user-data-dir=${PROFILE}" >/dev/null 2>&1; then
        echo "OPEN"
    else
        echo "CLOSED"
    fi
}

geometry() {
    python3 - "$SCREENS" <<'PY'
import json
import sys
from pathlib import Path

try:
    data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
    screen = data["backglass"]
    values = [int(screen[key]) for key in ("x", "y", "width", "height")]
except Exception:
    raise SystemExit(1)

x, y, width, height = values
if width < 640 or height < 360:
    raise SystemExit(1)
print(x, y, width, height)
PY
}

runtime_enter() {
    [[ -r "$RUNTIME" ]] || return 1
    [[ "$(bash "$RUNTIME" enter 2>/dev/null)" == "READY" ]]
}

runtime_leave() {
    [[ -r "$RUNTIME" ]] || return 0
    bash "$RUNTIME" leave >/dev/null 2>&1 || true
}

watch_window() {
    while pgrep -f -- "--user-data-dir=${PROFILE}" >/dev/null 2>&1; do
        sleep 1
    done
    rm -f "$MARKER"
    runtime_leave
    rm -f "$WATCHDOG_PID"
}

start_watchdog() {
    local old_pid=""

    if [[ -r "$WATCHDOG_PID" ]]; then
        old_pid="$(cat "$WATCHDOG_PID" 2>/dev/null || true)"
        if [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
            return 0
        fi
    fi

    watch_window >/dev/null 2>&1 &
    printf '%s\n' "$!" >"$WATCHDOG_PID"
}

fullscreen_window() {
    command -v wmctrl >/dev/null 2>&1 || return 0

    local window_id=""
    for attempt in {1..30}; do
        window_id="$(
            DISPLAY=:0 XAUTHORITY=/home/pinball/.Xauthority \
            wmctrl -lGx 2>/dev/null |
            awk '/PinCabOS Lobby Audio \/ Vidéo|pincabos-lobby-av-backglass/ {print $1; exit}'
        )"
        if [[ -n "$window_id" ]]; then
            DISPLAY=:0 XAUTHORITY=/home/pinball/.Xauthority \
                wmctrl -i -r "$window_id" -b add,fullscreen,above >/dev/null 2>&1 || true
            return 0
        fi
        sleep 0.15
    done
    return 0
}

close_window() {
    pkill -TERM -f -- "--user-data-dir=${PROFILE}" 2>/dev/null || true
    for attempt in {1..20}; do
        if ! pgrep -f -- "--user-data-dir=${PROFILE}" >/dev/null 2>&1; then
            break
        fi
        sleep 0.15
    done
    pkill -KILL -f -- "--user-data-dir=${PROFILE}" 2>/dev/null || true
    rm -f "$MARKER"
    runtime_leave
    echo "CLOSED"
}

open_window() {
    if ! runtime_enter; then
        die
    fi

    if pgrep -f -- "--user-data-dir=${PROFILE}" >/dev/null 2>&1; then
        touch "$MARKER"
        chmod 0644 "$MARKER" || true
        fullscreen_window
        start_watchdog
        echo "OPEN"
        return 0
    fi

    if ! read -r SCREEN_X SCREEN_Y SCREEN_W SCREEN_H < <(geometry); then
        runtime_leave
        die
    fi

    CHROME_BIN="$(
        command -v google-chrome \
        || command -v google-chrome-stable \
        || command -v chromium-browser \
        || command -v chromium \
        || true
    )"
    if [[ -z "$CHROME_BIN" ]]; then
        runtime_leave
        die
    fi
    if [[ ! -r "$EXTENSION/manifest.json" || ! -r "$EXTENSION/webrtc-guard.js" ]]; then
        runtime_leave
        die
    fi

    install -d -o pinball -g pinball -m 0700 "$PROFILE"
    install -d -o pinball -g pinball -m 0755 "$(dirname "$LOG")"
    touch "$MARKER"
    chmod 0644 "$MARKER"

    /usr/sbin/runuser -u pinball -- env \
        DISPLAY=:0 \
        XAUTHORITY=/home/pinball/.Xauthority \
        HOME=/home/pinball \
        XDG_RUNTIME_DIR=/run/user/1000 \
        nohup "$CHROME_BIN" \
        --app="$URL" \
        --kiosk \
        --start-fullscreen \
        --window-name=pincabos-lobby-av-backglass \
        --window-position="$SCREEN_X,$SCREEN_Y" \
        --window-size="$SCREEN_W,$SCREEN_H" \
        --user-data-dir="$PROFILE" \
        --load-extension="$EXTENSION" \
        --force-fieldtrials=WebRTC-SdpBundlePayloadTypeCollisionCheck/Disabled/ \
        --autoplay-policy=no-user-gesture-required \
        --use-fake-ui-for-media-stream \
        --no-first-run \
        --noerrdialogs \
        --disable-infobars \
        --disable-session-crashed-bubble \
        --disable-restore-session-state \
        --disable-background-networking \
        --disable-component-update \
        --disable-default-apps \
        --disable-background-timer-throttling \
        --disable-backgrounding-occluded-windows \
        --disable-renderer-backgrounding \
        --disable-features=CalculateNativeWindowOcclusion,PreloadMediaEngagementData \
        --ignore-gpu-blocklist \
        --no-sandbox \
        --disable-gpu-sandbox \
        --test-type \
        --log-level=3 \
        >>"$LOG" 2>&1 &

    for attempt in {1..40}; do
        if pgrep -f -- "--user-data-dir=${PROFILE}" >/dev/null 2>&1; then
            fullscreen_window
            start_watchdog
            echo "OPEN"
            return 0
        fi
        sleep 0.25
    done

    rm -f "$MARKER"
    runtime_leave
    die
}

[[ "$(id -u)" -eq 0 ]] || die

case "${1:-}" in
    open)
        [[ "$#" -eq 1 ]] || die
        open_window
        ;;
    close)
        [[ "$#" -eq 1 ]] || die
        close_window
        ;;
    status)
        [[ "$#" -eq 1 ]] || die
        status
        ;;
    geometry)
        [[ "$#" -eq 1 ]] || die
        geometry
        ;;
    *)
        die
        ;;
esac

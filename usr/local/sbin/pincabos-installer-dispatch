#!/usr/bin/env bash
# PINCABOS_INSTALLEUR_UN_SEUL_CHEMIN_V1
# Lanceur de l'assistant graphique depuis tty1 (modele ISO classique, ou
# GRUB force multi-user.target). Il n'y a plus d'installeur texte : si
# l'assistant ne s'affiche pas, la panne est annoncee en clair
# (pincabos-installer-failure), jamais masquee par un repli.
set -u

systemctl start pincabos-gui-wizard.service
# le wizard Flask doit repondre avant que le kiosque charge la page
for _ in $(seq 1 30); do
    curl -fs -o /dev/null http://127.0.0.1:8046/ && OK=1 && break
    sleep 1
done
if [ "${OK:-0}" = "1" ]; then
    systemctl start pincabos-gui-kiosk.service 2>/dev/null || true
    # le kiosque est relance par systemd en cas de chute (StartLimitBurst) :
    # on attend qu'il tienne 5 s d'affilee, ou que systemd le declare en panne.
    STABLE=0
    for _ in $(seq 1 60); do
        ETAT=$(systemctl is-active pincabos-gui-kiosk.service 2>/dev/null || true)
        case "$ETAT" in
            active) STABLE=$((STABLE + 1)); [ "$STABLE" -ge 5 ] && exit 0 ;;
            failed) break ;;
            *) STABLE=0 ;;
        esac
        sleep 1
    done
    echo "PinCabOS: le kiosque graphique ne tient pas." >&2
else
    echo "PinCabOS: le wizard ne repond pas sur 127.0.0.1:8046." >&2
fi
exec /usr/local/sbin/pincabos-installer-failure

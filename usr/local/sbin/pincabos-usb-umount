#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="/mnt/pincab-usb"

die() {
  echo "PINCABOS USB UMOUNT: $*" >&2
  exit 2
}

if [[ "${1:-}" == "--check" && "$#" -eq 1 ]]; then
  echo "GO: helper demontage USB accessible."
  exit 0
fi

[[ "$#" -eq 1 ]] || die "usage invalide"

ROOT_REAL="$(realpath -m -- "$ROOT")"
TARGET_REAL="$(realpath -m -- "$1")"

case "$TARGET_REAL" in
  "$ROOT_REAL"/*) ;;
  *) die "lecteur hors pincab-usb refuse" ;;
esac

[[ "$(dirname "$TARGET_REAL")" == "$ROOT_REAL" ]] \
  || die "seul un lecteur USB direct est autorise"

if ! mountpoint -q -- "$TARGET_REAL"; then
  echo "INFO: lecteur deja demonte: $TARGET_REAL"
  exit 0
fi

if /usr/bin/umount -- "$TARGET_REAL"; then
  echo "GO: lecteur USB demonte: $TARGET_REAL"
  exit 0
else
  RC=$?
  echo "ERREUR: impossible de demonter: $TARGET_REAL" >&2
  echo "Un fichier est probablement encore ouvert sur cette cle USB." >&2
  command -v fuser >/dev/null 2>&1 && fuser -vm "$TARGET_REAL" 2>&1 || true
  exit "$RC"
fi

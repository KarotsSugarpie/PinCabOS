#!/usr/bin/env python3

import json
import os
import pwd
import shutil
import sys
import time

from pathlib import Path


TABLES_ROOT = Path(
    "/home/pinball/Tables"
).resolve()

LEGACY_HELPER = Path(
    "/usr/local/sbin/"
    "pincabos-b2s-dmd-tuner-helper"
)

STATE_FILE = Path(
    "/run/pincabos-b2s-dmd-tuner/"
    "state.env"
)


def fail(message):

    print(
        message,
        file=sys.stderr,
    )

    raise SystemExit(1)


def read_env(path):

    values = {}

    try:
        text = path.read_text(
            encoding="utf-8",
            errors="ignore",
        )

    except OSError:
        return values


    for raw in text.splitlines():

        if "=" not in raw:
            continue

        key, value = raw.split(
            "=",
            1,
        )

        values[
            key.strip()
        ] = value.strip()


    return values


def read_process_env(pid):

    try:
        raw = Path(
            f"/proc/{pid}/environ"
        ).read_bytes()

    except OSError:
        return {}


    result = {}

    for item in raw.split(
        bytes([0])
    ):
        if b"=" not in item:
            continue

        key, value = item.split(
            b"=",
            1,
        )

        result[
            key.decode(
                errors="ignore"
            )
        ] = value.decode(
            errors="ignore"
        )


    return result


def rawscore_is_active():

    state = read_env(
        STATE_FILE
    )

    if (
        state.get(
            "BACKEND",
            "",
        ).strip().lower()
        != "rawscore"
    ):
        return False


    try:
        pid = int(
            state.get(
                "PID",
                "-1",
            )
        )

    except ValueError:
        return False


    if pid <= 0:
        return False


    env = read_process_env(
        pid
    )


    mode = env.get(
        "PINCABOS_GAME_CHOICE",
        "",
    ).strip().lower()


    return (
        env.get(
            "PINCABOS_PUP_ENABLED"
        ) == "1"
        or mode in (
            "pup",
            "puppack",
            "pup-pack",
        )
    )


def patch_rawscore(
    text,
    values,
):
    section = (
        "PinCabOS.RawScore"
    )

    lines = text.splitlines()

    start = None
    end = None


    for i, raw in enumerate(
        lines
    ):
        s = raw.strip()

        if (
            s.startswith("[")
            and s.endswith("]")
        ):
            name = (
                s[1:-1]
                .strip()
            )

            if (
                name.casefold()
                == section.casefold()
            ):
                start = i
                continue

            if start is not None:
                end = i
                break


    if start is None:

        if (
            lines
            and lines[-1].strip()
        ):
            lines.append("")

        lines.append(
            f"[{section}]"
        )

        for key, value in values.items():
            lines.append(
                f"{key} = {value}"
            )

        return (
            "\n".join(lines)
            +
            "\n"
        )


    if end is None:
        end = len(lines)


    existing = {}


    for i in range(
        start + 1,
        end,
    ):
        raw = lines[i].strip()

        if (
            not raw
            or raw.startswith(
                (";", "#")
            )
            or "=" not in raw
        ):
            continue

        key = (
            raw.split(
                "=",
                1,
            )[0]
            .strip()
            .casefold()
        )

        existing[key] = i


    additions = []


    for key, value in values.items():

        folded = key.casefold()

        if folded in existing:

            lines[
                existing[folded]
            ] = (
                f"{key} = {value}"
            )

        else:

            additions.append(
                f"{key} = {value}"
            )


    if additions:

        lines[
            end:end
        ] = additions


    return (
        "\n".join(lines)
        +
        "\n"
    )


if len(sys.argv) != 8:
    fail(
        "Usage: "
        "pincabos-dmd-bridge-helper "
        "save TABLE AUTO X Y W H"
    )


operation = sys.argv[1]

if operation != "save":
    fail(
        "Opération inconnue"
    )


table = Path(
    sys.argv[2]
).resolve()


try:
    table.relative_to(
        TABLES_ROOT
    )

except ValueError:
    fail(
        "Table hors de "
        "/home/pinball/Tables"
    )


if (
    table.suffix.casefold()
    != ".vpx"
):
    fail(
        "Table VPX invalide"
    )


#
# LEGACY :
# délégation intégrale au helper
# historique.
#
if not rawscore_is_active():

    os.execv(
        str(LEGACY_HELPER),
        [
            str(LEGACY_HELPER),
            *sys.argv[1:],
        ],
    )


auto = (
    1
    if int(
        sys.argv[3]
    )
    else 0
)

x = max(
    0,
    int(sys.argv[4]),
)

y = max(
    0,
    int(sys.argv[5]),
)

w = max(
    1,
    int(sys.argv[6]),
)

h = max(
    1,
    int(sys.argv[7]),
)


ini = table.with_suffix(
    ".ini"
)


if ini.exists():

    text = ini.read_text(
        encoding="utf-8",
        errors="ignore",
    )

else:

    text = ""


stamp = time.strftime(
    "%Y%m%d-%H%M%S"
)

backup_dir = Path(
    "/opt/pincabos/backups/"
    f"rawscore-layout-{stamp}-"
    f"{os.getpid()}"
)

backup_dir.mkdir(
    parents=True,
    exist_ok=True,
)


backup = None


if ini.exists():

    backup = (
        backup_dir /
        ini.name
    )

    shutil.copy2(
        ini,
        backup,
    )


text = patch_rawscore(
    text,
    {
        "Enable": "1",
        "Auto": str(auto),
        "X": str(x),
        "Y": str(y),
        "Width": str(w),
        "Height": str(h),
    },
)


temporary = ini.with_name(
    ini.name
    +
    f".tmp-{os.getpid()}"
)


temporary.write_text(
    text,
    encoding="utf-8",
)


if ini.exists():

    st = ini.stat()

    os.chown(
        temporary,
        st.st_uid,
        st.st_gid,
    )

    os.chmod(
        temporary,
        st.st_mode & 0o777,
    )

else:

    account = pwd.getpwnam(
        "pinball"
    )

    os.chown(
        temporary,
        account.pw_uid,
        account.pw_gid,
    )

    os.chmod(
        temporary,
        0o664,
    )


os.replace(
    temporary,
    ini,
)


print(
    json.dumps(
        {
            "backend": "rawscore",
            "ini": str(ini),
            "backup": (
                str(backup)
                if backup
                else None
            ),
        }
    )
)

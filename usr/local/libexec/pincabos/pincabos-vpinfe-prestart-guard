#!/usr/bin/env bash
set -u

# PINCABOS_PROFILE_GC_ASYNC_V1 : chemins et compte surchargeables pour les tests
TMP_ROOT="${PINCABOS_VPINFE_PROFILE_ROOT:-/var/tmp/pincabos-vpinfe}"
TMP_DIR="${PINCABOS_VPINFE_TMP:-/tmp}"
PINBALL_USER="${PINCABOS_PINBALL_USER:-pinball}"
PINBALL_UID="$(id -u "$PINBALL_USER" 2>/dev/null || echo 1000)"

gc_async() {
  # PINCABOS_PROFILE_GC_ASYNC_V1 : renommer (instantane, sort du motif
  # vpinfe_chromium_*) puis supprimer en arriere-plan, hors du cgroup du
  # service, en priorite E/S « idle ». PINCABOS_GC_SYNC=1 (tests, systeme
  # sans systemd-run) supprime en ligne.
  local dir="$1" rebut
  rebut="$(dirname -- "$dir")/.gc-$(basename -- "$dir")-$$-$RANDOM"
  mv -- "$dir" "$rebut" 2>/dev/null || rebut="$dir"
  if [ "${PINCABOS_GC_SYNC:-0}" = "1" ] || ! command -v systemd-run >/dev/null 2>&1; then
    rm -rf --one-file-system -- "$rebut"
    return 0
  fi
  systemd-run --quiet --collect --no-block \
    --unit="pincabos-vpinfe-gc-$(date +%s%N)-$RANDOM" \
    --nice=19 --property=IOSchedulingClass=idle \
    /bin/rm -rf --one-file-system -- "$rebut" >/dev/null 2>&1 \
    || rm -rf --one-file-system -- "$rebut"
}

echo "=== PinCabOS VPinFE Chrome prestart guard ==="

install -d \
  -o "$PINBALL_USER" \
  -g "$PINBALL_USER" \
  -m 0700 \
  "$TMP_ROOT"

find_vpinfe_chrome_pids() {
  # pgrep sur le nom exact plutot qu'un balayage bash de /proc (0,6 s au boot)
  local pid cmdline

  for pid in $(pgrep -U "$PINBALL_UID" -x 'chrome|google-chrome|chromium|chromium-browser' 2>/dev/null || true); do
    [ -r "/proc/$pid/cmdline" ] || continue
    cmdline="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null || true)"

    case "$cmdline" in
      *"--user-data-dir=${TMP_DIR}/vpinfe_chromium_"*|\
      *"--user-data-dir=${TMP_ROOT}/vpinfe_chromium_"*)
        printf '%s\n' "$pid"
        ;;
    esac
  done
}

mapfile -t stale_pids < <(find_vpinfe_chrome_pids)

if [ "${#stale_pids[@]}" -gt 0 ]; then
  echo "Stopping stale VPinFE Chrome processes: ${stale_pids[*]}"
  kill -TERM "${stale_pids[@]}" 2>/dev/null || true

  for attempt in $(seq 1 8); do
    remaining=()

    for pid in "${stale_pids[@]}"; do
      [ -d "/proc/$pid" ] && remaining+=("$pid")
    done

    [ "${#remaining[@]}" -eq 0 ] && break
    sleep 1
  done

  remaining=()

  for pid in "${stale_pids[@]}"; do
    [ -d "/proc/$pid" ] && remaining+=("$pid")
  done

  if [ "${#remaining[@]}" -gt 0 ]; then
    echo "Forcing stale VPinFE Chrome processes: ${remaining[*]}"
    kill -KILL "${remaining[@]}" 2>/dev/null || true
    sleep 1
  fi
fi

echo "Removing stale VPinFE temporary profiles"

shopt -s nullglob
for stale in "$TMP_DIR"/vpinfe_chromium_* "$TMP_ROOT"/vpinfe_chromium_*; do
  [ -d "$stale" ] && [ ! -L "$stale" ] || continue
  echo "$stale"
  gc_async "$stale"
done
shopt -u nullglob

CHROME_RUNNING=0
if pgrep -U "$PINBALL_UID" -x 'chrome|google-chrome|chromium|chromium-browser' >/dev/null 2>&1; then
  CHROME_RUNNING=1
fi

if [ "$CHROME_RUNNING" -eq 0 ] && \
   [ -d /home/pinball/.config/google-chrome ]; then

  echo "Removing stale Singleton locks from inactive Chrome profile"

  find /home/pinball/.config/google-chrome \
    -maxdepth 2 \
    \( \
      -name SingletonLock -o \
      -name SingletonCookie -o \
      -name SingletonSocket \
    \) \
    -print \
    -delete \
    2>/dev/null || true
fi

install -d \
  -o "$PINBALL_USER" \
  -g "$PINBALL_USER" \
  -m 0700 \
  "$TMP_ROOT"

echo "VPinFE Chrome prestart guard completed"
exit 0

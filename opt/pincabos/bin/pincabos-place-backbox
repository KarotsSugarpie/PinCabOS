#!/usr/bin/env bash
# PINCABOS_PLACE_BACKBOX_V1
#
# Place les deux surfaces de fronton de VPX sur les ecrans que screens.json
# leur destine. Sur un cabinet a deux ecrans, backglass et fulldmd designent
# la meme dalle : le service se retire et ne fait rien.
#
# Pourquoi c'est necessaire : la politique FullDMD a ete pensee pour un
# fronton d'un seul ecran. Elle laisse la fenetre "Visual Pinball Backglass"
# la ou VPX l'ouvre — au milieu du playfield — et le composite
# "Visual Pinball Score View" sur l'ecran du backglass, laissant le FullDMD
# noir. Les deux fenetres sont deplacables : leur taille est verrouillee par
# WM_NORMAL_HINTS, leur position ne l'est pas.
set -u

SCREENS=/opt/pincabos/config/screens/screens.json

export DISPLAY="${DISPLAY:-:0}"
for a in /home/pinball/.Xauthority /run/lightdm/root/:0; do
    [ -r "$a" ] && { export XAUTHORITY="$a"; break; }
done

geometrie() {  # $1 = role ; sort "x y largeur hauteur", vide si absent
    python3 - "$SCREENS" "$1" <<'PY' 2>/dev/null
import json, re, sys
try:
    data = json.loads(open(sys.argv[1], encoding="utf-8").read())
except Exception:
    raise SystemExit(0)
entry = data.get(sys.argv[2])
if not isinstance(entry, dict):
    raise SystemExit(0)
m = re.match(r"^(\d+)x(\d+)\+(-?\d+)\+(-?\d+)$", str(entry.get("geometry") or ""))
if m:
    largeur, hauteur, x, y = m.groups()
    print(x, y, largeur, hauteur)
PY
}

BACKGLASS="$(geometrie backglass)"
FULLDMD="$(geometrie fulldmd)"

if [ -z "$BACKGLASS" ] || [ -z "$FULLDMD" ] || [ "$BACKGLASS" = "$FULLDMD" ]; then
    echo "fronton a un seul ecran (ou roles absents) : rien a faire."
    exit 0
fi
echo "backglass: $BACKGLASS | fulldmd: $FULLDMD"

place() {  # $1 = fin du titre de fenetre, $2 = geometrie "x y l h"
    local titre="$1" geo="$2" ligne id x_actuel
    read -r x y largeur hauteur <<< "$geo"
    ligne="$(wmctrl -lGx 2>/dev/null | grep -E "$titre\$")" || return 0
    [ -n "$ligne" ] || return 0
    id="$(awk '{print $1}' <<< "$ligne")"
    x_actuel="$(awk '{print $3}' <<< "$ligne")"
    # deja en place : on s'abstient, pour ne jamais lutter avec le WM
    [ "$x_actuel" = "$x" ] && return 0
    wmctrl -i -r "$id" -e "0,$x,$y,$largeur,$hauteur" 2>/dev/null || true
    logger -t pincabos-place-backbox "$titre deplacee de $x_actuel vers $x"
}

plein_ecran() {  # $1 = fin du titre de fenetre, $2 = geometrie "x y l h"
    # Openbox ne decore pas une fenetre en plein ecran : c'est la facon
    # standard de retirer la barre de titre, la ou _MOTIF_WM_HINTS releve
    # d'une convention ancienne appliquee de facon inegale.
    local titre="$1" geo="$2" ligne id largeur hauteur l_cible h_cible
    read -r _ _ l_cible h_cible <<< "$geo"
    ligne="$(wmctrl -lGx 2>/dev/null | grep -E "$titre\$")" || return 0
    [ -n "$ligne" ] || return 0
    largeur="$(awk '{print $5}' <<< "$ligne")"
    hauteur="$(awk '{print $6}' <<< "$ligne")"
    # deja aux dimensions de l'ecran : rien a faire
    [ "$largeur" = "$l_cible" ] && [ "$hauteur" = "$h_cible" ] && return 0
    id="$(awk '{print $1}' <<< "$ligne")"
    wmctrl -i -r "$id" -b add,fullscreen 2>/dev/null || true
    logger -t pincabos-place-backbox "$titre passee en plein ecran"
}

while true; do
    if pgrep -u pinball -f VPinballX >/dev/null 2>&1; then
        place "Visual Pinball Score View" "$FULLDMD"
        place "Visual Pinball Backglass"  "$BACKGLASS"
    fi
    # dans le menu comme en jeu : la fenetre DMD de VPinFE doit remplir son
    # ecran, faute de quoi son cadre reste visible sur le fronton
    plein_ecran "VPinFE DMD" "$FULLDMD"
    sleep 2
done

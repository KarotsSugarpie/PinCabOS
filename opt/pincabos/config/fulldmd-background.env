# PINCABOS — FullDMD background global defaults.
# Les tables FullDMD peuvent ensuite recevoir un profil individuel
# dans /opt/pincabos/config/fulldmd-layouts/

PINCABOS_FULLDMD_ENABLE=1

# DMD animé ScoreView par-dessus l'image FullDMD.
PINCABOS_FULLDMD_DMD_W=1420
PINCABOS_FULLDMD_DMD_H=355
PINCABOS_FULLDMD_DMD_Y=718

# Laisser vide pour centrer horizontalement.
PINCABOS_FULLDMD_DMD_X=

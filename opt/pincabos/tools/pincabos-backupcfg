#!/usr/bin/env python3
"""Privileged PinCabOS HotFiles backup and restore helper.

The WebApp may only select an action, a random job id and a timestamp. Every
filesystem path is fixed here so sudo cannot be used as an arbitrary archiver.
"""
from __future__ import annotations

import hashlib
import json
import os
import pwd
import re
import shutil
import socket
import stat
import sys
import time
import zipfile
import posixpath
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath

FORMAT = "pincabos.config-backup/v1"
MANIFEST_NAME = "pincabos-backupcfg-manifest.json"
WORK_ROOT = Path("/var/tmp/pincabos-backupcfg")
LOCAL_DIR = Path("/home/pinball/usersettings")
LOCAL_ARCHIVE = LOCAL_DIR / "UserSettings.PCOSCFG"
LOG_ROOT = Path("/opt/pincabos/logs")
MAX_ARCHIVE_BYTES = 2 * 1024 * 1024 * 1024
MAX_ENTRY_COUNT = 100_000
JOB_RE = re.compile(r"^[a-f0-9]{32}$")
STAMP_RE = re.compile(r"^[0-9]{8}-[0-9]{6}$")
ARCHIVE_RE = re.compile(r"^UserSettings-[0-9]{8}-[0-9]{6}\.PCOSCFG$")

# Normalized version of the HotFiles list supplied for PR #172. Redundant
# children are intentionally omitted when their complete parent is included.
SELECTORS = (
    "opt/pincabos/config/screens",
    "opt/pincabos/config/display-aliases.env",
    "opt/pincabos/state/screens-apply-last-success.flag",
    "etc/X11/xorg.conf",
    "etc/X11/xorg.conf.d",
    "home/pinball/.config/monitors.xml",
    "opt/pincabos/config/splash.json",
    "var/lib/pincabos/hardware-autoconfig.done",
    "home/pinball/.config/vpinfe/vpinfe.ini",
    "home/pinball/.config/vpinfe/vpsdb.json",
    "home/pinball/.config/vpinfe/roms.json",
    "home/pinball/.config/vpinfe/collections.ini",
    "home/pinball/.pincabos/vpx/VPinballX.ini",
    "home/pinball/.local/share/VPinballX/10.8/VPinballX.ini",
    "home/pinball/.vpinball/VPinballX.ini",
    "home/pinball/.local/share/VPinballX/10.8/directoutputconfig",
    "opt/pincabos/config/audio-router.json",
    "opt/pincabos/config/audio.json",
    "opt/pincabos/config/audio-ssf.json",
    "opt/pincabos/config/audio/surround.json",
    "opt/pincabos/config/ssf-commander.json",
    "opt/pincabos/config/dof",
    "opt/pincabos/config/dudescab",
    "opt/pincabos/config/inputs-commander.json",
    "opt/pincabos/config/dmd-calibration.json",
    "opt/pincabos/config/fulldmd-calibration.json",
    "opt/pincabos/config/fulldmd-background.env",
    "opt/pincabos/config/zedmd.json",
    "opt/pincabos/config/fulldmd-style.conf",
    "etc/netplan",
    "etc/NetworkManager/system-connections",
    "var/lib/NetworkManager",
    "etc/pincabos/system-name.conf",
    "etc/ssh",
    "etc/machine-id",
    "home/pinball/.ssh",
    "opt/pincabos/config/admin-login.txt",
    "opt/pincabos/config/admin-password.txt",
    "opt/pincabos/config/dev-login.txt",
    "opt/pincabos/config/dev-password.txt",
    "opt/pincabos/config/webserver-webpass.secret",

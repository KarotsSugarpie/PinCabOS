  mktemp "$TMP_ROOT/pincabos-vpinfe-xrandr.XXXXXX"
)" || exit 0

trap 'rm -f "$XRANDR_TMP"' EXIT

[ -f "$INI" ] || exit 0
[ -f "$SCREENS" ] || exit 0


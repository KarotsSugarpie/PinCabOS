  printf '%b\n' "${YELLOW}WARN [!]${NC} $*"
}

pco_info() {
  printf '%b\n' "${BLUE}INFO${NC} $*"
}

pco_error() {
  printf '%b\n' "${RED}NOGO [***]${NC} $*" >&2
}

pco_prompt() {
  local prompt="$1"

  printf '%b%s%b ' \
    "${BOLD}${WHITE}" \
    "$prompt" \
    "${NC}" >&2
}


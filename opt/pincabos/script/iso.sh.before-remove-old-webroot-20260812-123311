  printf '\n'
}

pco_title() {
  if [ -t 1 ]; then
    printf '\033c'
  elif command -v clear >/dev/null 2>&1; then
    clear 2>/dev/null || true
  fi

  pco_logo

  printf '%b\n' \
    "${CYAN}${BOLD}              PINCABOS LIVE SYSTEM INSTALLER${NC}"

  printf '%b\n\n' \
    "${DIM}Installation automatique de PinCabOS sur disque${NC}"
}

pco_step() {
  local label="${2:-$1}"

  printf '\n%b\n' \
    "${CYAN}─► ${BOLD}${label}${NC}${CYAN} ◄────────────────────────────────────────${NC}"
}

pco_go() {
  printf '%b\n' "${GREEN}GO [√]${NC} $*"
}

# PINCABOS_LIVE_INSTALLER_GREEN_GO_V1


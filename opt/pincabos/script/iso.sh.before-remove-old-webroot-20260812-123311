#!/usr/bin/env bash
set -u

INI="/home/pinball/.config/vpinfe/vpinfe.ini"
SCREENS="/opt/pincabos/config/screens/screens.json"
# PINCABOS_VPINFE_SANITIZER_TMP_FALLBACK_V2

echo "PinCabOS installation media ready."
echo

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -E "$0" "$@"
fi

PAYLOAD_DIR="/cdrom/pincabos-payload"
TARGET="/target"
MIN_FREE_MIB="${PINCABOS_DUALBOOT_MIN_FREE_MIB:-32768}"


# ==============================================================
# PINCABOS_INSTALLER_REGIONAL_SETUP_V2_ALL_REGIONS
#
# Tous les choix sont obtenus dynamiquement depuis Ubuntu/XKB.
# Aucun pays, clavier ou timezone n'est limité à une liste codée en dur.
#

REG_LOCALE="fr_CA.UTF-8"
REG_LANGUAGE="fr_CA:fr"
REG_LOCALE_LABEL="fr_CA.UTF-8"

REG_XKB_LAYOUT="ca"
REG_XKB_VARIANT=""
REG_KEYBOARD_LABEL="ca"

REG_TIMEZONE="America/Montreal"
REG_FBROTATE=0
REG_ORIENT_LABEL="Landscape (no rotation)"
# PINCABOS_ORIENTATION_INSTALLER_V1

PCO_SELECTED=""
PCO_SELECTED_LABEL=""

pco_choose_list() {
    local title="$1"
    local source_file="$2"

    local PAGE_SIZE=20
    local PAGE=0
    local FILTER=""
    local CHOICE=""
    local SEARCH=""
    local TMP_FILTER=""

    while true; do
        TMP_FILTER="$(mktemp)"

        if [ -n "$FILTER" ]; then
            grep -iF -- "$FILTER" "$source_file" \
                > "$TMP_FILTER" || true
        else
            cat "$source_file" > "$TMP_FILTER"
        fi

        mapfile -t PCO_ITEMS < "$TMP_FILTER"
        rm -f "$TMP_FILTER"

        local TOTAL="${#PCO_ITEMS[@]}"

        if [ "$TOTAL" -eq 0 ]; then
            echo
            pco_warn "No entry matches: $FILTER"
            FILTER=""
            PAGE=0
            continue
        fi

        local PAGES=$(( (TOTAL + PAGE_SIZE - 1) / PAGE_SIZE ))

        [ "$PAGE" -lt "$PAGES" ] || PAGE=$((PAGES - 1))
        [ "$PAGE" -ge 0 ] || PAGE=0

        local START=$((PAGE * PAGE_SIZE))
        local END=$((START + PAGE_SIZE))

        [ "$END" -le "$TOTAL" ] || END="$TOTAL"

        echo
        pco_hr
        echo " $title"
        pco_hr
        echo
        echo " Entries : $TOTAL"
        echo " Page    : $((PAGE + 1)) / $PAGES"

        if [ -n "$FILTER" ]; then
            echo " Filter  : $FILTER"
        fi

        echo

        local IDX
        local NUM=1

        for ((IDX=START; IDX<END; IDX++)); do
            local LINE="${PCO_ITEMS[$IDX]}"
            local VALUE="${LINE%%|*}"
            local LABEL="${LINE#*|}"

            printf "  [%2d] %-22s %s\n" \
                "$NUM" \
                "$VALUE" \
                "$LABEL"

            NUM=$((NUM + 1))
        done

        echo
        echo "  n = next page"
        echo "  p = previous page"
        echo "  s = search/filter"
        echo "  c = clear search"
        echo

        pco_prompt "Choice: "
        read -r CHOICE

        case "$CHOICE" in
            n|N)
                if [ "$((PAGE + 1))" -lt "$PAGES" ]; then
                    PAGE=$((PAGE + 1))
                fi
                ;;

            p|P)
                if [ "$PAGE" -gt 0 ]; then
                    PAGE=$((PAGE - 1))
                fi
                ;;

            s|S)
                echo
                pco_prompt "Search: "
                read -r SEARCH
                FILTER="$SEARCH"
                PAGE=0
                ;;

            c|C)
                FILTER=""
                PAGE=0
                ;;

            *)
                if [[ "$CHOICE" =~ ^[0-9]+$ ]]; then
                    local LOCAL_INDEX=$((CHOICE - 1))

                    if [ "$LOCAL_INDEX" -ge 0 ] &&
                       [ "$LOCAL_INDEX" -lt "$((END - START))" ]; then

                        local ABS_INDEX=$((START + LOCAL_INDEX))
                        local SELECTED="${PCO_ITEMS[$ABS_INDEX]}"

                        PCO_SELECTED="${SELECTED%%|*}"
                        PCO_SELECTED_LABEL="${SELECTED#*|}"

                        return 0
                    fi
                fi

                pco_warn "Invalid choice."
                ;;
        esac
    done
}

pco_build_locale_catalog() {
    local OUT="$1"

    : > "$OUT"

    if [ -f /usr/share/i18n/SUPPORTED ]; then
        awk '
            $2 == "UTF-8" {
                print $1 "|" $1
            }
        ' /usr/share/i18n/SUPPORTED \
            | sort -u \
            > "$OUT"
    fi

    if [ ! -s "$OUT" ]; then
        locale -a 2>/dev/null \
            | grep -Ei 'utf[-]?8' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    #
    # Garantir les principales locales même si l'image Live
    # expose une liste incomplète.
    #
    for LOC in \
        fr_CA.UTF-8 \
        en_CA.UTF-8 \
        en_US.UTF-8 \
        fr_FR.UTF-8
    do
        grep -q "^${LOC}|" "$OUT" 2>/dev/null ||
            printf '%s|%s\n' "$LOC" "$LOC" >> "$OUT"
    done

    sort -u -o "$OUT" "$OUT"
}

pco_build_keyboard_catalog() {
    local OUT="$1"

    : > "$OUT"

    local RULES=""

    for CANDIDATE in \
        /usr/share/X11/xkb/rules/base.lst \
        /usr/share/X11/xkb/rules/evdev.lst
    do
        if [ -f "$CANDIDATE" ]; then
            RULES="$CANDIDATE"
            break
        fi
    done

    if [ -n "$RULES" ]; then
        awk '
            /^! layout/ {
                active=1
                next
            }

            /^!/ {
                if (active) exit
            }

            active && NF {
                code=$1
                $1=""
                sub(/^[[:space:]]+/, "", $0)
                print code "|" $0
            }
        ' "$RULES" \
            | sort -u \
            > "$OUT"
    fi

    if [ ! -s "$OUT" ] &&
       command -v localectl >/dev/null 2>&1; then

        localectl list-x11-keymap-layouts \
            --no-pager 2>/dev/null \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    [ -s "$OUT" ] || {
        printf '%s\n' \
            'us|English (US)' \
            'ca|Canada' \
            'fr|France' \
            'gb|United Kingdom' \
            > "$OUT"
    }
}

pco_build_keyboard_variant_catalog() {
    local LAYOUT="$1"
    local OUT="$2"

    : > "$OUT"

    #
    # Option par défaut toujours disponible.
    #
    echo '|Default / no variant' > "$OUT"

    if command -v localectl >/dev/null 2>&1; then
        localectl list-x11-keymap-variants \
            "$LAYOUT" \
            --no-pager 2>/dev/null \
            | grep -v '^$' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            >> "$OUT" || true
    fi

    #
    # Fallback base.lst / evdev.lst.
    #
    if [ "$(wc -l < "$OUT")" -le 1 ]; then
        local RULES=""

        for CANDIDATE in \
            /usr/share/X11/xkb/rules/base.lst \
            /usr/share/X11/xkb/rules/evdev.lst
        do
            if [ -f "$CANDIDATE" ]; then
                RULES="$CANDIDATE"
                break
            fi
        done

        if [ -n "$RULES" ]; then
            awk -v wanted="$LAYOUT" '
                /^! variant/ {
                    active=1
                    next
                }

                /^!/ {
                    if (active) exit
                }

                active && NF {
                    variant=$1

                    line=$0

                    if (
                        line ~ ("[[:space:]]" wanted ":") ||
                        line ~ ("^" variant "[[:space:]]+" wanted ":")
                    ) {
                        desc=line
                        sub(/^[^[:space:]]+[[:space:]]+/, "", desc)
                        print variant "|" desc
                    }
                }
            ' "$RULES" \
                | sort -u \
                >> "$OUT" || true
        fi
    fi

    sort -u -o "$OUT" "$OUT"
}

pco_build_timezone_catalog() {
    local OUT="$1"

    : > "$OUT"

    if command -v timedatectl >/dev/null 2>&1; then
        timedatectl list-timezones \
            --no-pager 2>/dev/null \
            | grep '/' \
            | sort -u \
            | awk '{print $0 "|" $0}' \
            > "$OUT" || true
    fi

    if [ ! -s "$OUT" ] &&
       [ -f /usr/share/zoneinfo/zone.tab ]; then

        awk '
            !/^#/ && NF >= 3 {
                print $3 "|" $3
            }
        ' /usr/share/zoneinfo/zone.tab \
            | sort -u \
            > "$OUT"
    fi

    grep -q '^UTC|' "$OUT" 2>/dev/null ||
        echo 'UTC|UTC' >> "$OUT"

    sort -u -o "$OUT" "$OUT"
}

apply_live_keyboard() {
    echo
    pco_step "Applying keyboard to live installer"

    mkdir -p /etc/default

    cat > /etc/default/keyboard <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$REG_XKB_LAYOUT"
XKBVARIANT="$REG_XKB_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF

    if command -v setupcon >/dev/null 2>&1; then
        if setupcon --keyboard-only >/dev/null 2>&1; then
            pco_go "Live keyboard applied: $REG_KEYBOARD_LABEL"
            return 0
        fi
    fi

    if command -v ckbcomp >/dev/null 2>&1 &&
       command -v loadkeys >/dev/null 2>&1; then

        if [ -n "$REG_XKB_VARIANT" ]; then
            if ckbcomp \
                "$REG_XKB_LAYOUT" \
                "$REG_XKB_VARIANT" \
                2>/dev/null \
                | loadkeys >/dev/null 2>&1; then

                pco_go "Live keyboard applied"
                return 0
            fi
        else
            if ckbcomp \
                "$REG_XKB_LAYOUT" \
                2>/dev/null \
                | loadkeys >/dev/null 2>&1; then

                pco_go "Live keyboard applied"
                return 0
            fi
        fi
    fi

    pco_warn "Live keyboard could not be changed."
    echo "The selected keyboard will still be installed on the target."
}

regional_setup() {
    local LOCALES
    local KEYBOARDS
    local VARIANTS
    local TIMEZONES
    local BASE_LOCALE
    local LANG_CODE
    local CHOICE

    LOCALES="$(mktemp)"
    KEYBOARDS="$(mktemp)"
    VARIANTS="$(mktemp)"
    TIMEZONES="$(mktemp)"

    pco_build_locale_catalog "$LOCALES"
    pco_build_keyboard_catalog "$KEYBOARDS"
    pco_build_timezone_catalog "$TIMEZONES"

    while true; do

        echo
        pco_hr
        echo " PinCabOS Regional Setup — ALL REGIONS"
        pco_hr
        echo
        echo "All available UTF-8 locales, XKB keyboard layouts"
        echo "and timezones can be selected."
        echo
        echo "TIP: use 's' in a list to search."
        echo
        echo "Examples:"
        echo "  Locale   search: fr_CA"
        echo "  Keyboard search: Canada"
        echo "  Timezone search: Montreal"
        echo

        #
        # Locale / Region
        #
        pco_choose_list \
            "Language / Region — all UTF-8 locales" \
            "$LOCALES"

        REG_LOCALE="$PCO_SELECTED"
        REG_LOCALE_LABEL="$PCO_SELECTED_LABEL"

        BASE_LOCALE="${REG_LOCALE%%.*}"
        LANG_CODE="${BASE_LOCALE%%_*}"

        REG_LANGUAGE="${BASE_LOCALE}:${LANG_CODE}"

        #
        # Keyboard layout
        #
        pco_choose_list \
            "Keyboard layout — all XKB layouts" \
            "$KEYBOARDS"

        REG_XKB_LAYOUT="$PCO_SELECTED"
        REG_KEYBOARD_LABEL="$PCO_SELECTED_LABEL"

        #
        # Keyboard variant
        #
        pco_build_keyboard_variant_catalog \
            "$REG_XKB_LAYOUT" \
            "$VARIANTS"

        pco_choose_list \
            "Keyboard variant — $REG_XKB_LAYOUT" \
            "$VARIANTS"

        REG_XKB_VARIANT="$PCO_SELECTED"

        if [ -n "$PCO_SELECTED_LABEL" ] &&
           [ "$PCO_SELECTED_LABEL" != "Default / no variant" ]; then

            REG_KEYBOARD_LABEL="$REG_KEYBOARD_LABEL / $PCO_SELECTED_LABEL"
        fi

        #
        # Change keyboard immediately.
        #
        apply_live_keyboard

        #
        # Timezone — all regions.
        #
        pco_choose_list \
            "Timezone — all regions" \
            "$TIMEZONES"

        REG_TIMEZONE="$PCO_SELECTED"

        # Screen orientation for cabinet display / boot splash.
        echo
        pco_hr
        echo " Screen orientation"
        pco_hr
        echo
        echo "  [1] Landscape (no rotation)"
        echo "  [2] Portrait — 90 degrees clockwise"
        echo "  [3] Portrait — 90 degrees counter-clockwise"
        echo "  [4] Upside down — 180 degrees"
        echo

        while true; do
            pco_prompt "Choice: "
            read -r CHOICE
            case "$CHOICE" in
                1) REG_FBROTATE=0; REG_ORIENT_LABEL="Landscape"; break ;;
                2) REG_FBROTATE=1; REG_ORIENT_LABEL="Portrait 90 clockwise"; break ;;
                3) REG_FBROTATE=3; REG_ORIENT_LABEL="Portrait 90 counter-clockwise"; break ;;
                4) REG_FBROTATE=2; REG_ORIENT_LABEL="Upside down 180"; break ;;
                *) pco_warn "Invalid choice." ;;
            esac
        done

        echo
        pco_hr
        echo " Regional configuration"
        pco_hr
        echo
        echo " Language : $REG_LOCALE_LABEL"
        echo " Locale   : $REG_LOCALE"
        echo " Keyboard : $REG_KEYBOARD_LABEL"
        echo " XKB      : $REG_XKB_LAYOUT ${REG_XKB_VARIANT:-}"
        echo " Timezone : $REG_TIMEZONE"
        echo " Screen   : $REG_ORIENT_LABEL"
        echo
        echo "  [1] Continue"
        echo "  [2] Change"
        echo

        pco_prompt "Choice: "
        read -r CHOICE

        case "$CHOICE" in
            1)
                pco_go "Regional configuration accepted"
                break
                ;;

            2)
                continue
                ;;

            *)
                pco_warn "Invalid choice."
                ;;
        esac
    done

    rm -f \
        "$LOCALES" \
        "$KEYBOARDS" \
        "$VARIANTS" \
        "$TIMEZONES"
}


apply_target_orientation() {
    echo
    pco_step "Applying screen orientation to installed PinCabOS"

    local N="${REG_FBROTATE:-0}"
    local GRUBF="$TARGET/etc/default/grub"

    case "$N" in
        0|1|2|3) ;;
        *) pco_error "Invalid fbcon rotation value: $N"; return 1 ;;
    esac

    # 1) Console/kernel rotation. Remove any previous value first.
    if [ -f "$GRUBF" ]; then
        sed -i -E 's/[[:space:]]*fbcon=rotate:[0-3]//g' "$GRUBF"

        if [ "$N" != "0" ]; then
            if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$GRUBF"; then
                sed -i -E \
                    "s/^(GRUB_CMDLINE_LINUX_DEFAULT=\")(.*)(\")[[:space:]]*$/\\1\\2 fbcon=rotate:$N\\3/" \
                    "$GRUBF"
            else
                printf 'GRUB_CMDLINE_LINUX_DEFAULT="fbcon=rotate:%s"\n' "$N" >> "$GRUBF"
            fi
        fi
    else
        pco_warn "target /etc/default/grub missing — console rotation skipped"
    fi

    # 2) Rotation-aware PinCabOS Plymouth splash.
    local THEME="$TARGET/usr/share/plymouth/themes/pincabos/pincabos.script"
    if [ -f "$THEME" ] && [ "$N" != "0" ]; then
        local DEG=0
        [ "$N" = "1" ] && DEG=90
        [ "$N" = "2" ] && DEG=180
        [ "$N" = "3" ] && DEG=270

        [ -f "$THEME.pcosorig" ] || cp "$THEME" "$THEME.pcosorig"

        cat > "$THEME" <<'PLYSCRIPT'
# PINCABOS rotation-aware splash (generated by installer)
rot = __ROT_DEG__;
sw = Window.GetWidth();
sh = Window.GetHeight();
PI = 3.14159265358979;
rad = rot * PI / 180;
if (rot == 90 || rot == 270) { lw = sh; lh = sw; } else { lw = sw; lh = sh; }

bg = Image("pincabos.png").Scale(lw, lh);
if (rot != 0) bg = bg.Rotate(rad);
bgs = Sprite(bg);
bgs.SetX((sw - bg.GetWidth()) / 2);
bgs.SetY((sh - bg.GetHeight()) / 2);
bgs.SetZ(-100);

bar_width = lw * 0.193;
bar_height = 6;
bar_lx = (lw - bar_width) / 2;
bar_ly = lh * 0.728;
bcx = bar_lx + bar_width / 2;
bcy = bar_ly + bar_height / 2;

if (rot == 0)   { pcx = bcx;      pcy = bcy;      }
if (rot == 180) { pcx = sw - bcx; pcy = sh - bcy; }
if (rot == 90)  { pcx = sw - bcy; pcy = bcx;      }
if (rot == 270) { pcx = bcy;      pcy = sh - bcx; }

box_img = Image("progress_box.png").Scale(bar_width, bar_height);
if (rot != 0) box_img = box_img.Rotate(rad);
box_sprite = Sprite(box_img);
box_sprite.SetX(pcx - box_img.GetWidth() / 2);
box_sprite.SetY(pcy - box_img.GetHeight() / 2);
box_sprite.SetZ(10);

bar_img0 = Image("progress_bar.png");
bar_sprite = Sprite();
bar_sprite.SetZ(11);

fun boot_progress_callback(duration, progress) {
    if (progress < 0) progress = 0;
    if (progress > 1) progress = 1;
    cw = bar_width * progress;
    if (cw < 1) cw = 1;
    img = bar_img0.Scale(cw, bar_height);
    if (rot != 0) img = img.Rotate(rad);
    bar_sprite.SetImage(img);
    bar_sprite.SetX(pcx - img.GetWidth() / 2);
    bar_sprite.SetY(pcy - img.GetHeight() / 2);
}
Plymouth.SetBootProgressFunction(boot_progress_callback);
PLYSCRIPT
        sed -i "s/__ROT_DEG__/$DEG/" "$THEME"
        pco_go "Plymouth splash rotated: $DEG degrees"
    fi

    # 3) Persistent PinCabOS record.
    mkdir -p "$TARGET/etc/pincabos"
    printf 'PINCABOS_FBCON_ROTATE="%s"\nPINCABOS_ORIENT_LABEL="%s"\n' \
        "$N" "${REG_ORIENT_LABEL:-Landscape}" \
        > "$TARGET/etc/pincabos/orientation.conf"
    chmod 0644 "$TARGET/etc/pincabos/orientation.conf"

    pco_go "Orientation installed: ${REG_ORIENT_LABEL:-Landscape}"
}

apply_target_regional() {
    echo
    pco_step "Applying regional settings to installed PinCabOS"

    [ -d "$TARGET/etc" ] || {
        pco_error "target /etc missing"
        return 1
    }

    mkdir -p \
        "$TARGET/etc/default" \
        "$TARGET/etc/pincabos"

    #
    # Keyboard
    #
    cat > "$TARGET/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$REG_XKB_LAYOUT"
XKBVARIANT="$REG_XKB_VARIANT"
XKBOPTIONS=""
BACKSPACE="guess"
EOF

    #
    # Locale
    #
    cat > "$TARGET/etc/default/locale" <<EOF
LANG=$REG_LOCALE
LANGUAGE=$REG_LANGUAGE
EOF

    cat > "$TARGET/etc/locale.conf" <<EOF
LANG=$REG_LOCALE
LANGUAGE=$REG_LANGUAGE
EOF

    touch "$TARGET/etc/locale.gen"

    #
    # Ensure exactly the selected locale is enabled.
    #
    if grep -Eq \
        "^[#[:space:]]*${REG_LOCALE}[[:space:]]+UTF-8" \
        "$TARGET/etc/locale.gen"; then

        sed -i -E \
            "s|^[#[:space:]]*(${REG_LOCALE}[[:space:]]+UTF-8).*$|\1|" \
            "$TARGET/etc/locale.gen"
    else
        printf '%s UTF-8\n' "$REG_LOCALE" \
            >> "$TARGET/etc/locale.gen"
    fi

    if [ -x "$TARGET/usr/sbin/locale-gen" ]; then
        chroot "$TARGET" /usr/sbin/locale-gen "$REG_LOCALE" || {
            pco_warn "locale-gen returned an error."
        }
    else
        pco_warn "locale-gen not present in installed target."
    fi

    if [ -x "$TARGET/usr/sbin/update-locale" ]; then
        chroot "$TARGET" /usr/sbin/update-locale \
            "LANG=$REG_LOCALE" \
            "LANGUAGE=$REG_LANGUAGE" || true
    fi

    #
    # Timezone
    #
    if [ ! -e "$TARGET/usr/share/zoneinfo/$REG_TIMEZONE" ]; then
        pco_error "Timezone unavailable in target: $REG_TIMEZONE"
        return 1
    fi

    ln -sfn \
        "/usr/share/zoneinfo/$REG_TIMEZONE" \
        "$TARGET/etc/localtime"

    printf '%s\n' "$REG_TIMEZONE" \
        > "$TARGET/etc/timezone"

    #
    # PinCabOS persistent record.
    #
    cat > "$TARGET/etc/pincabos/regional.conf" <<EOF
PINCABOS_LOCALE="$REG_LOCALE"
PINCABOS_LANGUAGE="$REG_LANGUAGE"
PINCABOS_KEYBOARD_LAYOUT="$REG_XKB_LAYOUT"
PINCABOS_KEYBOARD_VARIANT="$REG_XKB_VARIANT"
PINCABOS_TIMEZONE="$REG_TIMEZONE"
EOF

    chmod 644 \
        "$TARGET/etc/default/keyboard" \
        "$TARGET/etc/default/locale" \
        "$TARGET/etc/locale.conf" \
        "$TARGET/etc/timezone" \
        "$TARGET/etc/pincabos/regional.conf"

    echo
    pco_go "Regional settings installed"
    echo " Locale   : $REG_LOCALE"
    echo " Keyboard : $REG_XKB_LAYOUT ${REG_XKB_VARIANT:-}"
    echo " Timezone : $REG_TIMEZONE"
}


check_payload() {
  pco_step "Live media payload check"

  test -d "$PAYLOAD_DIR" || {
    pco_error "payload directory not found: $PAYLOAD_DIR"
    ls -lah /cdrom 2>/dev/null || true
    exit 1
  }

  test -x "$PAYLOAD_DIR/pincabos-v8.1g-install-cab-payload-to-target.sh" || {
    pco_error "install helper missing or not executable"
    exit 1
  }

  (
    cd "$PAYLOAD_DIR"
    sha256sum -c pincabos-rootfs-cab-v8.1g.parts.sha256
    sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256
  )

  echo
  pco_go "payload checksums valid"
}

choose_disk() {
  local title="$1"
  local CHOICE IDX

  while true; do
    echo
    pco_step "$title"
    echo

    mapfile -t DISKS < <(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}' | grep -Ev '/dev/loop|/dev/sr|/dev/ram' || true)

    if [ "${#DISKS[@]}" -eq 0 ]; then
      echo "No installable disk found."
      echo "Options: r = retry, s = shell, q = reboot"
      pco_prompt "> "
      read -r CHOICE
      case "$CHOICE" in
        r|R) continue ;;
        s|S) bash ;;
        q|Q) reboot ;;
      esac
      continue
    fi

    local i=1
    for d in "${DISKS[@]}"; do
      echo "  [$i] $(lsblk -dpno NAME,SIZE,MODEL "$d")"
      i=$((i+1))
    done

    echo
    echo "Options: number = select disk, s = shell, r = refresh, q = reboot"
    pco_prompt "Choice: "
    read -r CHOICE

    case "$CHOICE" in
      s|S) bash; continue ;;
      r|R) continue ;;
      q|Q) reboot ;;
    esac

    [[ "$CHOICE" =~ ^[0-9]+$ ]] || {
      echo "Invalid choice."
      continue
    }

    IDX=$((CHOICE-1))
    if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#DISKS[@]}" ]; then
      echo "Selection out of range."
      continue
    fi

    DISK="${DISKS[$IDX]}"
    return 0
  done
}

part_paths_for_disk() {
  local disk="$1"

  if [[ "$disk" =~ nvme|mmcblk ]]; then
    EFI_PART="${disk}p1"
    ROOT_PART="${disk}p2"
  else
    EFI_PART="${disk}1"
    ROOT_PART="${disk}2"
  fi
}

unmount_disk_mounts() {
  local disk="$1"

  while IFS= read -r mp; do
    [ -n "$mp" ] && umount -R "$mp" 2>/dev/null || true
  done < <(lsblk -rpno MOUNTPOINT "$disk" | awk 'NF')
}

prepare_target_mount() {
  umount -R "$TARGET" 2>/dev/null || true
  rm -rf "$TARGET"
  mkdir -p "$TARGET"
}

write_fstab() {
  local root_part="$1"
  local efi_part="$2"

  echo
  pco_step "Writing correct fstab"

  ROOT_UUID="$(blkid -s UUID -o value "$root_part")"
  EFI_UUID="$(blkid -s UUID -o value "$efi_part")"

  cat >"$TARGET/etc/fstab" <<FSTAB
# PinCabOS generated fstab
UUID=$ROOT_UUID / ext4 defaults,noatime 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1
FSTAB

  cat "$TARGET/etc/fstab"

  test -s "$TARGET/etc/fstab"
  grep -q '^UUID=.* / ext4 ' "$TARGET/etc/fstab"
  grep -q '^UUID=.* /boot/efi vfat ' "$TARGET/etc/fstab"

  pco_go "fstab écrit et UUID validés"
}

mount_chroot_dirs() {
  mountpoint -q "$TARGET/dev"  || mount --bind /dev  "$TARGET/dev"
  mountpoint -q "$TARGET/proc" || mount --bind /proc "$TARGET/proc"
  mountpoint -q "$TARGET/sys"  || mount --bind /sys  "$TARGET/sys"
  mountpoint -q "$TARGET/run"  || mount --bind /run  "$TARGET/run"
}

install_payload() {
  local mode="$1"

  echo
  pco_step "Installing PinCabOS payload"
  PINCABOS_INSTALL_MODE="$mode" \
    "$PAYLOAD_DIR/pincabos-v8.1g-install-cab-payload-to-target.sh" "$TARGET" "$PAYLOAD_DIR"

  apply_target_regional
  apply_target_orientation

  test -f "$TARGET/etc/pincabos/orientation.conf"

  test -d "$TARGET/opt/pincabos"
  test -d "$TARGET/home/pinball/vpinfe"
  ls "$TARGET"/boot/vmlinuz-* >/dev/null
  ls "$TARGET"/boot/initrd.img-* >/dev/null

  pco_go "Payload PinCabOS installé et vérifié"
}

final_boot_refresh() {
  local mode="$1"

  echo
  pco_step "Final boot refresh"

  mount_chroot_dirs

  mountpoint -q "$TARGET/dev"
  mountpoint -q "$TARGET/proc"
  mountpoint -q "$TARGET/sys"
  mountpoint -q "$TARGET/run"

  pco_go "Environnement chroot monté"

  # Do not run update-initramfs here. It is deferred to first real boot.
  ls "$TARGET"/boot/initrd.img-* >/dev/null
  ls "$TARGET"/boot/vmlinuz-* >/dev/null

  pco_go "Kernel et initramfs présents"

  if chroot "$TARGET" update-grub; then
    pco_go "Configuration GRUB générée"
  else
    pco_warn "update-grub a retourné un avertissement"
  fi

  chroot "$TARGET" grub-install \
    --target=x86_64-efi \
    --efi-directory=/boot/efi \
    --bootloader-id=PinCabOS \
    --recheck

  pco_go "Chargeur EFI PinCabOS installé"

  if [ "$mode" = "full" ]; then
    if chroot "$TARGET" grub-install \
      --target=x86_64-efi \
      --efi-directory=/boot/efi \
      --bootloader-id=PinCabOS \
      --removable \
      --recheck
    then
      pco_go "Fallback EFI amovible installé"
    else
      pco_warn "Fallback EFI amovible non installé"
    fi
  else
    pco_info "Dualboot : fallback EFI amovible ignoré"
  fi

  pco_go "Démarrage EFI finalisé"
}

full_disk_install() {
  choose_disk "Available target disks — FULL ERASE MODE"

  echo
  echo "Selected disk:"
  lsblk -dpno NAME,SIZE,MODEL "$DISK"
  echo
  pco_warn "ALL DATA ON $DISK WILL BE ERASED."
  echo
  pco_prompt "Type INSTALL PINCABOS to continue: "
  read -r CONFIRM

  [ "$CONFIRM" = "INSTALL PINCABOS" ] || {
    echo "Cancelled."
    exit 1
  }

  echo
  pco_step "Unmounting target disk partitions"
  unmount_disk_mounts "$DISK"
  pco_go "Partitions existantes démontées"

  echo
  pco_step "Partitioning disk GPT"
  wipefs -a "$DISK" || true
  sgdisk --zap-all "$DISK" || true
  partprobe "$DISK" || true
  sleep 2

  parted -s "$DISK" mklabel gpt
  parted -s "$DISK" mkpart ESP fat32 1MiB 551MiB
  parted -s "$DISK" set 1 esp on
  parted -s "$DISK" mkpart primary ext4 551MiB 100%

  partprobe "$DISK"
  udevadm settle
  sleep 2

  part_paths_for_disk "$DISK"

  test -b "$EFI_PART" || { echo "ERROR: missing EFI partition: $EFI_PART"; exit 1; }
  test -b "$ROOT_PART" || { echo "ERROR: missing root partition: $ROOT_PART"; exit 1; }

  pco_go "Table GPT et partitions EFI/root créées"

  echo
  pco_step "Formatting partitions"
  mkfs.vfat -F 32 -n PCOS_EFI "$EFI_PART"
  mkfs.ext4 -F -L rootfs "$ROOT_PART"

  [ "$(blkid -s TYPE -o value "$EFI_PART")" = "vfat" ]
  [ "$(blkid -s TYPE -o value "$ROOT_PART")" = "ext4" ]

  pco_go "Partitions EFI et root formatées"

  echo
  pco_step "Mounting target"
  prepare_target_mount
  mount "$ROOT_PART" "$TARGET"
  mkdir -p "$TARGET/boot/efi"
  mount "$EFI_PART" "$TARGET/boot/efi"

  mountpoint -q "$TARGET"
  mountpoint -q "$TARGET/boot/efi"

  pco_go "Partitions root et EFI montées"

  install_payload "full"
  write_fstab "$ROOT_PART" "$EFI_PART"
  final_boot_refresh "full"
}

find_efi_partition() {
  local disk="$1"

  lsblk -rpno NAME,FSTYPE,PARTTYPE "$disk" \
    | awk 'tolower($3)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}'

  return 0
}

list_free_spaces() {
  local disk="$1"

  parted -m "$disk" unit MiB print free \
    | awk -F: -v min="$MIN_FREE_MIB" '
      /free/ {
        start=$2
        end=$3
        size=$4
        gsub(/MiB/,"",start)
        gsub(/MiB/,"",end)
        gsub(/MiB/,"",size)
        if ((size+0) >= min) {
          printf "%.2f|%.2f|%.2f\n", start, end, size
        }
      }
    '
}

dualboot_install() {
  choose_disk "Available target disks — DUALBOOT FREE SPACE MODE"

  echo
  echo "Selected disk:"
  lsblk -dpno NAME,SIZE,MODEL "$DISK"
  echo
  echo "Dualboot mode will NOT resize partitions."
  echo "It only uses existing unallocated/free space on the selected disk."
  echo

  EFI_PART="$(find_efi_partition "$DISK" || true)"

  if [ -z "$EFI_PART" ]; then
    pco_error "no existing EFI System Partition found on $DISK."
    echo "Dualboot mode requires an existing EFI partition on the same disk."
    exit 1
  fi

  echo "Existing EFI partition found:"
  lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$EFI_PART" || true

  mapfile -t FREE_SPACES < <(list_free_spaces "$DISK")

  if [ "${#FREE_SPACES[@]}" -eq 0 ]; then
    echo
    pco_error "no unallocated space >= ${MIN_FREE_MIB}MiB found on $DISK."
    echo "Create unallocated space first, then rerun this installer."
    echo "No existing partition was modified."
    exit 1
  fi

  echo
  echo "Available unallocated spaces:"
  local i=1 row start end size gib
  for row in "${FREE_SPACES[@]}"; do
    IFS='|' read -r start end size <<<"$row"
    gib="$(awk -v m="$size" 'BEGIN { printf "%.1f", m/1024 }')"
    echo "  [$i] start=${start}MiB end=${end}MiB size=${gib}GiB"
    i=$((i+1))
  done

  echo
  pco_prompt "Select free space number: "
  read -r FREE_CHOICE

  [[ "$FREE_CHOICE" =~ ^[0-9]+$ ]] || {
    echo "Invalid choice."
    exit 1
  }

  FREE_IDX=$((FREE_CHOICE-1))
  if [ "$FREE_IDX" -lt 0 ] || [ "$FREE_IDX" -ge "${#FREE_SPACES[@]}" ]; then
    echo "Selection out of range."
    exit 1
  fi

  IFS='|' read -r START_MIB END_MIB SIZE_MIB <<<"${FREE_SPACES[$FREE_IDX]}"
  END_SAFE_MIB="$(awk -v e="$END_MIB" 'BEGIN { printf "%.2f", e-1 }')"

  echo
  pco_warn ""
  echo "This will create a new PinCabOS ext4 partition only in this free space:"
  echo "  Disk:  $DISK"
  echo "  Start: ${START_MIB}MiB"
  echo "  End:   ${END_SAFE_MIB}MiB"
  echo "  EFI:   $EFI_PART will be reused, NOT formatted"
  echo
  pco_prompt "Type INSTALL PINCABOS DUALBOOT to continue: "
  read -r CONFIRM

  [ "$CONFIRM" = "INSTALL PINCABOS DUALBOOT" ] || {
    echo "Cancelled."
    exit 1
  }

  echo
  pco_step "Creating PinCabOS root partition in free space"
  parted -s "$DISK" unit MiB mkpart PINCABOS_ROOT ext4 "${START_MIB}MiB" "${END_SAFE_MIB}MiB"
  partprobe "$DISK"
  udevadm settle
  sleep 2

  ROOT_PART="$(lsblk -rpno NAME,PARTLABEL "$DISK" | awk '$2=="PINCABOS_ROOT"{print $1}' | tail -n1)"

  if [ -z "$ROOT_PART" ] || [ ! -b "$ROOT_PART" ]; then
    pco_error "could not locate new PINCABOS_ROOT partition."
    lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$DISK"
    exit 1
  fi

  pco_go "Partition PinCabOS créée dans l’espace libre"

  echo
  echo "New PinCabOS root partition:"
  lsblk -rpno NAME,SIZE,FSTYPE,PARTLABEL "$ROOT_PART" || true

  echo
  pco_step "Formatting PinCabOS root only"
  mkfs.ext4 -F -L rootfs "$ROOT_PART"

  [ "$(blkid -s TYPE -o value "$ROOT_PART")" = "ext4" ]

  pco_go "Partition PinCabOS formatée en ext4"

  echo
  pco_step "Mounting target"
  prepare_target_mount
  mount "$ROOT_PART" "$TARGET"
  mkdir -p "$TARGET/boot/efi"
  mount "$EFI_PART" "$TARGET/boot/efi"

  mountpoint -q "$TARGET"
  mountpoint -q "$TARGET/boot/efi"

  pco_go "Partitions root et EFI montées"

  install_payload "dualboot"
  write_fstab "$ROOT_PART" "$EFI_PART"
  final_boot_refresh "dualboot"
}

check_payload

regional_setup

while true; do
  echo
  pco_hr
  echo " PinCabOS install mode"
  pco_hr
  echo
  echo "  [1] Erase a full disk and install PinCabOS"
  echo "      Recommended for a dedicated pincab."
  echo
  echo "  [2] Install PinCabOS into existing unallocated space"
  echo "      Dualboot mode. Does NOT resize existing partitions."
  echo
  echo "  [3] Rescue shell"
  echo
  echo "  [4] Reboot"
  echo
  pco_prompt "Choice: "
  read -r MODE

  case "$MODE" in
    1) full_disk_install; break ;;
    2) dualboot_install; break ;;
    3) bash ;;
    4) reboot ;;
    *) echo "Invalid choice." ;;
  esac
done

echo
pco_step "Final validation"
find "$TARGET/boot" -maxdepth 2 -type f | sort | sed -n '1,120p'
ls -lah "$TARGET/lib/modules"
cat "$TARGET/etc/fstab"
grep -R "quiet splash\|PinCabOS\|pincabos\|plymouth" \
  "$TARGET/etc/default/grub" \
  "$TARGET/etc/plymouth/plymouthd.conf" \
  "$TARGET/boot/grub/grub.cfg" \
  2>/dev/null || true

test -s "$TARGET/etc/fstab"
test -d "$TARGET/boot/efi"
ls "$TARGET"/boot/vmlinuz-* >/dev/null
ls "$TARGET"/boot/initrd.img-* >/dev/null
test -d "$TARGET/opt/pincabos"

pco_go "Validation finale du système installé réussie"

echo
pco_hr
pco_go "PinCabOS installation completed successfully."
pco_warn "Remove the ISO/USB media, then reboot."
pco_hr
pco_prompt "Press ENTER to reboot now, or CTRL+C to stay in live session..."
read -r
reboot
PINCBOS_LIVE_INSTALLER

chmod 755 "$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer"

echo
echo "=== PinCabOS lean live TTY boot ==="
echo "PINCABOS_LIVE_TTY_BOOT_NO_CYCLE_V1"

mkdir -p \
  "$ROOTFS_DIR/etc/systemd/system" \
  "$ROOTFS_DIR/etc/systemd/system/multi-user.target.wants" \
  "$ROOTFS_DIR/usr/local/sbin"

echo
echo "--- Set stable live hostname ---"

printf 'pincabos-live\n' > "$ROOTFS_DIR/etc/hostname"

if [ -f "$ROOTFS_DIR/etc/hosts" ]; then
  sed -i \
    '/^[[:space:]]*127\.0\.1\.1[[:space:]]/d' \
    "$ROOTFS_DIR/etc/hosts"
else
  printf '127.0.0.1 localhost\n' > "$ROOTFS_DIR/etc/hosts"
fi

printf '127.0.1.1 pincabos-live\n' \
  >> "$ROOTFS_DIR/etc/hosts"

echo
echo "--- Mask unnecessary desktop/live background services ---"

LIVE_MASK_UNITS=(
  casper-md5check.service
  cloud-init-local.service
  cloud-init.service
  cloud-config.service
  cloud-final.service
  cloud-init.target
  snapd.service
  snapd.socket
  snapd.seeded.service
  snapd.autoimport.service
  apt-daily.service
  apt-daily.timer
  apt-daily-upgrade.service
  apt-daily-upgrade.timer
  unattended-upgrades.service
  packagekit.service
  NetworkManager-wait-online.service
  fwupd.service
  fwupd-refresh.service
  fwupd-refresh.timer
  whoopsie.service
  apport.service
  plymouth-start.service
  plymouth-quit.service
  plymouth-quit-wait.service
  plymouth-read-write.service
)

for unit in "${LIVE_MASK_UNITS[@]}"; do
  echo "Masking live-only unit: $unit"
  ln -sfn /dev/null \
    "$ROOTFS_DIR/etc/systemd/system/$unit"
done

# tty1 belongs exclusively to the PinCabOS installer.
ln -sfn /dev/null \
  "$ROOTFS_DIR/etc/systemd/system/getty@tty1.service"

ln -sfn /dev/null \
  "$ROOTFS_DIR/etc/systemd/system/autovt@tty1.service"

cat >"$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer-wait" <<'PINCABOS_LIVE_WAIT'
#!/usr/bin/env bash
set -u

PAYLOAD="/cdrom/pincabos-payload"
HELPER="$PAYLOAD/pincabos-v8.1g-install-cab-payload-to-target.sh"
CHECKSUM="$PAYLOAD/pincabos-rootfs-cab-v8.1g.parts.sha256"

for second in $(seq 1 90); do
  if [ -d "$PAYLOAD" ] &&
     [ -x "$HELPER" ] &&
     [ -s "$CHECKSUM" ]; then
    exit 0
  fi

  sleep 1
done

echo
echo "NOGO: PinCabOS payload was not mounted under /cdrom."
echo
echo "Current /cdrom contents:"
ls -lah /cdrom 2>/dev/null || true

exit 1
PINCABOS_LIVE_WAIT

chmod 755 \
  "$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer-wait"

cat >"$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer-console" <<'PINCABOS_LIVE_CONSOLE'
#!/usr/bin/env bash
set +e

export TERM=linux

printf '\033c'
echo "==============================================================="
echo " PINCABOS — STARTING TEXT INSTALLER"
echo "==============================================================="
echo

/usr/local/sbin/pincabos-live-installer-wait
WAIT_RC=$?

if [ "$WAIT_RC" -ne 0 ]; then
  echo
  echo "NOGO: live media payload initialization failed."
  echo "A rescue shell is opening on tty1."
  echo
  exec /bin/bash -l
fi

# PINCABOS_LIVE_CLEAN_TTY_CONSOLE_V1
# Le démarrage Ubuntu/Casper reste sur tty2.
# tty1 est réservé exclusivement à l’interface PinCabOS.
dmesg -n 3 >/dev/null 2>&1 || true
printf '\033c\033[2J\033[H'
clear 2>/dev/null || true

/usr/local/sbin/pincabos-live-installer
INSTALLER_RC=$?

echo
echo "==============================================================="
echo " PINCABOS INSTALLER STOPPED — CODE $INSTALLER_RC"
echo "==============================================================="
echo "A rescue shell is opening on tty1."
echo

exec /bin/bash -l
PINCABOS_LIVE_CONSOLE

chmod 755 \
  "$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer-console"

cat >"$ROOTFS_DIR/etc/systemd/system/pincabos-live-installer-tty.service" <<'PINCBOS_SERVICE'
[Unit]
Description=PinCabOS text installer on tty1
After=local-fs.target
Before=getty.target
ConditionKernelCommandLine=!pincabos.rescue=1
ConditionPathExists=/usr/local/sbin/pincabos-live-installer-console

[Service]
Type=simple
Environment=TERM=linux
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/local/sbin/pincabos-live-installer-console
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
PINCBOS_SERVICE

ln -sfn ../pincabos-live-installer-tty.service \
  "$ROOTFS_DIR/etc/systemd/system/multi-user.target.wants/pincabos-live-installer-tty.service"


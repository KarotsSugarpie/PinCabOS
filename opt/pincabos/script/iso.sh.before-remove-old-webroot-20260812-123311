rm -f \
  "$TARGET/etc/systemd/system/pincabos-dashboard-live.service.d/70-after-graphical-x11.conf" \
  "$TARGET/etc/systemd/system/pincabos-dashboard-live.service.d/90-display-roles.conf" \
  "$TARGET/etc/systemd/system/pincabos-dashboard-live.service.d/95-pincabos-iso-ordering.conf" \
  "$TARGET/etc/systemd/system/pincabos-scoreview-router.service.d/95-pincabos-iso-ordering.conf" \
  "$TARGET/etc/systemd/system/pincabos-fulldmd-no-title.service.d/95-pincabos-iso-ordering.conf" \
  "$TARGET/etc/systemd/system/pincabos-switch-graphical-vt.service.d/95-pincabos-iso-ordering.conf" \
  "$TARGET/etc/systemd/system/pincabos-backglass-bridge.service.d/95-pincabos-iso-ordering.conf" \
  2>/dev/null || true


WorkingDirectory=/opt/pincabos/web
ExecStart=/usr/local/sbin/pincabos-webapp-fallback-start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
WEBAPP_FALLBACK_SERVICE


  chmod 755 "$TARGET/opt/pincabos/scripts/pincabos-screen-topology.py" || true
  SCREEN_TOPOLOGY_EXEC="$SCREEN_TOPOLOGY_PREFLIGHT"
else
  echo "NOTICE: topology engine incomplete in target; using harmless no-op service."
  SCREEN_TOPOLOGY_EXEC="/usr/bin/true"

  printf '\n'
  pco_hr

  printf '%b\n' \
    "${ORANGE}██████╗ ██╗███╗   ██╗ ██████╗ █████╗ ██████╗  ██████╗ ███████╗${NC}" \
    "${ORANGE}██╔══██╗██║████╗  ██║██╔════╝██╔══██╗██╔══██╗██╔═══██╗██╔════╝${NC}" \

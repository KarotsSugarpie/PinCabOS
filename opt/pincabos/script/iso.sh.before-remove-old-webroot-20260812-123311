for managed_unit in "${MANAGED_GRAPHICAL_UNITS[@]}"; do
  managed_path="$TARGET/etc/systemd/system/$managed_unit"

  [ -f "$managed_path" ] || continue

  if grep -Eq \
    '^After=.*(^|[[:space:]])graphical\.target([[:space:]]|$)' \
    "$managed_path"
  then
    echo "ERROR: $managed_unit still contains After=graphical.target"
    exit 1
  fi

  if grep -Eq \
    '^(After|Wants|Requires|Before)=.*pincabos-(display-roles|display-role-|screen-topology\.service)' \
    "$managed_path"
  then
    echo "ERROR: $managed_unit still references an obsolete display engine"
    exit 1
  fi

  if [ -L "$TARGET/etc/systemd/system/multi-user.target.wants/$managed_unit" ]; then
    echo "ERROR: $managed_unit remains enabled in multi-user.target"
    exit 1
  fi

  if [ ! -L "$TARGET/etc/systemd/system/graphical.target.wants/$managed_unit" ]; then
    echo "ERROR: $managed_unit is not enabled in graphical.target"
    exit 1
  fi

  echo "OK: clean graphical ordering: $managed_unit"
done

echo
echo "=== Validate target systemd ordering graph ==="

SYSTEMD_VERIFY_LOG="$(
  mktemp /tmp/pincabos-target-systemd-verify.XXXXXX
)"

systemd-analyze --root="$TARGET" verify \
  pincabos-screen-topology-boot.service \
  pincabos-vpinfe.service \
  pincabos-dashboard-live.service \
  pincabos-scoreview-router.service \
  pincabos-fulldmd-no-title.service \
  pincabos-switch-graphical-vt.service \
  pincabos-backglass-bridge.service \
  >"$SYSTEMD_VERIFY_LOG" 2>&1 || true

if grep -Eqi \
  'ordering cycle|cyclic ordering dependency|unable to break cycle|transaction order is cyclic' \
  "$SYSTEMD_VERIFY_LOG"
then
  echo "ERROR: target systemd ordering cycle remains"
  cat "$SYSTEMD_VERIFY_LOG"
  rm -f "$SYSTEMD_VERIFY_LOG"
  exit 1
fi

echo "OK: no target graphical ordering cycle detected"

grep -Ei \
  'pincabos-|warning|error|failed' \
  "$SYSTEMD_VERIFY_LOG" |
  tail -100 || true

rm -f "$SYSTEMD_VERIFY_LOG"

unset -f pincabos_target_find_unit

def sanitize_ini(
    path,
    forbidden_keys,
    removed_sections,
):
    if not path.is_file():
        return False

    original = path.read_text(
        encoding="utf-8",
        errors="replace",
    )

    output = []
    skip_section = False

    for line in original.splitlines(
        keepends=True
    ):
        section_match = re.match(
            r"^\s*\[([^\]]+)\]\s*$",
            line,
        )

        if section_match:
            section_name = (
                section_match.group(1)
                .strip()
                .lower()
            )

            skip_section = (
                section_name
                in removed_sections
            )

            if skip_section:
                continue

        if skip_section:
            continue

        key_match = re.match(
            r"^\s*([^;#][^=]*?)\s*=",
            line,
        )

        if key_match:
            key = (
                key_match.group(1)
                .strip()
                .lower()
            )

            if key in forbidden_keys:
                continue

        output.append(line)

    sanitized = "".join(output)

    if sanitized == original:
        return False

    path.write_text(
        sanitized,
        encoding="utf-8",
    )

    return True



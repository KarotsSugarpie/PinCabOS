  chmod 755 /opt/pincabos/tools/run-vpinfe-systemd.sh 2>/dev/null || true

  echo
  echo "=== Enable/start VPinFE ==="
  systemctl daemon-reload || true
  systemctl reset-failed pincabos-vpinfe.service >/dev/null 2>&1 || true
  systemctl enable pincabos-vpinfe.service >/dev/null 2>&1 || true
  systemctl restart pincabos-vpinfe.service >/dev/null 2>&1 || true

  echo
  echo "=== Wait for VPinFE port 8001 ==="
  VPINFE_OK=0
  for i in $(seq 1 45); do
    if ss -lnt 2>/dev/null | grep -qE ':8001\s'; then
      VPINFE_OK=1
      break
    fi
    sleep 2
  done

  echo "VPINFE_OK=$VPINFE_OK"
  systemctl status pincabos-vpinfe.service --no-pager -l || true
  journalctl -u pincabos-vpinfe.service -b --no-pager -n 160 || true

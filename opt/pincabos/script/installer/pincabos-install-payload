    exit 0
  fi

  echo
  echo "=== Runtime files ==="
  ls -lah /home/pinball/vpinfe 2>/dev/null || true
  ls -lah /home/pinball/vpinfe/_internal 2>/dev/null | sed -n '1,80p' || true
  ls -lah /opt/pincabos/tools/run-vpinfe-systemd.sh 2>/dev/null || true

  echo
  echo "=== Permissions ==="
  chown -R pinball:pinball /home/pinball/vpinfe 2>/dev/null || true
  chown -R pinball:pinball /home/pinball/.config/vpinfe 2>/dev/null || true

#!/usr/bin/env bash
set -Eeuo pipefail

clear
echo "==============================================================="
echo " PINCABOS — MASTER ISO BUILDER V8.1G ENGLISH"
echo " Clean -> Payload -> ISO-ready -> Live installer -> Bootable ISO"
echo "==============================================================="

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: run as root"
  exit 1
fi

VERSION="v8.1g"
VERSION_UPPER="V8.1G"

BASE_ISO_URL="https://releases.ubuntu.com/26.04/ubuntu-26.04-desktop-amd64.iso"
BASE_SHA_URL="https://releases.ubuntu.com/26.04/SHA256SUMS"

CACHE_DIR="/opt/pincabos/cache/iso-base"
BASE_ISO="$CACHE_DIR/ubuntu-26.04-desktop-amd64.iso"

BUILD_BASE="/opt/pincabos/build"
WORK="$BUILD_BASE/live-v8.1g-english"
PAYLOAD_FULL="$WORK/payload-full"
PAYLOAD_ISO_READY="$WORK/iso-ready/pincabos-payload"
ISO_DIR="$WORK/iso"
ROOTFS_DIR="$WORK/squashfs-root"
BOOT_WORK="$WORK/boot-work"

OUT_DIR="$BUILD_BASE/output"
OUT_ISO="$OUT_DIR/PinCabOS-V8.1G-English-Live-Installer.iso"
VOLID="PINCABOS_V81G"

LOG_DIR="$BUILD_BASE/logs"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/iso-v8.1g-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1

echo
echo "Log:"
echo "$LOG"

die() {
  echo
  echo "ERROR: $*"
  exit 1
}

run() {
  echo
  echo ">>> $*"
  "$@"
}

cleanup_mounts() {
  set +e
  for p in "$ROOTFS_DIR/dev" "$ROOTFS_DIR/proc" "$ROOTFS_DIR/sys" "$ROOTFS_DIR/run"; do
    mountpoint -q "$p" && umount -R "$p"
  done
  set -e
}
trap cleanup_mounts EXIT

echo
echo "=== 1) Safety audit before cleanup ==="
echo "Build base: $BUILD_BASE"
echo "Work dir:   $WORK"
echo "Output ISO: $OUT_ISO"
df -h /
du -sh "$BUILD_BASE" 2>/dev/null || true
du -sh /root/pincabos-v8.1g-cab-payload 2>/dev/null || true
du -sh /root/pincabos-v8.1g-iso-ready 2>/dev/null || true

echo
echo "=== 2) Cleanup obsolete/generated build files only ==="
echo "Cleaning generated build work, not the installed PinCabOS system."
rm -rf "$WORK"
rm -rf /root/pincabos-v8.1-cab-payload
rm -rf /root/pincabos-v8.1f-iso-ready
rm -rf /root/pincabos-v8.1g-cab-payload
rm -rf /root/pincabos-v8.1g-iso-ready
rm -f "$OUT_ISO" "$OUT_ISO.sha256"
find "$CACHE_DIR" -maxdepth 1 -type f -name '*.part' -delete 2>/dev/null || true

mkdir -p "$PAYLOAD_FULL" "$PAYLOAD_ISO_READY" "$ISO_DIR" "$ROOTFS_DIR" "$BOOT_WORK" "$OUT_DIR" "$CACHE_DIR"

echo
echo "=== 3) Install required host builder tools ==="
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y \
  xorriso \
  squashfs-tools \
  rsync \
  wget \
  zstd \
  ca-certificates \
  parted \
  dosfstools \
  gdisk \
  util-linux \
  coreutils \
  grub-pc-bin \
  grub-efi-amd64-bin \
  mtools \
  e2fsprogs

echo
echo "=== 4) Validate source cabinet boot, modules, GRUB and Plymouth ==="
test -d /boot || die "/boot missing"
test -d /lib/modules || die "/lib/modules missing"
test -f /etc/default/grub || die "/etc/default/grub missing"
test -f /usr/share/plymouth/themes/pincabos/pincabos.plymouth || die "Plymouth pincabos theme missing"
ls /boot/vmlinuz-* >/dev/null || die "No kernel in /boot"
ls /boot/initrd.img-* >/dev/null || die "No initrd in /boot"
ls /lib/modules/* >/dev/null || die "No modules in /lib/modules"

echo "OK: source boot/modules/grub/plymouth present"

echo
echo "=== 5) Build lean PinCabOS payload from current cabinet ==="
ARCHIVE="$PAYLOAD_FULL/pincabos-rootfs-cab-v8.1g.tar.zst"
OVERLAY="$PAYLOAD_FULL/pincabos-plymouth-theme-overlay-v8.1g.tar.zst"
MANIFEST="$PAYLOAD_FULL/pincabos-rootfs-cab-v8.1g.manifest.txt"

{
  echo "PinCabOS V8.1G LEAN CAB PAYLOAD"
  echo "Generated: $(date -Is)"
  echo
  echo "Excluded:"
  echo "/home/pinball/Tables"
  echo "/opt/pincabos/build"
  echo "/swap.img"
  echo "/swapfile"
  echo "venv/.venv/virtualenv"
  echo "node_modules"
  echo "__pycache__"
  echo "/root old payloads"
  echo "/var/tmp, /var/crash, apt archives, journals"
  echo
  findmnt /
  echo
  ls -lah /boot/vmlinuz-* /boot/initrd.img-* 2>/dev/null || true
  echo
  ls -lah /lib/modules
  echo
  cat /etc/default/grub
  echo
  find /usr/share/plymouth/themes/pincabos -maxdepth 2 -type f | sort
} > "$MANIFEST"

sed -n '1,140p' "$MANIFEST"

tar \
  --checkpoint=10000 \
  --checkpoint-action=echo='archived %u entries...' \
  --acls \
  --xattrs \
  --numeric-owner \
  --one-file-system \
  --warning=no-file-changed \
  --exclude='./boot/efi' \
  --exclude='./boot/efi/*' \
  --exclude='./proc/*' \
  --exclude='./sys/*' \
  --exclude='./dev/*' \
  --exclude='./run/*' \
  --exclude='./tmp/*' \
  --exclude='./mnt/*' \
  --exclude='./media/*' \
  --exclude='./cdrom/*' \
  --exclude='./lost+found' \
  --exclude='./swap.img' \
  --exclude='./swapfile' \
  --exclude='./home/pinball/Tables' \
  --exclude='./home/pinball/Tables/*' \
  --exclude='./home/pinball/Backups/*' \
  --exclude='./home/pinball/Downloads/*' \
  --exclude='./home/pinball/.cache' \
  --exclude='./home/pinball/.cache/*' \
  --exclude='./home/pinball/.local/share/Trash/*' \
  --exclude='./home/*/snap' \
  --exclude='./home/*/snap/*' \
  --exclude='./snap' \
  --exclude='./snap/*' \
  --exclude='./var/snap' \
  --exclude='./var/snap/*' \
  --exclude='./var/lib/snapd' \
  --exclude='./var/lib/snapd/*' \
  --exclude='./var/log/journal/*' \
  --exclude='./var/cache/apt/archives/*.deb' \
  --exclude='./var/tmp' \
  --exclude='./var/tmp/*' \
  --exclude='./var/crash' \
  --exclude='./var/crash/*' \
  --exclude='./root/.cache' \
  --exclude='./root/.cache/*' \
  --exclude='./root/pincabos-v8.1-cab-payload' \
  --exclude='./root/pincabos-v8.1-cab-payload/*' \
  --exclude='./root/pincabos-v8.1f-iso-ready' \
  --exclude='./root/pincabos-v8.1f-iso-ready/*' \
  --exclude='./root/pincabos-v8.1g-cab-payload' \
  --exclude='./root/pincabos-v8.1g-cab-payload/*' \
  --exclude='./root/pincabos-v8.1g-iso-ready' \
  --exclude='./root/pincabos-v8.1g-iso-ready/*' \
  --exclude='./opt/pincabos/build' \
  --exclude='./opt/pincabos/build/*' \
  --exclude='*/node_modules' \
  --exclude='*/node_modules/*' \
  --exclude='*/__pycache__' \
  --exclude='*/__pycache__/*' \
  --exclude='*/.venv' \
  --exclude='*/.venv/*' \
  --exclude='*/venv' \
  --exclude='*/venv/*' \
  --exclude='*/virtualenv' \
  --exclude='*/virtualenv/*' \
  -I 'zstd -T0 -10' \
  -cpf "$ARCHIVE" \
  -C / .

echo
echo "=== 6) Build Plymouth overlay ==="
tar \
  --acls \
  --xattrs \
  --numeric-owner \
  -I 'zstd -T0 -10' \
  -cpf "$OVERLAY" \
  -C / \
  usr/share/plymouth/themes/pincabos \
  etc/plymouth

echo
echo "=== 7) Validate payload exclusions and boot contents ==="
tar -I zstd -tf "$ARCHIVE" \
  | grep -E '^./boot/(vmlinuz|initrd.img|grub)|^./lib/modules/' \
  | sed -n '1,120p'

if tar -I zstd -tf "$ARCHIVE" | grep -q '^./home/pinball/Tables/'; then
  die "Tables included in payload"
fi
echo "OK: Tables excluded"

if tar -I zstd -tf "$ARCHIVE" | grep -q '^./opt/pincabos/build/'; then
  die "/opt/pincabos/build included in payload"
fi
echo "OK: /opt/pincabos/build excluded"

if tar -I zstd -tf "$ARCHIVE" | grep -Eq '^\./swap\.img$|^\./swapfile$|/(venv|\.venv|virtualenv)(/|$)'; then
  echo "Bad entries:"
  tar -I zstd -tf "$ARCHIVE" | grep -E '^\./swap\.img$|^\./swapfile$|/(venv|\.venv|virtualenv)(/|$)' | sed -n '1,80p'
  die "swap or venv included in payload"
fi
echo "OK: swap and venv excluded"

if tar -I zstd -tf "$ARCHIVE" | grep -q '^./root/pincabos-v8'; then
  die "old /root payload included"
fi
echo "OK: old root payloads excluded"

tar -I zstd -tf "$OVERLAY" | grep -q '^usr/share/plymouth/themes/pincabos/pincabos.plymouth$' \
  || die "Plymouth overlay missing pincabos.plymouth"
echo "OK: Plymouth overlay valid"

echo
echo "=== 8) Split payload and make ISO-ready payload directory ==="
sha256sum "$ARCHIVE" > "$PAYLOAD_FULL/pincabos-rootfs-cab-v8.1g.sha256"
sha256sum "$OVERLAY" > "$PAYLOAD_FULL/pincabos-plymouth-theme-overlay-v8.1g.sha256"

split -b 1900M -d -a 3 "$ARCHIVE" "$ARCHIVE.part-"

cat > "$PAYLOAD_FULL/pincabos-v8.1g-install-cab-payload-to-target.sh" <<'PINCBOS_PAYLOAD_HELPER'
#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-/target}"
PAYLOAD_DIR="${2:-/cdrom/pincabos-payload}"

echo "==============================================================="
echo " PINCABOS V8.1G — INSTALL LEAN CAB PAYLOAD"
echo "==============================================================="

[ "$(id -u)" -eq 0 ] || { echo "ERROR: root required"; exit 1; }
[ -d "$TARGET" ] || { echo "ERROR: target missing: $TARGET"; exit 1; }
findmnt "$TARGET" >/dev/null || { echo "ERROR: $TARGET not mounted"; exit 1; }

echo
echo "=== 1) Verify chunks ==="
( cd "$PAYLOAD_DIR" && sha256sum -c pincabos-rootfs-cab-v8.1g.parts.sha256 )

echo
echo "=== 2) Extract rootfs ==="
cat "$PAYLOAD_DIR"/pincabos-rootfs-cab-v8.1g.tar.zst.part-* \
  | tar --acls --xattrs --numeric-owner -I zstd -xpf - -C "$TARGET"

echo
echo "=== 3) Extract Plymouth overlay ==="
( cd "$PAYLOAD_DIR" && sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256 )
tar --acls --xattrs --numeric-owner -I zstd \
  -xpf "$PAYLOAD_DIR/pincabos-plymouth-theme-overlay-v8.1g.tar.zst" \
  -C "$TARGET"

echo
echo "=== 4) Validate boot/Plymouth ==="
ls "$TARGET"/boot/vmlinuz-* >/dev/null
ls "$TARGET"/boot/initrd.img-* >/dev/null
ls "$TARGET"/lib/modules/* >/dev/null
test -f "$TARGET/usr/share/plymouth/themes/pincabos/pincabos.plymouth"

echo
echo "=== 5) Chroot mounts ==="
mkdir -p "$TARGET"/dev "$TARGET"/proc "$TARGET"/sys "$TARGET"/run "$TARGET"/boot/efi
mountpoint -q "$TARGET/dev"  || mount --bind /dev  "$TARGET/dev"
mountpoint -q "$TARGET/proc" || mount --bind /proc "$TARGET/proc"
mountpoint -q "$TARGET/sys"  || mount --bind /sys  "$TARGET/sys"
mountpoint -q "$TARGET/run"  || mount --bind /run  "$TARGET/run"

echo
echo "=== 6) Force quiet splash + Plymouth ==="
if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' "$TARGET/etc/default/grub"; then
  sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"/' "$TARGET/etc/default/grub"
else
  echo 'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"' >> "$TARGET/etc/default/grub"
fi

chroot "$TARGET" plymouth-set-default-theme pincabos || true
mkdir -p "$TARGET/etc/plymouth"
printf '[Daemon]\nTheme=pincabos\n' > "$TARGET/etc/plymouth/plymouthd.conf"

echo
echo "=== 7) Regen initramfs + grub ==="
chroot "$TARGET" update-initramfs -u -k all
chroot "$TARGET" update-grub

echo
echo "=== 8) GRUB EFI ==="
mountpoint -q "$TARGET/boot/efi" || {
  echo "ERROR: EFI not mounted on $TARGET/boot/efi"
  exit 1
}

chroot "$TARGET" grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=PinCabOS \
  --recheck

chroot "$TARGET" grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=PinCabOS \
  --removable \
  --recheck || true

echo
echo "OK — V8.1G target installed"
PINCBOS_PAYLOAD_HELPER

chmod +x "$PAYLOAD_FULL/pincabos-v8.1g-install-cab-payload-to-target.sh"

rm -rf "$PAYLOAD_ISO_READY"
mkdir -p "$PAYLOAD_ISO_READY"

cp -a "$ARCHIVE".part-* "$PAYLOAD_ISO_READY/"
cp -a "$MANIFEST" "$PAYLOAD_ISO_READY/"
cp -a "$OVERLAY" "$PAYLOAD_ISO_READY/"
cp -a "$PAYLOAD_FULL/pincabos-v8.1g-install-cab-payload-to-target.sh" "$PAYLOAD_ISO_READY/"

(
  cd "$PAYLOAD_ISO_READY"
  sha256sum pincabos-rootfs-cab-v8.1g.tar.zst.part-* > pincabos-rootfs-cab-v8.1g.parts.sha256
  sha256sum pincabos-plymouth-theme-overlay-v8.1g.tar.zst > pincabos-plymouth-theme-overlay-v8.1g.sha256
  sha256sum -c pincabos-rootfs-cab-v8.1g.parts.sha256
  sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256
)

echo
echo "ISO-ready payload:"
ls -lh "$PAYLOAD_ISO_READY"
du -sh "$PAYLOAD_ISO_READY"

echo
echo "=== 9) Download or validate Ubuntu base ISO ==="
mkdir -p "$CACHE_DIR"

if [ ! -f "$BASE_ISO" ]; then
  wget -O "$BASE_ISO.part" "$BASE_ISO_URL"
  mv "$BASE_ISO.part" "$BASE_ISO"
else
  echo "Base ISO already cached: $BASE_ISO"
fi

wget -O "$CACHE_DIR/SHA256SUMS" "$BASE_SHA_URL"

EXPECTED="$(grep 'ubuntu-26.04-desktop-amd64.iso$' "$CACHE_DIR/SHA256SUMS" | awk '{print $1}')"
ACTUAL="$(sha256sum "$BASE_ISO" | awk '{print $1}')"

echo "Expected: $EXPECTED"
echo "Actual:   $ACTUAL"

[ -n "$EXPECTED" ] || die "Cannot find base ISO checksum"
[ "$EXPECTED" = "$ACTUAL" ] || die "Base ISO checksum mismatch"

echo "OK: base ISO checksum valid"

echo
echo "=== 10) Extract base ISO ==="
rm -rf "$ISO_DIR" "$ROOTFS_DIR"
mkdir -p "$ISO_DIR" "$ROOTFS_DIR"

xorriso -osirrox on -indev "$BASE_ISO" -extract / "$ISO_DIR"
chmod -R u+w "$ISO_DIR"

echo
echo "=== 11) Locate and unpack live squashfs ==="
find "$ISO_DIR/casper" -maxdepth 3 -type f -name '*.squashfs' \
  -printf '%12s  %p\n' 2>/dev/null | sort -n || true

SQUASHFS="$(find "$ISO_DIR/casper" -maxdepth 3 -type f -name '*.squashfs' -printf '%s %p\n' 2>/dev/null | sort -nr | head -n1 | cut -d' ' -f2-)"

[ -n "$SQUASHFS" ] || die "No squashfs found under $ISO_DIR/casper"
[ -f "$SQUASHFS" ] || die "Squashfs path invalid: $SQUASHFS"

echo "Selected live squashfs:"
ls -lh "$SQUASHFS"

unsquashfs -d "$ROOTFS_DIR" "$SQUASHFS"

echo
echo "=== 12) Ensure required live installer tools inside squashfs ==="
cp -a /etc/resolv.conf "$ROOTFS_DIR/etc/resolv.conf" || true
mount --bind /dev "$ROOTFS_DIR/dev"
mount --bind /proc "$ROOTFS_DIR/proc"
mount --bind /sys "$ROOTFS_DIR/sys"
mount --bind /run "$ROOTFS_DIR/run"

chroot "$ROOTFS_DIR" apt-get update
DEBIAN_FRONTEND=noninteractive chroot "$ROOTFS_DIR" apt-get install -y \
  zstd \
  parted \
  gdisk \
  dosfstools \
  e2fsprogs \
  util-linux \
  coreutils \
  sudo \
  grub-efi-amd64-bin \
  ca-certificates

cleanup_mounts

echo
echo "=== 13) Disable Ubuntu Welcome/GDM and force PinCabOS tty installer ==="
mkdir -p "$ROOTFS_DIR/etc/systemd/system"
mkdir -p "$ROOTFS_DIR/etc/systemd/system/multi-user.target.wants"

ln -sfn /lib/systemd/system/multi-user.target "$ROOTFS_DIR/etc/systemd/system/default.target"
ln -sfn /dev/null "$ROOTFS_DIR/etc/systemd/system/display-manager.service"
ln -sfn /dev/null "$ROOTFS_DIR/etc/systemd/system/gdm.service"
ln -sfn /dev/null "$ROOTFS_DIR/etc/systemd/system/gdm3.service"

DISABLED_DIR="$ROOTFS_DIR/var/lib/pincabos-disabled-ubuntu-welcome"
mkdir -p "$DISABLED_DIR"

while IFS= read -r f; do
  [ -f "$f" ] || continue
  rel="${f#$ROOTFS_DIR/}"
  safe="$(echo "$rel" | tr '/' '_')"
  echo "Disabling: /$rel"
  cp -a "$f" "$DISABLED_DIR/$safe" || true
  mv "$f" "$f.disabled-by-pincabos" || true
done < <(find "$ROOTFS_DIR" -xdev -type f \( \
  -path '*/etc/xdg/autostart/*' -o \
  -path '*/usr/share/applications/*' -o \
  -path '*/etc/systemd/system/*' -o \
  -path '*/lib/systemd/system/*' -o \
  -path '*/usr/lib/systemd/system/*' \
\) \( \
  -iname '*ubuntu*welcome*' -o \
  -iname '*ubuntu*bootstrap*' -o \
  -iname '*ubuntu*desktop*installer*' -o \
  -iname '*subiquity*' -o \
  -iname '*casper*installer*' \
\) | sort)

mkdir -p "$ROOTFS_DIR/usr/local/sbin"

cat >"$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer" <<'PINCBOS_LIVE_INSTALLER'
#!/usr/bin/env bash
set -Eeuo pipefail

clear
echo "==============================================================="
echo " PinCabOS V8.1G English Live Installer"
echo "==============================================================="
echo
echo "This is the PinCabOS installer, not the Ubuntu installer."
echo
echo "It will install the validated PinCabOS V8.1G payload from:"
echo "  /cdrom/pincabos-payload"
echo
echo "Nothing is erased until you select a disk and type:"
echo "  INSTALL PINCABOS"
echo

if [ "$(id -u)" -ne 0 ]; then
  exec sudo -E "$0" "$@"
fi

PAYLOAD_DIR="/cdrom/pincabos-payload"
TARGET="/target"

echo "=== Live media payload check ==="
test -d "$PAYLOAD_DIR" || {
  echo "ERROR: payload directory not found: $PAYLOAD_DIR"
  ls -lah /cdrom 2>/dev/null || true
  exit 1
}

test -x "$PAYLOAD_DIR/pincabos-v8.1g-install-cab-payload-to-target.sh" || {
  echo "ERROR: install helper missing or not executable"
  exit 1
}

(
  cd "$PAYLOAD_DIR"
  sha256sum -c pincabos-rootfs-cab-v8.1g.parts.sha256
  sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256
)

echo
echo "OK: payload checksums valid"

while true; do
  echo
  echo "=== Available target disks ==="
  lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$4=="disk"{print}'
  echo

  DISKS=()
  while IFS= read -r d; do
    DISKS+=("$d")
  done < <(lsblk -dpno NAME,TYPE | awk '$2=="disk"{print $1}' | grep -Ev '/dev/loop|/dev/sr|/dev/ram' || true)

  if [ "${#DISKS[@]}" -eq 0 ]; then
    echo "No installable disk found."
    echo "Options: r = retry, s = shell, q = reboot"
    read -rp "> " A
    case "$A" in
      r|R) continue ;;
      s|S) bash ;;
      q|Q) reboot ;;
    esac
    continue
  fi

  echo "Select target disk:"
  i=1
  for d in "${DISKS[@]}"; do
    echo "  [$i] $(lsblk -dpno NAME,SIZE,MODEL "$d")"
    i=$((i+1))
  done

  echo
  echo "Options: number = install, s = shell, r = refresh, q = reboot"
  read -rp "Choice: " CHOICE

  case "$CHOICE" in
    s|S) bash; continue ;;
    r|R) continue ;;
    q|Q) reboot ;;
  esac

  [[ "$CHOICE" =~ ^[0-9]+$ ]] || {
    echo "Invalid choice."
    continue
  }

  IDX=$((CHOICE-1))
  if [ "$IDX" -lt 0 ] || [ "$IDX" -ge "${#DISKS[@]}" ]; then
    echo "Selection out of range."
    continue
  fi

  DISK="${DISKS[$IDX]}"
  break
done

echo
echo "Selected disk:"
lsblk -dpno NAME,SIZE,MODEL "$DISK"
echo
echo "WARNING: ALL DATA ON $DISK WILL BE ERASED."
read -rp "Type INSTALL PINCABOS to continue: " CONFIRM

[ "$CONFIRM" = "INSTALL PINCABOS" ] || {
  echo "Cancelled."
  exit 1
}

echo
echo "=== Unmounting target disk partitions ==="
while IFS= read -r mp; do
  [ -n "$mp" ] && umount -R "$mp" 2>/dev/null || true
done < <(lsblk -rpno MOUNTPOINT "$DISK" | awk 'NF')

echo
echo "=== Partitioning disk GPT ==="
wipefs -a "$DISK" || true
sgdisk --zap-all "$DISK" || true
partprobe "$DISK" || true
sleep 2

parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart ESP fat32 1MiB 551MiB
parted -s "$DISK" set 1 esp on
parted -s "$DISK" mkpart primary ext4 551MiB 100%

partprobe "$DISK"
udevadm settle
sleep 2

if [[ "$DISK" =~ nvme|mmcblk ]]; then
  EFI_PART="${DISK}p1"
  ROOT_PART="${DISK}p2"
else
  EFI_PART="${DISK}1"
  ROOT_PART="${DISK}2"
fi

test -b "$EFI_PART" || { echo "ERROR: missing EFI partition: $EFI_PART"; exit 1; }
test -b "$ROOT_PART" || { echo "ERROR: missing root partition: $ROOT_PART"; exit 1; }

echo
echo "=== Formatting partitions ==="
mkfs.vfat -F 32 -n PCOS_EFI "$EFI_PART"
mkfs.ext4 -F -L rootfs "$ROOT_PART"

echo
echo "=== Mounting target ==="
rm -rf "$TARGET"
mkdir -p "$TARGET"
mount "$ROOT_PART" "$TARGET"
mkdir -p "$TARGET/boot/efi"
mount "$EFI_PART" "$TARGET/boot/efi"

echo
echo "=== Installing PinCabOS payload ==="
"$PAYLOAD_DIR/pincabos-v8.1g-install-cab-payload-to-target.sh" "$TARGET" "$PAYLOAD_DIR"

echo
echo "=== Writing correct fstab for this disk ==="
ROOT_UUID="$(blkid -s UUID -o value "$ROOT_PART")"
EFI_UUID="$(blkid -s UUID -o value "$EFI_PART")"

cat >"$TARGET/etc/fstab" <<FSTAB
# PinCabOS generated fstab
UUID=$ROOT_UUID / ext4 defaults,noatime 0 1
UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1
FSTAB

echo
echo "=== Final boot refresh ==="
mountpoint -q "$TARGET/dev"  || mount --bind /dev  "$TARGET/dev"
mountpoint -q "$TARGET/proc" || mount --bind /proc "$TARGET/proc"
mountpoint -q "$TARGET/sys"  || mount --bind /sys  "$TARGET/sys"
mountpoint -q "$TARGET/run"  || mount --bind /run  "$TARGET/run"

chroot "$TARGET" update-initramfs -u -k all
chroot "$TARGET" update-grub

chroot "$TARGET" grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=PinCabOS \
  --recheck

chroot "$TARGET" grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=PinCabOS \
  --removable \
  --recheck || true

echo
echo "=== Final validation ==="
find "$TARGET/boot" -maxdepth 2 -type f | sort | sed -n '1,120p'
ls -lah "$TARGET/lib/modules"
cat "$TARGET/etc/fstab"
grep -R "quiet splash\|PinCabOS\|pincabos\|plymouth" \
  "$TARGET/etc/default/grub" \
  "$TARGET/etc/plymouth/plymouthd.conf" \
  "$TARGET/boot/grub/grub.cfg" \
  2>/dev/null || true

echo
echo "==============================================================="
echo " PinCabOS installation completed successfully."
echo " Remove the ISO/USB media, then reboot."
echo "==============================================================="
read -rp "Press ENTER to reboot now, or CTRL+C to stay in live session..."
reboot
PINCBOS_LIVE_INSTALLER

chmod 755 "$ROOTFS_DIR/usr/local/sbin/pincabos-live-installer"

cat >"$ROOTFS_DIR/etc/systemd/system/pincabos-live-installer-tty.service" <<'PINCBOS_SERVICE'
[Unit]
Description=PinCabOS V8.1G Live Installer on tty1
After=local-fs.target systemd-user-sessions.service
Wants=systemd-user-sessions.service
Conflicts=display-manager.service gdm.service gdm3.service
Before=display-manager.service gdm.service gdm3.service

[Service]
Type=idle
ExecStartPre=/usr/bin/chvt 1
ExecStart=/usr/local/sbin/pincabos-live-installer
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=no

[Install]
WantedBy=multi-user.target
PINCBOS_SERVICE

ln -sfn ../pincabos-live-installer-tty.service \
  "$ROOTFS_DIR/etc/systemd/system/multi-user.target.wants/pincabos-live-installer-tty.service"

echo
echo "=== 14) Add manual fallback launcher ==="
mkdir -p "$ROOTFS_DIR/etc/skel/Desktop"

cat >"$ROOTFS_DIR/etc/skel/Desktop/Install-PinCabOS.desktop" <<'PINCBOS_DESKTOP'
[Desktop Entry]
Type=Application
Name=Install PinCabOS
Comment=Install PinCabOS to disk
Exec=sudo /usr/local/sbin/pincabos-live-installer
Terminal=true
Icon=system-software-install
Categories=System;
PINCBOS_DESKTOP

chmod 755 "$ROOTFS_DIR/etc/skel/Desktop/Install-PinCabOS.desktop"

echo
echo "=== 15) Repack live squashfs ==="
rm -f "$SQUASHFS"
mksquashfs "$ROOTFS_DIR" "$SQUASHFS" -comp xz -b 1M -noappend

echo
echo "=== 16) Integrate payload into ISO tree ==="
rm -rf "$ISO_DIR/pincabos-payload"
mkdir -p "$ISO_DIR/pincabos-payload"
rsync -aHAX --info=progress2 "$PAYLOAD_ISO_READY"/ "$ISO_DIR/pincabos-payload"/

(
  cd "$ISO_DIR/pincabos-payload"
  sha256sum pincabos-rootfs-cab-v8.1g.tar.zst.part-* > pincabos-rootfs-cab-v8.1g.parts.sha256
  sha256sum pincabos-plymouth-theme-overlay-v8.1g.tar.zst > pincabos-plymouth-theme-overlay-v8.1g.sha256
  sha256sum -c pincabos-rootfs-cab-v8.1g.parts.sha256
  sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256
)

echo
echo "=== 17) Add README and patch boot menu labels ==="
cat >"$ISO_DIR/PINCABOS-V8.1G-README.txt" <<'PINCBOS_README'
PinCabOS V8.1G English Live Installer

Payload:
- V8.1G lean payload from validated cabinet source
- Includes /boot, GRUB, initrd, /lib/modules
- Includes Plymouth theme overlay: pincabos
- Excludes Tables, swap, venv, old ISO builds

Installer:
- English text installer on tty1
- Ubuntu Welcome/GDM disabled
- EFI label: PCOS_EFI
- Root label: rootfs
- Bootloader ID: PinCabOS

Expected boot:
PinCabOS V8.1G English Live Installer
PINCBOS_README

while IFS= read -r cfg; do
  sed -i \
    -e 's/Try or Install Ubuntu/Try or Install PinCabOS/g' \
    -e 's/Ubuntu safe graphics/PinCabOS safe graphics/g' \
    -e 's/Install Ubuntu/Install PinCabOS/g' \
    "$cfg" || true
done < <(find "$ISO_DIR" -type f \( -name 'grub.cfg' -o -name 'txt.cfg' \) 2>/dev/null)

echo
echo "=== 18) Update casper metadata and md5sum ==="
du -sx --block-size=1 "$ROOTFS_DIR" | cut -f1 > "$ISO_DIR/casper/filesystem.size"
echo "$(du -sx --block-size=1 "$ROOTFS_DIR" | cut -f1)" > "${SQUASHFS}.size" || true

(
  cd "$ISO_DIR"
  rm -f md5sum.txt
  find . -type f \
    ! -name md5sum.txt \
    ! -path './isolinux/boot.cat' \
    ! -path './boot.catalog' \
    -print0 \
    | sort -z \
    | xargs -0 md5sum > md5sum.txt
)

echo
echo "=== 19) Build final bootable ISO with explicit BIOS + UEFI ==="

BIOS_IMG=""
for p in \
  "$ISO_DIR/boot/grub/i386-pc/eltorito.img" \
  "$ISO_DIR/boot/grub/eltorito.img" \
  "$ISO_DIR/boot/grub/i386-pc/core.img"
do
  if [ -f "$p" ]; then
    BIOS_IMG="$p"
    break
  fi
done

if [ -z "$BIOS_IMG" ]; then
  echo "Boot file audit:"
  find "$ISO_DIR/boot" -maxdepth 5 -type f | sort | sed -n '1,240p'
  die "BIOS El Torito image not found"
fi

BIOS_REL="${BIOS_IMG#$ISO_DIR/}"
echo "BIOS boot image: $BIOS_REL"

HYBRID_MBR="/usr/lib/grub/i386-pc/boot_hybrid.img"
test -f "$HYBRID_MBR" || die "Missing GRUB hybrid MBR: $HYBRID_MBR"

EFI_IMG="$BOOT_WORK/efiboot.img"
rm -rf "$BOOT_WORK"
mkdir -p "$BOOT_WORK"
truncate -s 64M "$EFI_IMG"
mformat -i "$EFI_IMG" -F ::

if [ -d "$ISO_DIR/EFI" ]; then
  mcopy -i "$EFI_IMG" -s "$ISO_DIR/EFI" ::/
else
  die "ISO tree has no /EFI directory"
fi

mdir -i "$EFI_IMG" ::/EFI/BOOT/BOOTX64.EFI >/dev/null 2>&1 \
  || die "UEFI image missing EFI/BOOT/BOOTX64.EFI"

rm -f "$OUT_ISO"

xorriso -as mkisofs \
  -r \
  -J \
  -joliet-long \
  -l \
  -V "$VOLID" \
  -o "$OUT_ISO" \
  --grub2-mbr "$HYBRID_MBR" \
  -partition_offset 16 \
  --mbr-force-bootable \
  -append_partition 2 0xef "$EFI_IMG" \
  -appended_part_as_gpt \
  -iso_mbr_part_type 0x00 \
  -c boot.catalog \
  -b "$BIOS_REL" \
  -no-emul-boot \
  -boot-load-size 4 \
  -boot-info-table \
  --grub2-boot-info \
  -eltorito-alt-boot \
  -e '--interval:appended_partition_2:all::' \
  -no-emul-boot \
  "$ISO_DIR"

echo
echo "=== 20) Final ISO validation ==="
test -f "$OUT_ISO" || die "ISO was not created"
ls -lh "$OUT_ISO"
sha256sum "$OUT_ISO" | tee "$OUT_ISO.sha256"

echo
echo "--- El Torito boot report ---"
xorriso -indev "$OUT_ISO" -report_el_torito plain | sed -n '1,220p'

echo
echo "--- ISO payload listing ---"
xorriso -osirrox on -indev "$OUT_ISO" \
  -find /pincabos-payload -maxdepth 1 -type f -exec lsdl \
  | sed -n '1,120p'

echo
echo "--- ISO PinCabOS files sanity ---"
xorriso -osirrox on -indev "$OUT_ISO" \
  -find / -maxdepth 2 -type f -name 'PINCABOS*' -exec lsdl \
  | sed -n '1,80p'

echo
echo "==============================================================="
echo " ISO CREATED OK"
echo "==============================================================="
echo "ISO:"
echo "$OUT_ISO"
echo
echo "SHA256:"
cat "$OUT_ISO.sha256"
echo
echo "Expected VM boot:"
echo "  PinCabOS V8.1G English Live Installer on tty1"
echo "  No Ubuntu Welcome window"
echo
echo "Log:"
echo "$LOG"
echo "==============================================================="

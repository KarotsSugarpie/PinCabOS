+# PINCABOS_LOCAL_THEME_CARD_V1
+def _merge_pincabos_local_theme(registry: ThemeRegistry) -> ThemeRegistry:
+    """Expose the local PinCabOS theme in Manager UI without remote registry ownership."""
+    theme_key = "PinCabOS"
+    theme_dir = THEMES_DIR / theme_key
+    manifest_path = theme_dir / "manifest.json"
+
+    if theme_key in registry.themes:
+        return registry
+
+    if not theme_dir.is_dir() or not manifest_path.is_file():
+        return registry
+
+    try:
+        manifest = json.loads(
+            manifest_path.read_text(
+                encoding="utf-8"
+            )
+        )
+    except (json.JSONDecodeError, OSError):
+        return registry
+
+    if not isinstance(manifest, dict):
+        return registry
+
+    try:
+        registry._validate_manifest(
+            theme_key,
+            manifest,
+        )
+    except Exception:
+        return registry
+
+    registry.themes[theme_key] = {
+        "registry_info": {
+            "local_only": True,
+            "default_install": False,
+            "theme_base_url": "",
+            "theme_manifest_url": "",
+        },
+        "manifest": manifest,
+    }
+
+    return registry
+
+
 def load_registry() -> ThemeRegistry:
     registry = ThemeRegistry()
     registry.load_registry()
     registry.load_theme_manifests()
+
+    _merge_pincabos_local_theme(
+        registry
+    )
+
     return registry
 
 

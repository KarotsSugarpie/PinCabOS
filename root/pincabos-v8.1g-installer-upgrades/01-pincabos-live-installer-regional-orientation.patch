+# pco_pick <titre> <filtre_initial> <data:VALEUR\tLIBELLE>  ->  PICK_RESULT
+pco_pick() {
+    local title="$1" filt="${2:-}" data="$3"
+    local sel kw matches n line _restore=0
+    case $- in *e*) _restore=1;; esac
+    set +e
+    PICK_RESULT=""
+    while true; do
         echo
-        pco_hr
-        echo " Keyboard"
-        pco_hr
+        pco_hr; echo " $title"; pco_hr; echo
+        [ -n "$filt" ] && echo " ${DIM}Filtre : \"$filt\"${NC}"
+        matches="$(printf '%s\n' "$data" | grep -iF -- "$filt")"
+        if [ -z "$matches" ]; then
+            pco_warn "Aucun resultat pour \"$filt\"."
+            pco_prompt "Mot-cle : "; read -r filt || filt=""
+            continue
+        fi
+        n="$(printf '%s\n' "$matches" | grep -c .)"
+        if [ "$n" -gt 60 ]; then
+            echo " $n resultats — affine la recherche (ou tape: all)."
+            pco_prompt "Mot-cle : "; read -r kw || kw=""
+            [ "$kw" != "all" ] && { filt="$kw"; continue; }
+        fi
+        printf '%s\n' "$matches" | cut -f2 | nl -w3 -s ') ' -ba | sed 's/^/  /'
         echo
+        pco_prompt "Numero (ou 'f' = filtrer) : "; read -r sel || sel=""
+        [ "$sel" = "f" ] && { pco_prompt "Mot-cle : "; read -r filt || filt=""; continue; }
+        case "$sel" in ''|*[!0-9]*) pco_warn "Entree invalide."; continue;; esac
+        if [ "$sel" -lt 1 ] || [ "$sel" -gt "$n" ]; then pco_warn "Hors plage."; continue; fi
+        line="$(printf '%s\n' "$matches" | sed -n "${sel}p")"
+        PICK_RESULT="${line%%$'\t'*}"
+        break
+    done
+    [ "$_restore" = 1 ] && set -e
+    return 0
+}
 

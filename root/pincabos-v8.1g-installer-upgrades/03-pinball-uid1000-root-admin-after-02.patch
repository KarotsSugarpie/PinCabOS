--- a/pincabos-payload/pincabos-v8.1g-install-cab-payload-to-target.sh
+++ b/pincabos-payload/pincabos-v8.1g-install-cab-payload-to-target.sh
@@ -40,8 +40,63 @@
 if getent passwd pinball >/dev/null 2>&1; then
   echo "GO [OK] live pinball resolvable: $(getent passwd pinball | cut -d: -f1,3,4)"
 else
   echo "WARN: creation du compte pinball dans l'env live a echoue"
 fi
 
+echo
+echo "=== 2c) PINCABOS POLICY: pinball UID 1000 + administrateur complet ==="
+# Invariant PinCabOS : le compte interactif doit rester uid/gid 1000.
+# On ne transforme PAS pinball en uid 0 : les applications restent uid 1000,
+# mais pinball peut obtenir root sans mot de passe via sudo et toutes les
+# actions Polkit locales sont autorisees.
+PCOS_TARGET_PB_UID="$(awk -F: '$1=="pinball"{print $3; exit}' "$TARGET/etc/passwd" 2>/dev/null || true)"
+PCOS_TARGET_PB_GID="$(awk -F: '$1=="pinball"{print $4; exit}' "$TARGET/etc/passwd" 2>/dev/null || true)"
+
+if [ "$PCOS_TARGET_PB_UID" != "1000" ] || [ "$PCOS_TARGET_PB_GID" != "1000" ]; then
+  echo "ERROR: pinball doit etre uid=1000 gid=1000 dans le rootfs cible"
+  echo "       detecte uid=${PCOS_TARGET_PB_UID:-absent} gid=${PCOS_TARGET_PB_GID:-absent}"
+  exit 1
+fi
+
+if [ ! -x "$TARGET/usr/bin/sudo" ]; then
+  echo "ERROR: sudo absent du rootfs cible; impossible d'activer le mode admin PinCabOS"
+  exit 1
+fi
+
+# Root complet sans mot de passe pour les commandes explicites sudo/sudo -n.
+install -d -m 0750 "$TARGET/etc/sudoers.d"
+cat > "$TARGET/etc/sudoers.d/99-pincabos-pinball-root" <<'SUDOEOF'
+# PinCabOS dedicated cabinet account - intentional full local administration
+pinball ALL=(ALL:ALL) NOPASSWD: ALL
+SUDOEOF
+chmod 0440 "$TARGET/etc/sudoers.d/99-pincabos-pinball-root"
+
+# Valide la syntaxe avant de poursuivre l'installation.
+if [ -x "$TARGET/usr/sbin/visudo" ]; then
+  chroot "$TARGET" /usr/sbin/visudo -cf /etc/sudoers.d/99-pincabos-pinball-root
+fi
+
+# Garde aussi l'appartenance au groupe sudo si le groupe existe.
+if [ -x "$TARGET/usr/sbin/usermod" ] && grep -q '^sudo:' "$TARGET/etc/group"; then
+  chroot "$TARGET" /usr/sbin/usermod -aG sudo pinball
+fi
+
+# Autorise sans authentification les actions systeme gerees par Polkit
+# (NetworkManager, systemd via GUI/outils Polkit, montage, etc.).
+install -d -m 0755 "$TARGET/etc/polkit-1/rules.d"
+cat > "$TARGET/etc/polkit-1/rules.d/49-pincabos-pinball-root.rules" <<'POLKITEOF'
+// PinCabOS dedicated cabinet account - intentional full local administration
+polkit.addRule(function(action, subject) {
+    if (subject.user == "pinball") {
+        return polkit.Result.YES;
+    }
+});
+POLKITEOF
+chmod 0644 "$TARGET/etc/polkit-1/rules.d/49-pincabos-pinball-root.rules"
+
+echo "GO [OK] pinball cible: uid=1000 gid=1000"
+echo "GO [OK] sudo root NOPASSWD active"
+echo "GO [OK] Polkit local sans authentification active"
+
 echo "=== 3) Extract Plymouth overlay ==="
 ( cd "$PAYLOAD_DIR" && sha256sum -c pincabos-plymouth-theme-overlay-v8.1g.sha256 )

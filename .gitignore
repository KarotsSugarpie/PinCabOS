# ============================================================
# PinCabOS ??? Git RootFS exclusions
# ============================================================

# ------------------------------------------------------------
# Le depot Git lui-meme
# ------------------------------------------------------------
/opt/pincabos/.git-rootfs/

# ------------------------------------------------------------
# TABLES ??? jamais publiees
# ------------------------------------------------------------
/home/pinball/Tables/
/home/pinball/tables/

# ------------------------------------------------------------
# Imports / exports de tables
# ------------------------------------------------------------
/home/pinball/Exports/
/home/pinball/Downloads/

# ------------------------------------------------------------
# ISO ??? jamais publiees
# ------------------------------------------------------------
*.iso
*.ISO

# ------------------------------------------------------------
# Swap
# ------------------------------------------------------------
/swap.img
/swapfile

# ------------------------------------------------------------
# Pseudo-filesystems / runtime Linux
# ------------------------------------------------------------
/proc/
/sys/
/dev/
/run/
/tmp/
/lost+found/

# ------------------------------------------------------------
# Disques, NAS et montages externes
# ------------------------------------------------------------
/mnt/
/media/
/snap/

# ------------------------------------------------------------
# Logs / caches
# ------------------------------------------------------------
/var/log/
/var/tmp/
/var/cache/

# ------------------------------------------------------------
# Etats de paquets reconstruisibles
# ------------------------------------------------------------
/var/lib/apt/
/var/lib/dpkg/
/var/lib/kdump/
/var/lib/snapd/
/var/lib/flatpak/

# ------------------------------------------------------------
# Docker runtime ??? pas les fichiers source
# ------------------------------------------------------------
/var/lib/docker/
/var/lib/containerd/

# ------------------------------------------------------------
# Ubuntu ??? binaires fournis par les paquets
# On les reconstruit avec apt-packages.tsv
# ------------------------------------------------------------
/boot/
/bin/
/sbin/
/lib/
/lib32/
/lib64/

/usr/bin/
/usr/sbin/
/usr/lib/
/usr/lib32/
/usr/lib64/
/usr/libexec/
/usr/share/
/usr/include/
/usr/src/

# /usr/local RESTE inclus

# ------------------------------------------------------------
# Chrome installe
# ------------------------------------------------------------
/opt/google/

# ------------------------------------------------------------
# Donnees generees du builder PinCabOS
# ------------------------------------------------------------
/opt/pincabos/build/output/
/opt/pincabos/build/known-good/
/opt/pincabos/cache/iso-base/
/opt/pincabos/build/legacy-package-builder/pilot-*/

# ------------------------------------------------------------
# VPinFE ??? packages de mise a jour telecharges
# ------------------------------------------------------------
/home/pinball/.config/vpinfe/updates/

# ------------------------------------------------------------
# Python ??? environnements reconstruisibles
# ------------------------------------------------------------
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# ------------------------------------------------------------
# Node
# ------------------------------------------------------------
**/node_modules/

# ------------------------------------------------------------
# Caches utilisateurs
# ------------------------------------------------------------
/home/*/.cache/
/root/.cache/

# ------------------------------------------------------------
# Corbeilles
# ------------------------------------------------------------
/home/*/.local/share/Trash/

# ------------------------------------------------------------
# Profils navigateurs / sessions
# ------------------------------------------------------------
/home/*/.config/google-chrome/
/home/*/.config/chromium/
/home/*/.mozilla/

# ------------------------------------------------------------
# Cles d'authentification de la MACHINE
# Les mots de passe/configs PinCabOS restent publies.
# ------------------------------------------------------------
/root/.ssh/
/home/*/.ssh/

/etc/ssh/ssh_host_*_key
/etc/ssh/ssh_host_*_key.pub

/etc/shadow
/etc/shadow-
/etc/gshadow
/etc/gshadow-

/etc/ssl/private/
/etc/NetworkManager/system-connections/

# ------------------------------------------------------------
# Git imbriques : garder le code, pas leurs metadata .git
# ------------------------------------------------------------
**/.git/

# ============================================================
# Cache / runtime PinCabOS
# ============================================================

# VPinFE ??? medias/cache generes a partir des tables
/home/pinball/.config/vpinfe/cache/

# Logs runtime
/home/pinball/.config/vpinfe/vpinfe.log
/opt/pincabos/logs/

# Etats temporaires des workers
/var/lib/pincabos/batch-live-import/worker-heartbeat.json

# Historique local shell
/root/.lesshst

# Ancienne cle CA generee par les tests Sunshine
/opt/pincabos/apps/sunshine-stream-test/**/cakey.pem
/opt/pincabos/backups/
/opt/pincabos/build/
/opt/pincabos/cache/
/opt/pincabos/config/admin-password.txt
/opt/pincabos/config/webapp-secret.key
/home/pinball/.ssh/
/home/pinball/Imports/
/opt/pincabos/imports/
/home/pinball/.cache/
/home/pinball/.local/share/Trash/
/home/pinball/.local/share/VPinballX/10.8/vpinball.log
/home/pinball/vpinfe/_internal/DirectOutput.log
/var/backups/
/var/lib/chrony/chrony.drift
/var/lib/pincabos/media-hunter/results.json
/var/lib/pincabos/media-hunter/state.json
/var/lib/pincabos/table-test/state.json
/root/.bash_history
/root/.config/gh/
/root/.gitconfig
/root/*.before-*
/root/*audit*.txt
/root/pincabos-v8.1g-installer-upgrades/
/root/pincabos-v8.1g-installer-upgrades.tar.gz
/root/pincabos-v8.1g-integrate-*.sh
/root/pincabos-gitignore-before-*

# Cache UCF Linux - genere automatiquement, noms incompatibles Windows
/var/lib/ucf/cache/

# ------------------------------------------------------------
# Copies de sauvegarde - jamais versionnees
# Remplace les anciennes regles, limitees a /opt/pincabos/{script,web}/
# et au seul motif ".bak-" : elles laissaient passer ".bak." ainsi que
# tout le reste de l'arborescence.
# ------------------------------------------------------------
**/*.bak
**/*.bak.*
**/*.bak-*
**/*.before-*
**/*.orig
**/*.old
/opt/pincabos/web/backups/
/home/pinball/.local/share/pincabos/editor-backups/
/home/pinball/.local/share/VPinballX/*/backups/


# Sauvegardes de metadonnees LVM : regenerees par LVM a chaque modification,
# et propres a la machine qui les a ecrites (UUID de disque, taille du SSD).
/etc/lvm/backup/
/etc/lvm/archive/
